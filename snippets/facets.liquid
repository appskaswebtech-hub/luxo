{% doc %}
  Renders storefront filters, active filter tags and an optional sort dropdown
  for collection and search results. Both pages use this file.

  The look comes from the "Filter style" theme setting (chip pills, card tiles or
  minimal underline). Filters apply instantly or with an Apply button ("Apply
  filters" setting); either way the results update without a page reload.
  Without JavaScript the form submits normally.

  Elements marked data-facets-update="<key>" are swapped with the same element
  from the refreshed section. Fields elsewhere on the page can join the form with
  form="<form_id>", such as a sort dropdown in a toolbar.

  @param {object[]} filters - The filters to show, such as collection.filters
  @param {string} action - The URL the form submits to
  @param {string} form_id - Unique id for the form
  @param {string} section_id - Id of the section to refresh
  @param {string} [layout] - `bar` (default, dropdowns in a row) or `sidebar` (stacked open groups)
  @param {object[]} [sort_options] - Sort options to show inside the form; leave out when sorting sits elsewhere
  @param {string} [sort_by] - The current sort value
  @param {string} [terms] - Search terms to keep when filtering search results
  @param {string} [clear_url] - URL that removes every filter

  @example
  {% render 'facets', filters: collection.filters, action: collection.url, form_id: 'CollectionFacets', section_id: section.id, layout: 'sidebar' %}
{% enddoc %}

{%- liquid
  assign layout = layout | default: 'bar'
  assign style = settings.filter_style | default: 'pills'
  assign apply_mode = settings.filter_apply | default: 'button'

  assign active_count = 0
  for filter in filters
    assign active_count = active_count | plus: filter.active_values.size
    if filter.type == 'price_range'
      if filter.min_value.value or filter.max_value.value
        assign active_count = active_count | plus: 1
      endif
    endif
  endfor
-%}

{{ 'facets.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer></script>

<facets-form
  class="facets facets--{{ layout }} facets--{{ style }} facets--icon-{{ settings.filter_icon | default: 'plus' }}"
  data-form-id="{{ form_id }}"
  data-section="{{ section_id }}"
  data-apply="{{ apply_mode }}"
  data-facets-update="facets-{{ form_id }}"
>
  {%- if active_count > 0 -%}
    <ul class="facets__active" role="list" aria-label="{{ 'facets.active' | t }}">
      {%- for filter in filters -%}
        {%- for value in filter.active_values -%}
          <li>
            <a href="{{ value.url_to_remove }}" class="facets__tag" data-facets-link aria-label="{{ 'facets.remove' | t: filter: value.label }}">
              {{ value.label | escape }} <span aria-hidden="true">×</span>
            </a>
          </li>
        {%- endfor -%}
        {%- if filter.type == 'price_range' -%}
          {%- if filter.min_value.value or filter.max_value.value -%}
            {%- liquid
              assign price_min = filter.min_value.value | default: 0 | money
              assign price_max = filter.max_value.value | default: filter.range_max | money
            -%}
            <li>
              <a href="{{ filter.url_to_remove }}" class="facets__tag" data-facets-link aria-label="{{ 'facets.remove' | t: filter: filter.label }}">
                {{ price_min }} – {{ price_max }} <span aria-hidden="true">×</span>
              </a>
            </li>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if clear_url != blank -%}
        <li><a href="{{ clear_url }}" class="facets__clear" data-facets-link>{{ 'collection_page.clear_all' | t }}</a></li>
      {%- endif -%}
    </ul>
  {%- endif -%}

  <form action="{{ action }}" method="get" id="{{ form_id }}" class="facets__form">
    {%- if terms != blank -%}
      <input type="hidden" name="q" value="{{ terms | escape }}">
      <input type="hidden" name="options[prefix]" value="last">
    {%- endif -%}

    <div class="facets__groups">
      {%- for filter in filters -%}
        {%- assign group_id = form_id | append: '-' | append: forloop.index -%}
        <details class="facets__group" id="{{ group_id }}"{% if layout == 'sidebar' %} open{% endif %}>
          <summary class="facets__summary">
            <span class="facets__name">{{ filter.label | escape }}</span>
            {%- if filter.active_values.size > 0 -%}
              <span class="facets__badge">{{ filter.active_values.size }}</span>
            {%- endif -%}
          </summary>

          {%- case filter.type -%}
            {%- when 'list', 'boolean' -%}
              <fieldset class="facets__panel">
                <legend class="visually-hidden">{{ filter.label | escape }}</legend>
                <div class="facets__values">
                  {%- for value in filter.values -%}
                    {%- liquid
                      assign is_empty = false
                      if value.count == 0
                        unless value.active
                          assign is_empty = true
                        endunless
                      endif
                      assign swatch_color = nil
                      if filter.presentation == 'swatch'
                        assign swatch_color = value.swatch.color
                      endif
                    -%}
                    <label class="facets__value{% if is_empty %} is-disabled{% endif %}" for="{{ group_id }}-{{ forloop.index }}">
                      <input
                        type="checkbox"
                        class="facets__input"
                        id="{{ group_id }}-{{ forloop.index }}"
                        name="{{ value.param_name }}"
                        value="{{ value.value | escape }}"
                        {% if value.active %}
                          checked
                        {% endif %}
                        {% if is_empty %}
                          disabled
                        {% endif %}
                      >
                      {%- if swatch_color -%}
                        <span class="facets__swatch" style="--swatch: {{ swatch_color }};" aria-hidden="true"></span>
                      {%- endif -%}
                      <span class="facets__label">{{ value.label | escape }}</span>
                      <span class="facets__count">{{ value.count }}</span>
                    </label>
                  {%- endfor -%}
                </div>
              </fieldset>

            {%- when 'price_range' -%}
              {%- liquid
                comment
                  Plain numbers from the amounts in cents, so the fields work with any market currency format
                endcomment
                assign range_max = filter.range_max | divided_by: 100.0 | ceil
                assign current_min = ''
                if filter.min_value.value
                  assign current_min = filter.min_value.value | divided_by: 100.0
                endif
                assign current_max = ''
                if filter.max_value.value
                  assign current_max = filter.max_value.value | divided_by: 100.0
                endif
              -%}
              <fieldset class="facets__panel">
                <legend class="visually-hidden">{{ filter.label | escape }}</legend>
                <price-range class="facets__price" data-max="{{ range_max }}">
                  <div class="facets__slider" aria-hidden="true">
                    <span class="facets__track"><span class="facets__track-fill" data-range-fill></span></span>
                    <input type="range" class="facets__thumb" min="0" max="{{ range_max }}" step="1" value="{{ current_min | default: 0 }}" data-range-min tabindex="-1">
                    <input type="range" class="facets__thumb" min="0" max="{{ range_max }}" step="1" value="{{ current_max | default: range_max }}" data-range-max tabindex="-1">
                  </div>
                  <div class="facets__price-fields">
                    <label for="{{ group_id }}-min">
                      <span>{{ 'collection_page.min' | t }}</span>
                      <span class="facets__money">
                        <span aria-hidden="true">{{ cart.currency.symbol }}</span>
                        <input
                          type="number"
                          id="{{ group_id }}-min"
                          name="{{ filter.min_value.param_name }}"
                          value="{{ current_min }}"
                          placeholder="0"
                          min="0"
                          max="{{ range_max }}"
                          step="any"
                          inputmode="decimal"
                          data-price-min
                        >
                      </span>
                    </label>
                    <span class="facets__price-dash" aria-hidden="true">–</span>
                    <label for="{{ group_id }}-max">
                      <span>{{ 'collection_page.max' | t }}</span>
                      <span class="facets__money">
                        <span aria-hidden="true">{{ cart.currency.symbol }}</span>
                        <input
                          type="number"
                          id="{{ group_id }}-max"
                          name="{{ filter.max_value.param_name }}"
                          value="{{ current_max }}"
                          placeholder="{{ range_max }}"
                          min="0"
                          max="{{ range_max }}"
                          step="any"
                          inputmode="decimal"
                          data-price-max
                        >
                      </span>
                    </label>
                  </div>
                </price-range>
              </fieldset>
          {%- endcase -%}
        </details>
      {%- endfor -%}

      {%- if sort_options.size > 0 -%}
        <label class="facets__sort" for="{{ form_id }}-sort">
          <span>{{ 'collection_page.sort_by' | t }}</span>
          <select name="sort_by" id="{{ form_id }}-sort">
            {%- for option in sort_options -%}
              <option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name | escape }}</option>
            {%- endfor -%}
          </select>
        </label>
      {%- endif -%}
    </div>

    {%- if apply_mode == 'button' -%}
      <div class="facets__footer">
        <button type="submit" class="facets__apply">{{ 'collection_page.apply' | t }}</button>
      </div>
    {%- else -%}
      <noscript>
        <div class="facets__footer">
          <button type="submit" class="facets__apply">{{ 'collection_page.apply' | t }}</button>
        </div>
      </noscript>
    {%- endif -%}

    <span class="visually-hidden" role="status" data-facets-status></span>
  </form>
</facets-form>
