{% doc %}
  Outputs global CSS custom properties based on theme settings.

  @example
  {% render 'css-variables' %}
{% enddoc %}

{% liquid
  case settings.card_image_ratio
    when 'square'
      assign card_image_ratio = '1 / 1'
    when 'portrait'
      assign card_image_ratio = '3 / 4'
    when 'landscape'
      assign card_image_ratio = '4 / 3'
    else
      assign card_image_ratio = 'auto'
  endcase

  case settings.cart_image_ratio
    when 'square'
      assign cart_image_ratio = '1 / 1'
    when 'portrait'
      assign cart_image_ratio = '3 / 4'
    when 'landscape'
      assign cart_image_ratio = '4 / 3'
    else
      assign cart_image_ratio = 'auto'
  endcase
%}

{% style %}
  {% # Loads the heading and body fonts with their bold, italic and bold-italic styles, with display: swap %}
  {{ settings.type_header_font | font_face: font_display: 'swap' }}
  {{ settings.type_header_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ settings.type_header_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {{ settings.type_header_font | font_modify: 'weight', 'bold' | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {{ settings.type_body_font | font_face: font_display: 'swap' }}
  {{ settings.type_body_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ settings.type_body_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {{ settings.type_body_font | font_modify: 'weight', 'bold' | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}

  :root {
    --font-heading-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
    --font-heading-weight: {{ settings.type_header_font.weight }};
    --font-heading-style: {{ settings.type_header_font.style }};
    --font-heading-size: {{ settings.heading_font_size }}px;
    --font-heading-line-height: {{ settings.heading_line_height }};
    --font-heading-letter-spacing: {{ settings.heading_letter_spacing }}px;
    --font-heading-text-transform: {{ settings.heading_text_transform }};

    --font-body-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    --font-body-weight: {{ settings.type_body_font.weight }};
    --font-body-style: {{ settings.type_body_font.style }};
    --font-body-size: {{ settings.body_font_size }}px;
    --font-body-line-height: {{ settings.body_line_height }};
    --font-body-letter-spacing: {{ settings.body_letter_spacing }}px;

    --page-width: {{ settings.max_page_width }};
    --page-margin: {{ settings.min_page_margin }}px;

    --card-slider-arrow-bg: {{ settings.card_slider_arrow_bg }};
    --card-slider-arrow-icon: {{ settings.card_slider_arrow_icon }};
    --card-slider-dot: {{ settings.card_slider_dot }};

    --card-image-hover-scale: {% if settings.image_hover_effect == 'zoom' %}1.05{% else %}1{% endif %};
    --card-hover-lift: {% if settings.image_hover_effect == 'lift' %}-6px{% else %}0px{% endif %};


    --style-border-radius-inputs: {{ settings.input_corner_radius }}px;
    --input-border-thickness: {{ settings.input_border_thickness }}px;

    --button-radius: {{ settings.button_corner_radius }}px;
    --button-border-thickness: {{ settings.button_border_thickness }}px;
    --button-text-transform: {{ settings.button_text_transform }};

    --card-image-ratio: {{ card_image_ratio }};

    --cart-image-width: {{ settings.cart_image_width }}px;
    --cart-image-ratio: {{ cart_image_ratio }};
    --cart-image-radius: {{ settings.cart_image_radius }}px;
    --cart-image-border-width: {% if settings.cart_image_border %}1px{% else %}0px{% endif %};
    --cart-popup-accent: {{ settings.cart_popup_accent }};
    --cart-drawer-width: {{ settings.cart_drawer_width }}px;

    --logo-width: {{ settings.logo_width }}px;

    --variant-block-margin-top: {{ settings.variant_block_margin_top }}px;
    --variant-block-margin-right: {{ settings.variant_block_margin_right }}px;
    --variant-block-margin-bottom: {{ settings.variant_block_margin_bottom }}px;
    --variant-block-margin-left: {{ settings.variant_block_margin_left }}px;
    --variant-block-margin: {{ settings.variant_block_margin_top }}px {{ settings.variant_block_margin_right }}px {{ settings.variant_block_margin_bottom }}px {{ settings.variant_block_margin_left }}px;

    --variant-swatch-size: {{ settings.variant_swatch_size }}px;
    --variant-swatch-radius: {% case settings.variant_swatch_shape %}{% when 'square' %}0{% when 'square_rounded' %}20%{% else %}50%{% endcase %};

    --pill-text: {{ settings.pills_text_color }};
    --pill-background: {{ settings.pills_background_color }};
    --pill-border: {{ settings.pills_border_color }};
    --pill-selected-text: {{ settings.pills_selected_text_color }};
    --pill-selected-background: {{ settings.pills_selected_bg_color }};
    --pill-radius: {{ settings.pills_border_radius }}px;
    --pill-border-width: {{ settings.pills_border_thickness }}px;
  }

  {% # Color schemes: the first one is the page default; sections apply theirs with the color-<id> class %}
  {%- for scheme in settings.color_schemes -%}
    {%- if forloop.first %}:root,{% endif %}
    .color-{{ scheme.id }} {
      --color-background: {{ scheme.settings.background }};
      --color-background-gradient: {{ scheme.settings.background_gradient | default: scheme.settings.background }};
      --color-foreground: {{ scheme.settings.text }};
      --color-accent: {{ scheme.settings.accent }};
      --color-border: {{ scheme.settings.border }};
      --color-button: {{ scheme.settings.button }};
      --color-button-text: {{ scheme.settings.button_label }};
    }
  {%- endfor -%}

  {%- for scheme in settings.color_schemes -%}
    .color-{{ scheme.id }} {
      background: var(--color-background-gradient);
      color: var(--color-foreground);
    }
  {%- endfor -%}
{% endstyle %}
