{% doc %}
  Renders the errors of a customer form in an announced box.

  @param {object} errors - The form.errors object

  @example
  {% render 'customer-errors', errors: form.errors %}
{% enddoc %}

{%- if errors -%}
  <div class="customer__errors" role="alert" tabindex="-1">
    <p>{{ 'customer.errors.heading' | t }}</p>
    <ul>
      {%- for field in errors -%}
        <li>
          {%- if field == 'form' -%}
            {{ errors.messages[field] }}
          {%- else -%}
            {{ errors.translated_fields[field] | capitalize }} {{ errors.messages[field] }}
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}
