{% layout none %}

<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% render 'css-variables' %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {% render 'meta-tags' %}

    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>

    {% style %}
      .gift-card {
        --gc-bg: #faf6f0;
        --gc-text: #2b1e16;
        --gc-accent: #9c4a1a;
        --gc-soft: #f1e7da;
        display: grid;
        place-items: center;
        min-height: 100svh;
        margin: 0;
        padding: 48px 16px;
        background: var(--gc-bg);
        color: var(--gc-text);
        font-family: var(--font-body-family);
        text-align: center;
      }

      .gift-card__inner {
        width: 100%;
        max-width: 520px;
      }

      .gift-card__brand {
        display: inline-block;
        margin-bottom: 28px;
        color: inherit;
        text-decoration: none;
      }

      .gift-card__logo {
        display: block;
        width: auto;
        max-width: 180px;
        max-height: 64px;
        height: auto;
        margin: 0 auto;
      }

      .gift-card__shop {
        font-family: var(--font-heading-family);
        font-size: 24px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .gift-card__title {
        margin: 0 0 24px;
        font-family: var(--font-heading-family);
        font-size: clamp(28px, 6vw, 40px);
        font-weight: var(--font-heading-weight);
        line-height: 1.15;
      }

      .gift-card__card {
        position: relative;
        display: grid;
        gap: 6px;
        padding: 32px 28px;
        overflow: hidden;
        border-radius: 18px;
        background: linear-gradient(135deg, var(--gc-accent), #5e2c10);
        color: #fff;
        text-align: left;
        box-shadow: 0 24px 50px rgb(43 30 22 / 0.18);
        aspect-ratio: 1.6;
        align-content: space-between;
      }

      .gift-card__card::after {
        content: '';
        position: absolute;
        top: -40%;
        right: -20%;
        width: 70%;
        aspect-ratio: 1;
        border: 1px solid rgb(255 255 255 / 0.25);
        border-radius: 50%;
      }

      .gift-card__card-label {
        margin: 0;
        font-size: 12px;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        opacity: 0.85;
      }

      .gift-card__balance {
        margin: 0;
        font-family: var(--font-heading-family);
        font-size: clamp(32px, 9vw, 48px);
        line-height: 1;
      }

      .gift-card__initial {
        margin: 0;
        font-size: 14px;
        opacity: 0.8;
      }

      .gift-card__status {
        margin: 20px 0 0;
        font-size: 14px;
      }

      .gift-card__status--expired {
        color: #b3261e;
        font-weight: 600;
      }

      .gift-card__code-wrap {
        display: grid;
        gap: 10px;
        margin-top: 28px;
      }

      .gift-card__hint {
        margin: 0;
        font-size: 14px;
        opacity: 0.8;
      }

      .gift-card__code-row {
        display: flex;
        align-items: stretch;
        border: 1.5px dashed var(--gc-accent);
        border-radius: 12px;
        background: #fff;
      }

      .gift-card__code {
        flex: 1;
        min-width: 0;
        padding: 14px 16px;
        border: 0;
        background: none;
        color: inherit;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 18px;
        letter-spacing: 0.12em;
        text-align: center;
        overflow-wrap: anywhere;
      }

      .gift-card__copy {
        padding: 0 18px;
        border: 0;
        border-left: 1.5px dashed var(--gc-accent);
        border-radius: 0 10px 10px 0;
        background: var(--gc-soft);
        color: var(--gc-accent);
        font: inherit;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
      }

      .gift-card__copied {
        min-height: 20px;
        margin: 0;
        color: var(--gc-accent);
        font-size: 13px;
      }

      .gift-card__qr {
        display: flex;
        justify-content: center;
        margin-top: 20px;
      }

      .gift-card__qr img,
      .gift-card__qr canvas {
        width: 120px;
        height: 120px;
        padding: 8px;
        border-radius: 8px;
        background: #fff;
      }

      .gift-card__actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 12px;
        margin-top: 28px;
      }

      .gift-card__button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 48px;
        padding: 0 28px;
        border: 1.5px solid var(--gc-accent);
        border-radius: 999px;
        background: var(--gc-accent);
        color: #fff;
        font: inherit;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
      }

      .gift-card__button--outline {
        background: transparent;
        color: var(--gc-accent);
      }

      .gift-card__wallet {
        display: inline-block;
        margin-top: 20px;
      }

      .gift-card button:focus-visible,
      .gift-card a:focus-visible {
        outline: 2px solid var(--gc-accent);
        outline-offset: 3px;
      }

      @media print {
        .gift-card__actions,
        .gift-card__copy,
        .gift-card__copied,
        .gift-card__wallet {
          display: none;
        }

        .gift-card {
          min-height: 0;
          background: #fff;
        }
      }
    {% endstyle %}

    {{ content_for_header }}
  </head>

  <body class="gift-card">
    <main class="gift-card__inner" id="MainContent">
      <a class="gift-card__brand" href="{{ routes.root_url }}">
        {%- if settings.logo_default != blank -%}
          {{ settings.logo_default | image_url: width: 360 | image_tag: class: 'gift-card__logo', alt: shop.name, widths: '180, 270, 360' }}
        {%- else -%}
          <span class="gift-card__shop">{{ shop.name | escape }}</span>
        {%- endif -%}
      </a>

      <h1 class="gift-card__title">{{ 'gift_card.title' | t: shop: shop.name }}</h1>

      <div class="gift-card__card">
        <p class="gift-card__card-label">{{ 'gift_card.card' | t }}</p>
        <div>
          <p class="gift-card__balance">{{ gift_card.balance | money }}</p>
          {%- if gift_card.balance != gift_card.initial_value -%}
            {%- assign initial_value = gift_card.initial_value | money -%}
            <p class="gift-card__initial">{{ 'gift_card.initial_value' | t: value: initial_value }}</p>
          {%- endif -%}
        </div>
      </div>

      {%- if gift_card.enabled == false -%}
        <p class="gift-card__status gift-card__status--expired">{{ 'gift_card.disabled' | t }}</p>
      {%- elsif gift_card.expired -%}
        <p class="gift-card__status gift-card__status--expired">{{ 'gift_card.expired' | t }}</p>
      {%- elsif gift_card.expires_on -%}
        {%- assign expires_on = gift_card.expires_on | date: format: 'date' -%}
        <p class="gift-card__status">{{ 'gift_card.expires_on' | t: expires_on: expires_on }}</p>
      {%- endif -%}

      <div class="gift-card__code-wrap">
        <p class="gift-card__hint">{{ 'gift_card.use_at_checkout' | t }}</p>
        <div class="gift-card__code-row">
          <input
            class="gift-card__code"
            id="GiftCardCode"
            type="text"
            value="{{ gift_card.code | format_code }}"
            aria-label="{{ 'gift_card.code' | t }}"
            readonly
            onfocus="this.select()"
          >
          <button type="button" class="gift-card__copy" data-copy-code>{{ 'gift_card.copy' | t }}</button>
        </div>
        <p class="gift-card__copied" role="status" data-copy-status data-message="{{ 'gift_card.copied' | t }}"></p>
      </div>

      <div
        class="gift-card__qr"
        id="GiftCardQr"
        data-identifier="{{ gift_card.qr_identifier }}"
        role="img"
        aria-label="{{ 'gift_card.qr_label' | t }}"
      ></div>

      {%- if gift_card.pass_url -%}
        <a class="gift-card__wallet" href="{{ gift_card.pass_url }}">
          <img
            src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}"
            alt="{{ 'gift_card.add_to_apple_wallet' | t }}"
            width="160"
            height="48"
            loading="lazy"
          >
        </a>
      {%- endif -%}

      <div class="gift-card__actions">
        <a class="gift-card__button" href="{{ routes.root_url }}">{{ 'gift_card.shop_now' | t }}</a>
        <button type="button" class="gift-card__button gift-card__button--outline" onclick="window.print()">
          {{- 'gift_card.print' | t -}}
        </button>
      </div>
    </main>

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const qr = document.getElementById('GiftCardQr');
        if (qr && window.QRCode && qr.dataset.identifier) {
          new QRCode(qr, { text: qr.dataset.identifier, width: 120, height: 120 });
        }

        const button = document.querySelector('[data-copy-code]');
        const input = document.getElementById('GiftCardCode');
        const status = document.querySelector('[data-copy-status]');
        if (!button || !input) return;
        button.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(input.value);
          } catch (error) {
            input.select();
            document.execCommand('copy');
          }
          status.textContent = status.dataset.message;
          setTimeout(() => {
            status.textContent = '';
          }, 2500);
        });
      });
    </script>
  </body>
</html>
