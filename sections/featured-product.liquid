{%- liquid
  assign product = section.settings.product
  assign form_id = 'FeaturedProductForm-' | append: section.id
  if product != blank
    assign current_variant = product.selected_or_first_available_variant
    assign featured_media = current_variant.featured_media | default: product.featured_media
  endif
-%}

<div
  class="color-{{ section.settings.color_scheme }} featured-product{% if section.settings.media_position == 'right' %} featured-product--media-right{% endif %}"
  style="--fp-padding-top: {{ section.settings.padding_top }}px; --fp-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="featured-product__media">
    {%- if featured_media -%}
      {%- assign media_alt = featured_media.alt | default: product.title | escape -%}
      {{
        featured_media.preview_image
        | image_url: width: 1400
        | image_tag:
          widths: '400, 600, 800, 1000, 1200, 1400',
          sizes: '(min-width: 990px) 50vw, 100vw',
          loading: 'lazy',
          alt: media_alt,
          class: 'featured-product__image'
      }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'featured-product__image featured-product__placeholder' }}
    {%- endif -%}
  </div>

  <div class="featured-product__info">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'title' -%}
          <h2 class="featured-product__title" {{ block.shopify_attributes }}>
            {%- if product != blank -%}
              <a href="{{ product.url }}">{{ product.title | escape }}</a>
            {%- else -%}
              {{ 'sections.featured_product.placeholder_title' | t }}
            {%- endif -%}
          </h2>

        {%- when 'price' -%}
          <p class="featured-product__price" {{ block.shopify_attributes }}>
            {%- if product != blank -%}
              <span data-variant-price="{{ form_id }}">{% render 'price', amount: current_variant.price %}</span>
              {%- if current_variant.compare_at_price > current_variant.price -%}
                <s data-variant-compare="{{ form_id }}">{% render 'price', amount: current_variant.compare_at_price %}</s>
              {%- else -%}
                <s data-variant-compare="{{ form_id }}" hidden></s>
              {%- endif -%}
            {%- else -%}
              {% render 'price', amount: 1999 %}
            {%- endif -%}
          </p>

        {%- when 'variant_picker' -%}
          {%- if product != blank -%}
            {%- unless product.has_only_default_variant -%}
              <div class="featured-product__variants" {{ block.shopify_attributes }}>
                {% render 'variant-picker', product: product, form_id: form_id, section_id: section.id %}
              </div>
            {%- endunless -%}
          {%- endif -%}

        {%- when 'quantity' -%}
          <div class="featured-product__quantity" {{ block.shopify_attributes }}>
            <label for="Quantity-{{ section.id }}">{{ 'products.quantity' | t }}</label>
            <input
              type="number"
              id="Quantity-{{ section.id }}"
              name="quantity"
              value="1"
              min="1"
              form="{{ form_id }}"
            >
          </div>

        {%- when 'buy_buttons' -%}
          <div class="featured-product__buy" {{ block.shopify_attributes }}>
            {%- if product != blank -%}
              {%- form 'product', product, id: form_id, novalidate: 'novalidate' -%}
                <input type="hidden" name="id" value="{{ current_variant.id }}">
                {%- unless product.has_only_default_variant -%}
                  <noscript>
                    <select name="id" aria-label="{{ 'products.variant_label' | t }}">
                      {%- for variant in product.variants -%}
                        <option value="{{ variant.id }}"{% if variant == current_variant %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>
                          {{ variant.title | escape }}
                        </option>
                      {%- endfor -%}
                    </select>
                  </noscript>
                {%- endunless -%}
                <button type="submit" name="add" class="featured-product__button"{% unless current_variant.available %} disabled{% endunless %}>
                  <span
                    data-variant-button-label
                    data-label-add="{{ 'products.buy.add_to_cart' | t }}"
                    data-label-sold-out="{{ 'products.buy.sold_out' | t }}"
                  >
                    {%- if current_variant.available -%}
                      {{ 'products.buy.add_to_cart' | t }}
                    {%- else -%}
                      {{ 'products.buy.sold_out' | t }}
                    {%- endif -%}
                  </span>
                </button>
                {%- if block.settings.show_dynamic_checkout -%}
                  {{ form | payment_button }}
                {%- endif -%}
              {%- endform -%}
            {%- else -%}
              <button type="button" class="featured-product__button" disabled>{{ 'products.buy.add_to_cart' | t }}</button>
            {%- endif -%}
          </div>

        {%- when 'description' -%}
          {%- if product.description != blank -%}
            <div class="featured-product__description" {{ block.shopify_attributes }}>
              {{ product.description }}
            </div>
          {%- endif -%}

        {%- when 'custom_liquid' -%}
          <div {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>

        {%- when '@app' -%}
          {% render block %}
      {%- endcase -%}
    {%- endfor -%}

    {%- if product != blank -%}
      <a href="{{ product.url }}" class="featured-product__link">{{ 'sections.featured_product.view_details' | t }}</a>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .featured-product {
    display: grid;
    gap: 2rem;
    align-items: center;
    padding-top: var(--fp-padding-top);
    padding-bottom: var(--fp-padding-bottom);
  }

  .featured-product__media {
    overflow: hidden;
    aspect-ratio: var(--card-image-ratio, 3 / 4);
    background: color-mix(in srgb, currentColor 5%, transparent);
  }

  .featured-product__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .featured-product__info {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }

  .featured-product__title {
    margin: 0;
    font-size: var(--font-heading-size, 2rem);
  }

  .featured-product__title a {
    color: inherit;
    text-decoration: none;
  }

  .featured-product__price {
    display: flex;
    gap: 0.75rem;
    margin: 0;
    font-size: 1.125rem;
    font-weight: 600;
  }

  .featured-product__price s {
    font-weight: 400;
    opacity: 0.6;
  }

  .featured-product__quantity {
    display: grid;
    gap: 0.375rem;
    max-width: 8rem;
  }

  .featured-product__quantity input {
    min-height: 2.75rem;
    padding: 0.5rem 0.75rem;
    border: var(--input-border-thickness, 1px) solid currentColor;
    background: transparent;
    color: inherit;
  }

  .featured-product__buy form {
    display: grid;
    gap: 0.75rem;
  }

  .featured-product__button {
    min-height: 3rem;
    padding: 0.75rem 1.5rem;
    border: var(--button-border-thickness, 1px) solid currentColor;
    border-radius: var(--button-radius, 0);
    background: var(--color-foreground);
    color: var(--color-background);
    font: inherit;
    font-weight: 600;
    text-transform: var(--button-text-transform, none);
    cursor: pointer;
  }

  .featured-product__button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .featured-product__link {
    color: inherit;
    text-underline-offset: 0.2em;
  }

  @media screen and (min-width: 990px) {
    .featured-product {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }

    .featured-product--media-right .featured-product__media {
      order: 2;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.featured_product.name",
  "tag": "section",
  "class": "section-featured-product",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "product",
      "id": "product",
      "label": "t:sections.featured_product.settings.product.label"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "t:sections.featured_product.settings.media_position.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.featured_product.settings.media_position.options.left"
        },
        {
          "value": "right",
          "label": "t:sections.featured_product.settings.media_position.options.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.featured_product.settings.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.featured_product.settings.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "title",
      "name": "t:sections.featured_product.blocks.title.name",
      "limit": 1
    },
    {
      "type": "price",
      "name": "t:sections.featured_product.blocks.price.name",
      "limit": 1
    },
    {
      "type": "variant_picker",
      "name": "t:sections.featured_product.blocks.variant_picker.name",
      "limit": 1
    },
    {
      "type": "quantity",
      "name": "t:sections.featured_product.blocks.quantity.name",
      "limit": 1
    },
    {
      "type": "buy_buttons",
      "name": "t:sections.featured_product.blocks.buy_buttons.name",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "label": "t:sections.product.blocks.buy_button.settings.show_dynamic_checkout.label",
          "info": "t:sections.product.blocks.buy_button.settings.show_dynamic_checkout.info",
          "default": true
        }
      ]
    },
    {
      "type": "description",
      "name": "t:sections.featured_product.blocks.description.name",
      "limit": 1
    },
    {
      "type": "custom_liquid",
      "name": "t:sections.product.blocks.custom_liquid.name",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "t:sections.product.blocks.custom_liquid.settings.custom_liquid.label",
          "info": "t:sections.product.blocks.custom_liquid.settings.custom_liquid.info"
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured_product.name",
      "blocks": [
        {
          "type": "title"
        },
        {
          "type": "price"
        },
        {
          "type": "variant_picker"
        },
        {
          "type": "quantity"
        },
        {
          "type": "buy_buttons"
        },
        {
          "type": "description"
        }
      ]
    }
  ]
}
{% endschema %}
