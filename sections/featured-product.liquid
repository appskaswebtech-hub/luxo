{%- liquid
  assign product = section.settings.product
  assign form_id = 'FeaturedProductForm-' | append: section.id
  if product != blank
    assign current_variant = product.selected_or_first_available_variant
    assign featured_media = current_variant.featured_media | default: product.featured_media
  endif
-%}

<div
  class="color-{{ section.settings.color_scheme }} featured-product full-width{% if section.settings.media_position == 'right' %} featured-product--media-right{% endif %}{% if product == blank %} featured-product--placeholder{% endif %}"
  style="--fp-padding-top: {{ section.settings.padding_top }}px; --fp-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="featured-product__inner">
  <div class="featured-product__media">
    {%- if featured_media -%}
      {%- assign media_alt = featured_media.alt | default: product.title | escape -%}
      {{
        featured_media.preview_image
        | image_url: width: 1400
        | image_tag:
          widths: '400, 600, 800, 1000, 1200, 1400',
          sizes: '(min-width: 990px) 50vw, 100vw',
          loading: 'lazy',
          alt: media_alt,
          class: 'featured-product__image'
      }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'featured-product__image featured-product__placeholder' }}
    {%- endif -%}
  </div>

  <div class="featured-product__info">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'title' -%}
          <p class="featured-product__vendor">
            {%- if product != blank -%}
              {{ product.vendor | escape }}
            {%- else -%}
              {{ shop.name | escape }}
            {%- endif -%}
          </p>
          <h2 class="featured-product__title" {{ block.shopify_attributes }}>
            {%- if product != blank -%}
              <a href="{{ product.url }}">{{ product.title | escape }}</a>
            {%- else -%}
              {{ 'sections.featured_product.placeholder_title' | t }}
            {%- endif -%}
          </h2>

        {%- when 'price' -%}
          <div class="featured-product__price" {{ block.shopify_attributes }}>
            {%- if product != blank -%}
              {% render 'price-tag', product: product, variant: current_variant, form_id: form_id, savings: true, tax_note: true %}
            {%- else -%}
              {% render 'price', amount: 1999 %}
            {%- endif -%}
          </div>

        {%- when 'variant_picker' -%}
          {%- if product != blank -%}
            {%- unless product.has_only_default_variant -%}
              <div class="featured-product__variants" {{ block.shopify_attributes }}>
                {% render 'variant-picker', product: product, form_id: form_id, section_id: section.id %}
              </div>
            {%- endunless -%}
          {%- endif -%}

        {%- when 'quantity' -%}
          <div class="featured-product__quantity" {{ block.shopify_attributes }}>
            <label for="Quantity-{{ section.id }}" class="featured-product__qty-label">{{ 'products.quantity' | t }}</label>
            <featured-quantity class="featured-product__qty-wrapper">
              <button type="button" class="featured-product__qty-btn" data-qty="minus" aria-label="{{ 'products.quantity_decrease' | t }}">-</button>
              <input
                type="number"
                id="Quantity-{{ section.id }}"
                name="quantity"
                value="1"
                min="1"
                form="{{ form_id }}"
                class="featured-product__qty-input"
              >
              <button type="button" class="featured-product__qty-btn" data-qty="plus" aria-label="{{ 'products.quantity_increase' | t }}">+</button>
            </featured-quantity>
          </div>

        {%- when 'buy_buttons' -%}
          <div class="featured-product__buy" {{ block.shopify_attributes }}>
            {%- if product != blank -%}
              {%- form 'product', product, id: form_id, novalidate: 'novalidate' -%}
                <input type="hidden" name="id" value="{{ current_variant.id }}">
                {%- unless product.has_only_default_variant -%}
                  <noscript>
                    <label class="visually-hidden" for="FeaturedVariant-{{ section.id }}">{{ 'products.variant_label' | t }}</label>
                    <select name="id" id="FeaturedVariant-{{ section.id }}">
                      {%- for variant in product.variants -%}
                        <option value="{{ variant.id }}"{% if variant == current_variant %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>
                          {{ variant.title | escape }}
                        </option>
                      {%- endfor -%}
                    </select>
                  </noscript>
                {%- endunless -%}
                <button type="submit" name="add" class="featured-product__button"{% unless current_variant.available %} disabled{% endunless %}>
                  <span
                    data-variant-button-label
                    data-label-add="{{ 'products.buy.add_to_cart' | t }}"
                    data-label-sold-out="{{ 'products.buy.sold_out' | t }}"
                  >
                    {%- if current_variant.available -%}
                      {{ 'products.buy.add_to_cart' | t }}
                    {%- else -%}
                      {{ 'products.buy.sold_out' | t }}
                    {%- endif -%}
                  </span>
                </button>
                {%- if block.settings.show_dynamic_checkout -%}
                  {{ form | payment_button }}
                {%- endif -%}
              {%- endform -%}
            {%- else -%}
              <button type="button" class="featured-product__button" disabled>{{ 'products.buy.add_to_cart' | t }}</button>
            {%- endif -%}
          </div>

        {%- when 'description' -%}
          {%- if product != blank -%}
            {%- if product.description != blank -%}
              <div class="featured-product__description rte" {{ block.shopify_attributes }}>
                {{ product.description | truncatewords: 40 }}
              </div>
            {%- endif -%}
          {%- else -%}
            <div class="featured-product__description rte" {{ block.shopify_attributes }}>
              <p>{{ 'sections.featured_product.placeholder_description' | t }}</p>
            </div>
          {%- endif -%}

        {%- when 'custom_liquid' -%}
          <div {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>

        {%- when '@app' -%}
          {% render block %}
      {%- endcase -%}
    {%- endfor -%}

    {%- if product != blank -%}
      <a href="{{ product.url }}" class="featured-product__link">{{ 'sections.featured_product.view_details' | t }}</a>
    {%- endif -%}
  </div>
  </div>
</div>

{% stylesheet %}
  .featured-product {
    padding-top: var(--fp-padding-top);
    padding-bottom: var(--fp-padding-bottom);
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .featured-product__inner {
    display: grid;
    gap: 2rem;
    align-items: center;
    max-width: var(--page-width, 1200px);
    margin: 0 auto;
    padding: 0 var(--page-margin, 20px);
  }

  .featured-product__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border-radius: 16px;
    background: color-mix(in srgb, var(--color-foreground) 5%, var(--color-background));
  }

  .featured-product__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .featured-product__placeholder {
    padding: 18%;
    object-fit: contain;
    fill: color-mix(in srgb, var(--color-foreground) 55%, transparent);
  }

  .featured-product__info {
    display: grid;
    gap: 1.25rem;
    align-content: center;
    max-width: 32rem;
  }

  .featured-product__vendor {
    margin: 0 0 -0.75rem;
    color: var(--color-accent, currentColor);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .featured-product__title {
    margin: 0;
    font-size: clamp(1.75rem, 3.2vw, 2.5rem);
    line-height: 1.15;
  }

  .featured-product__title a {
    color: inherit;
    text-decoration: none;
  }

  .featured-product__price {
    padding-bottom: 1.25rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-foreground) 12%, transparent);
    font-size: 1.25rem;
    font-weight: 600;
  }

  .featured-product__description {
    font-size: 0.9375rem;
    opacity: 0.85;
  }

  .featured-product__quantity {
    display: flex;
    align-items: center;
    gap: 15px;
  }

  .featured-product__qty-label {
    font-weight: 700;
    text-transform: uppercase;
    font-size: 13px;
  }

  .featured-product__qty-wrapper {
    display: flex;
    border: 1px solid color-mix(in srgb, currentColor 20%, transparent);
    overflow: hidden;
    background: transparent;
  }

  .featured-product__qty-btn {
    width: 35px;
    height: 35px;
    padding: 0;
    background: transparent;
    border: none;
    color: inherit;
    cursor: pointer;
    font-size: 16px;
  }

  .featured-product__qty-input {
    width: 40px;
    padding: 0;
    text-align: center;
    border: none;
    border-left: 1px solid color-mix(in srgb, currentColor 20%, transparent);
    border-right: 1px solid color-mix(in srgb, currentColor 20%, transparent);
    font-family: inherit;
    font-weight: 600;
    background: transparent;
    color: inherit;
    -moz-appearance: textfield;
    appearance: textfield;
  }

  .featured-product__qty-input::-webkit-outer-spin-button,
  .featured-product__qty-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .featured-product__qty-btn:focus-visible,
  .featured-product__qty-input:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: -2px;
  }

  .featured-product__buy form {
    display: grid;
    gap: 0.75rem;
  }

  .featured-product__button {
    width: 100%;
    min-height: 3.25rem;
    padding: 0.75rem 1.5rem;
    border: var(--button-border-thickness, 1px) solid var(--color-foreground);
    border-radius: var(--button-radius, 0);
    background: var(--color-foreground);
    color: var(--color-background);
    letter-spacing: 0.06em;
    transition: background-color 0.2s ease, border-color 0.2s ease;
    font: inherit;
    font-weight: 600;
    text-transform: var(--button-text-transform, none);
    cursor: pointer;
  }

  .featured-product__button:hover:not(:disabled) {
    border-color: var(--color-accent, var(--color-foreground));
    background: var(--color-accent, var(--color-foreground));
  }

  .featured-product__button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .featured-product__button:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 3px;
  }

  .featured-product__link {
    justify-self: start;
    color: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    text-underline-offset: 0.25em;
  }

  .featured-product__link:hover {
    color: var(--color-accent, inherit);
  }

  @media screen and (min-width: 990px) {
    .featured-product__inner {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      gap: 5rem;
    }

    .featured-product--media-right .featured-product__media {
      order: 2;
    }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('featured-quantity')) {
    customElements.define(
      'featured-quantity',
      class FeaturedQuantity extends HTMLElement {
        connectedCallback() {
          const input = this.querySelector('input');
          this.querySelectorAll('[data-qty]').forEach((button) => {
            button.addEventListener('click', () => {
              const current = parseInt(input.value, 10) || 1;
              const next = button.dataset.qty === 'minus' ? Math.max(1, current - 1) : current + 1;
              input.value = next;
              input.dispatchEvent(new Event('change', { bubbles: true }));
            });
          });
        }
      }
    );
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.featured_product.name",
  "tag": "section",
  "class": "section-featured-product",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "product",
      "id": "product",
      "label": "t:sections.featured_product.settings.product.label"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "t:sections.featured_product.settings.media_position.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.featured_product.settings.media_position.options.left"
        },
        {
          "value": "right",
          "label": "t:sections.featured_product.settings.media_position.options.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.featured_product.settings.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.featured_product.settings.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "title",
      "name": "t:sections.featured_product.blocks.title.name",
      "limit": 1
    },
    {
      "type": "price",
      "name": "t:sections.featured_product.blocks.price.name",
      "limit": 1
    },
    {
      "type": "variant_picker",
      "name": "t:sections.featured_product.blocks.variant_picker.name",
      "limit": 1
    },
    {
      "type": "quantity",
      "name": "t:sections.featured_product.blocks.quantity.name",
      "limit": 1
    },
    {
      "type": "buy_buttons",
      "name": "t:sections.featured_product.blocks.buy_buttons.name",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "label": "t:sections.product.blocks.buy_button.settings.show_dynamic_checkout.label",
          "info": "t:sections.product.blocks.buy_button.settings.show_dynamic_checkout.info",
          "default": true
        }
      ]
    },
    {
      "type": "description",
      "name": "t:sections.featured_product.blocks.description.name",
      "limit": 1
    },
    {
      "type": "custom_liquid",
      "name": "t:sections.product.blocks.custom_liquid.name",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "t:sections.product.blocks.custom_liquid.settings.custom_liquid.label",
          "info": "t:sections.product.blocks.custom_liquid.settings.custom_liquid.info"
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured_product.name",
      "blocks": [
        {
          "type": "title"
        },
        {
          "type": "price"
        },
        {
          "type": "variant_picker"
        },
        {
          "type": "quantity"
        },
        {
          "type": "buy_buttons"
        },
        {
          "type": "description"
        }
      ]
    }
  ]
}
{% endschema %}
