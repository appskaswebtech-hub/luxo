{%- assign scheme = section.settings.color_scheme.settings -%}

<div
  class="main-page"
  style="
    --page-bg: {{ scheme.background }};
    --page-text: {{ scheme.text }};
    --page-pt: {{ section.settings.padding_top }}px;
    --page-pb: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="main-page__inner main-page__inner--{{ section.settings.width }}">
    <h1 class="main-page__title">{{ page.title | escape }}</h1>
    <div class="main-page__content rte">
      {{ page.content }}
    </div>
  </div>
</div>

{% stylesheet %}
  .main-page {
    padding: var(--page-pt) 1.25rem var(--page-pb);
    background: var(--page-bg);
    color: var(--page-text);
  }

  .main-page__inner {
    margin: 0 auto;
  }

  .main-page__inner--narrow {
    max-width: 48rem;
  }

  .main-page__inner--wide {
    max-width: var(--page-width, 1200px);
  }

  .main-page__title {
    margin: 0 0 2rem;
    font-size: clamp(2rem, 5vw, 3rem);
    text-align: center;
    overflow-wrap: break-word;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.page",
  "tag": "section",
  "class": "main-page-section",
  "settings": [
    {
      "type": "select",
      "id": "width",
      "label": "t:sections.page.settings.width.label",
      "default": "narrow",
      "options": [
        { "value": "narrow", "label": "t:sections.page.settings.width.options__narrow" },
        { "value": "wide", "label": "t:sections.page.settings.width.options__wide" }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.page.settings.padding_top.label",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.page.settings.padding_bottom.label",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ]
}
{% endschema %}
