{%- liquid
  assign use_custom = section.settings.enable_custom_design

  if use_custom
    assign bg_color = section.settings.custom_bg_color
    assign text_color = section.settings.custom_text_color
    assign accent_color = section.settings.custom_accent_color
    assign heading_font = section.settings.custom_heading_font.family | append: ', ' | append: section.settings.custom_heading_font.fallback_families
    assign body_font = section.settings.custom_body_font.family | append: ', ' | append: section.settings.custom_body_font.fallback_families
    render 'custom-fonts', heading: section.settings.custom_heading_font, body: section.settings.custom_body_font
  else
    assign bg_color = section.settings.color_scheme.settings.background
    assign text_color = section.settings.color_scheme.settings.text
    assign accent_color = section.settings.color_scheme.settings.accent
    assign heading_font = 'var(--font-heading-family)'
    assign body_font = 'var(--font-body-family)'
  endif

  capture placeholder_class
    echo 'category-collection-' | append: section.id | append: '__image category-collection-' | append: section.id | append: '__placeholder'
  endcapture
-%}

<section 
  class="category-collection-{{ section.id }}" 
  id="CategoryCollection-{{ section.id }}"
  style="
    background-color: {{ bg_color }}; 
    --category-text-color: {{ text_color }};
    --category-accent-color: {{ accent_color }};
    --category-heading-font: {{ heading_font }};
    --category-body-font: {{ body_font }};
    padding-top: {{ section.settings.section_padding_top }}px;
    padding-bottom: {{ section.settings.section_padding_bottom }}px;
  "
>
  <div class="category-collection-{{ section.id }}__container">
    <div class="category-collection-{{ section.id }}__title-group">
      {%- assign list_heading = 'collection_list.title' | t -%}
      {%- if section.settings.heading_text != blank -%}
        {%- assign list_heading = section.settings.heading_text -%}
      {%- endif -%}
      <h1 class="category-collection-{{ section.id }}__heading">{{ list_heading | escape }}</h1>
    </div>

    {%- paginate collections by section.settings.per_page -%}
      <div class="category-collection-{{ section.id }}__grid-layout">
        {%- for collection in collections -%}
          {%- liquid
            assign card_image = collection.featured_image
            assign card_desc = collection.description | strip_html | truncate: 100
          -%}

          <div class="category-collection-{{ section.id }}__column">
            {%- if card_desc != blank -%}
              <p class="category-collection-{{ section.id }}__description">{{ card_desc }}</p>
            {%- endif -%}

            <div class="category-collection-{{ section.id }}__card-wrapper">
              <div class="category-collection-{{ section.id }}__card">
                <a href="{{ collection.url }}" class="category-collection-{{ section.id }}__btn">
                  {{- section.settings.button_text | escape -}}
                  <span class="visually-hidden">: {{ collection.title | escape }}</span>
                </a>

                {%- if card_image != blank -%}
                  {%- capture img_class -%}category-collection-{{ section.id }}__image{%- endcapture -%}
                  {{ card_image | image_url: width: 600 | image_tag: widths: '165, 220, 300, 400, 600', sizes: '(min-width: 990px) 33vw, (min-width: 769px) 50vw, 100vw', loading: 'lazy', alt: collection.title, class: img_class }}
                {%- else -%}
                  {{ 'collection-1' | placeholder_svg_tag: placeholder_class }}
                {%- endif -%}

                <h2 class="category-collection-{{ section.id }}__tag">{{ collection.title | escape }}</h2>
              </div>
            </div>
          </div>
        {%- else -%}
          <p class="category-collection-{{ section.id }}__empty">{{ 'collection_list.empty' | t }}</p>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="category-collection-{{ section.id }}__pagination" aria-label="{{ 'collection_list.pagination' | t }}">
          {{ paginate | default_pagination }}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% style %}
  .category-collection-{{ section.id }} {
    width: 100vw;
    max-width: 100vw;
    margin-left: -50vw;
    margin-right: -50vw;
    left: 50%;
    right: 50%;
    position: relative;
    box-sizing: border-box;
    font-family: var(--category-body-font), sans-serif;
    overflow: hidden;
  }

  .category-collection-{{ section.id }}__container {
    width: 100%;
    max-width: var(--page-width, 1300px);
    margin: 0 auto;
    padding: 0 var(--page-margin, 20px);
  }

  .category-collection-{{ section.id }}__title-group {
    position: relative;
    text-align: center;
    margin: 0 auto;
    margin-bottom: 4rem;
  }

  .category-collection-{{ section.id }}__heading {
    font-family: var(--category-heading-font), serif;
    font-size: clamp(2.5rem, 6vw, 5rem);
    color: var(--category-text-color);
    line-height: 1;
    position: relative;
    padding-bottom: 0.5rem;
    text-transform: uppercase;
    margin: 0;
    letter-spacing: 1px;
  }

  .category-collection-{{ section.id }}__heading::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    height: 6px;
    width: 100%;
    background-color: var(--category-text-color);
  }

  .category-collection-{{ section.id }}__grid-layout {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3rem;
    align-items: center;
  }

  .category-collection-{{ section.id }}__column {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    text-align: center;
  }

  .category-collection-{{ section.id }}__description {
    font-size: 0.95rem;
    color: var(--category-text-color);
    opacity: 0.8;
    padding: 0 1rem;
    margin: 1.5rem 0;
    line-height: 1.6;
  }

  .category-collection-{{ section.id }}__card-wrapper {
    position: relative;
    width: 100%;
  }

  .category-collection-{{ section.id }}__card {
    background-color: #ffffff;
    padding: 1.5rem;
    position: relative;
    width: 100%;
    box-shadow: 0 10px 30px rgba(43, 30, 22, 0.08);
    border-radius: 4px;
    transition: transform 0.3s ease;
  }

  .category-collection-{{ section.id }}__card:hover {
    transform: translateY(-5px);
  }

  .category-collection-{{ section.id }}__image {
    width: 100%;
    display: block;
    object-fit: cover;
    aspect-ratio: 4 / 5;
    border-radius: 2px;
  }

  .category-collection-{{ section.id }}__placeholder {
    width: 100%;
    aspect-ratio: 4 / 5;
    background-color: #F3EFEA;
    border: 1px dashed rgba(43, 30, 22, 0.2);
    border-radius: 2px;
  }

  .category-collection-{{ section.id }}__btn {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translate(-50%, 50%);
    z-index: 10;
    background-color: var(--category-accent-color);
    color: #ffffff;
    text-decoration: none;
    padding: 0.8rem 1.8rem;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    white-space: nowrap;
    border: 2px solid var(--category-text-color);
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
  }

  .category-collection-{{ section.id }}__btn:hover {
    background-color: #ffffff;
    color: var(--category-accent-color);
    border-color: var(--category-accent-color);
  }

  .category-collection-{{ section.id }}__tag {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translate(-50%, -50%);
    background-color: #ffffff;
    color: var(--category-text-color);
    padding: 0.8rem 2.5rem;
    font-weight: 700;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    border: 2px solid var(--category-text-color);
    max-width: 90%;
    margin: 0;
    font-family: inherit;
    line-height: 1.3;
    text-align: center;
    white-space: normal;
    overflow-wrap: anywhere;
    z-index: 10;
  }

  @media screen and (max-width: 991px) {
    .category-collection-{{ section.id }}__grid-layout {
      gap: 2rem;
    }
    .category-collection-{{ section.id }}__description {
      padding: 0;
      font-size: 0.85rem;
    }
    .category-collection-{{ section.id }}__tag {
      padding: 0.6rem 1.5rem;
      font-size: 0.8rem;
    }
  }

  @media screen and (max-width: 768px) {
    .category-collection-{{ section.id }}__grid-layout {
      grid-template-columns: 1fr;
      gap: 5rem;
    }
    .category-collection-{{ section.id }}__column {
      max-width: 420px;
      margin: 0 auto;
      width: 100%;
    }
    .category-collection-{{ section.id }}__title-group {
      margin-bottom: 3rem;
    }
  }
  .category-collection-{{ section.id }}__empty {
    grid-column: 1 / -1;
    text-align: center;
  }

  .category-collection-{{ section.id }}__pagination {
    display: flex;
    justify-content: center;
    margin-top: 4rem;
    font-weight: 600;
  }

  .category-collection-{{ section.id }}__pagination .page,
  .category-collection-{{ section.id }}__pagination .next,
  .category-collection-{{ section.id }}__pagination .prev {
    display: inline-block;
    margin: 0 0.5rem;
  }

  .category-collection-{{ section.id }}__pagination a {
    color: inherit;
  }

  .category-collection-{{ section.id }}__pagination .current {
    color: var(--category-accent-color);
  }
{% endstyle %}

{% schema %}
{
  "name": "t:sections.collections.name",
  "tag": "section",
  "class": "section-collection-list-template",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.collections.headers.section_settings"
    },
    {
      "type": "text",
      "id": "heading_text",
      "label": "t:sections.collections.settings.heading_text.label",
      "default": "Collections"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "t:sections.collections.settings.button_text.label",
      "default": "Shop now"
    },
    {
      "type": "range",
      "id": "per_page",
      "label": "t:sections.collections.settings.per_page.label",
      "min": 6,
      "max": 48,
      "step": 3,
      "default": 12
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "t:sections.collections.settings.section_padding_top.label",
      "default": 80
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "t:sections.collections.settings.section_padding_bottom.label",
      "default": 80
    },
    {
      "type": "header",
      "content": "t:sections.collections.headers.default_colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.collections.headers.custom_design_override"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_design",
      "label": "t:sections.collections.settings.enable_custom_design.label",
      "info": "t:sections.collections.settings.enable_custom_design.info",
      "default": false
    },
    {
      "type": "color",
      "id": "custom_bg_color",
      "label": "t:sections.collections.settings.custom_bg_color.label",
      "default": "#FFFFFF",
      "visible_if": "{{ section.settings.enable_custom_design }}"
    },
    {
      "type": "color",
      "id": "custom_text_color",
      "label": "t:sections.collections.settings.custom_text_color.label",
      "default": "#111111",
      "visible_if": "{{ section.settings.enable_custom_design }}"
    },
    {
      "type": "color",
      "id": "custom_accent_color",
      "label": "t:sections.collections.settings.custom_accent_color.label",
      "default": "#000000",
      "visible_if": "{{ section.settings.enable_custom_design }}"
    },
    {
      "type": "font_picker",
      "id": "custom_heading_font",
      "label": "t:sections.collections.settings.custom_heading_font.label",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_design }}"
    },
    {
      "type": "font_picker",
      "id": "custom_body_font",
      "label": "t:sections.collections.settings.custom_body_font.label",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_design }}"
    }
  ]
}
{% endschema %}