    },
    {
      "type": "font_picker",
      "id": "custom_body_font",
      "label": "Custom Body Font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_design }}"
    },
    {
      "type": "header",
      "content": "Custom Button Settings",
      "visible_if": "{{ section.settings.enable_custom_design }}"
    },
    {
      "type": "color",
      "id": "custom_btn_bg_color",
      "label": "Button Background",
      "default": "#111111",
      "visible_if": "{{ section.settings.enable_custom_design }}"
    },
    {
      "type": "color",
      "id": "custom_btn_text_color",
      "label": "Button Text Color",
      "default": "#FFFFFF",
      "visible_if": "{{ section.settings.enable_custom_design }}"
