{%- liquid
  assign use_custom = section.settings.enable_custom_design

  if use_custom
    assign footer_bg = section.settings.custom_bg_color
    assign footer_text = section.settings.custom_text_color
    assign footer_accent = section.settings.custom_accent_color
    assign footer_card_bg = section.settings.custom_card_bg
    assign footer_scallop = section.settings.custom_scallop_color
    assign link_bg = section.settings.custom_link_bg
    assign link_text = section.settings.custom_link_text
    assign link_shadow = section.settings.custom_link_shadow
    assign bottom_bg = section.settings.custom_bottom_bg
    assign bottom_text = section.settings.custom_bottom_text
    assign heading_font = section.settings.custom_heading_font
    assign body_font = section.settings.custom_body_font
  else
    assign footer_bg = section.settings.color_scheme.settings.background
    assign footer_text = section.settings.color_scheme.settings.text
    assign footer_accent = section.settings.color_scheme.settings.accent
    assign footer_card_bg = section.settings.card_background
    assign footer_scallop = section.settings.scallop_color
    assign link_bg = section.settings.link_bg_color
    assign link_text = section.settings.link_text_color
    assign link_shadow = section.settings.link_shadow_color
    assign bottom_bg = section.settings.bottom_bg_color
    assign bottom_text = section.settings.bottom_text_color
    assign heading_font = 'var(--font-heading-family)'
    assign body_font = 'var(--font-body-family)'
  endif
-%}

<footer 
  class="footer-{{ section.id }}" 
  id="Footer-{{ section.id }}"
  style="
    --footer-bg: {{ footer_bg }};
    --footer-text: {{ footer_text }};
    --footer-accent: {{ footer_accent }};
    --footer-card-bg: {{ footer_card_bg }};
    --footer-scallop: {{ footer_scallop }};
    --link-bg: {{ link_bg }};
    --link-text: {{ link_text }};
    --link-size: {{ section.settings.link_font_size }}px;
    --link-shadow: {{ link_shadow }};
    --social-bg: {{ section.settings.social_bg_color }};
    --social-text: {{ section.settings.social_text_color }};
    --social-size: {{ section.settings.social_font_size }}px;
    --input-bg: {{ section.settings.input_bg_color }};
    --input-text: {{ section.settings.input_text_color }};
    --bottom-bg: {{ bottom_bg }};
    --bottom-text: {{ bottom_text }};
    --bottom-size: {{ section.settings.bottom_font_size }}px;
    --footer-heading-font: {{ heading_font }};
    --footer-body-font: {{ body_font }};
  "
>
  <div class="footer-{{ section.id }}__scallop-border" aria-hidden="true"></div>

  <div class="footer-{{ section.id }}__container">
    
    <div class="footer-{{ section.id }}__layout">
      
      <div class="footer-{{ section.id }}__columns-left">
        {%- for block in section.blocks -%}
          {%- if block.type == 'brand_info' -%}
            <div class="footer-{{ section.id }}__mission" {{ block.shopify_attributes }}>
              {%- if block.settings.brand_logo != blank -%}
                {%- capture img_alt -%}{{ shop.name }}{%- endcapture -%}{%- capture img_class -%}footer-{{ section.id }}__brand-logo{%- endcapture -%}{{ block.settings.brand_logo | image_url: width: 300 | image_tag: widths: '100, 165, 220, 300', sizes: '150px', loading: 'lazy', alt: img_alt, class: img_class }}
              {%- else -%}
                <h2 class="footer-{{ section.id }}__brand-title">{{ shop.name }}</h2>
              {%- endif -%}
              
              {%- if block.settings.mission_text != blank -%}
                <p class="footer-{{ section.id }}__mission-text">{{ block.settings.mission_text }}</p>
              {%- endif -%}
            </div>
          {%- elsif block.type == 'newsletter' -%}
            <div class="footer-{{ section.id }}__newsletter-card" {{ block.shopify_attributes }}>
              <h3 class="footer-{{ section.id }}__newsletter-title">{{ block.settings.newsletter_title }}</h3>
              <p class="footer-{{ section.id }}__newsletter-text">{{ block.settings.newsletter_text }}</p>
              
              {%- form 'customer', id: 'FooterNewsletter' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <div class="footer-{{ section.id }}__input-group">
                  <input 
                    type="email" 
                    name="contact[email]" 
                    placeholder="{{ 'general.newsletter.email_placeholder' | t }}" 
                    class="footer-{{ section.id }}__input" 
                    required
                    aria-label="{{ 'general.newsletter.email_label' | t }}"
                  >
                  <button type="submit" class="footer-{{ section.id }}__submit-btn" aria-label="{{ 'general.newsletter.subscribe' | t }}">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                  </button>
                </div>
                {%- if form.posted_successfully? -%}
                  <p class="footer-{{ section.id }}__success-msg">{{ 'general.newsletter.success' | t }}</p>
                {%- endif -%}
                {%- if form.errors -%}
                  <p class="footer-{{ section.id }}__error-msg">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
                {%- endif -%}
              {%- endform -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="footer-{{ section.id }}__columns-right">
        {%- for block in section.blocks -%}
          {%- if block.type == 'menu' -%}
            <div class="footer-{{ section.id }}__links-group" {{ block.shopify_attributes }}>
              <h4 class="footer-{{ section.id }}__heading">{{ block.settings.menu_title }}</h4>
              <ul class="footer-{{ section.id }}__list">
                {%- for link in linklists[block.settings.menu].links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
                {%- if block.settings.show_policies -%}
                  {%- if shop.policies.privacy_policy != blank -%}
                    <li><a href="{{ shop.policies.privacy_policy.url }}">{{ shop.policies.privacy_policy.title }}</a></li>
                  {%- endif -%}
                  {%- if shop.policies.terms_of_service != blank -%}
                    <li><a href="{{ shop.policies.terms_of_service.url }}">{{ shop.policies.terms_of_service.title }}</a></li>
                  {%- endif -%}
                {%- endif -%}
              </ul>
            </div>
          {%- elsif block.type == 'social_links' -%}
            <div class="footer-{{ section.id }}__social-group" {{ block.shopify_attributes }}>
              <h4 class="footer-{{ section.id }}__heading">{%- assign socials_fallback = 'general.social.socials' | t -%}{{ block.settings.social_title | default: socials_fallback }}</h4>
              <div class="footer-{{ section.id }}__socials-list">
                {%- comment -%} Links come from Theme settings > Social media {%- endcomment -%}
                {%- if settings.social_instagram != blank -%}
                  <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener">{{ 'general.social.instagram' | t }}</a>
                {%- endif -%}
                {%- if settings.social_facebook != blank -%}
                  <a href="{{ settings.social_facebook }}" target="_blank" rel="noopener">{{ 'general.social.facebook' | t }}</a>
                {%- endif -%}
                {%- if settings.social_tiktok != blank -%}
                  <a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener">{{ 'general.social.tiktok' | t }}</a>
                {%- endif -%}
                {%- if settings.social_pinterest != blank -%}
                  <a href="{{ settings.social_pinterest }}" target="_blank" rel="noopener">{{ 'general.social.pinterest' | t }}</a>
                {%- endif -%}
                {%- if settings.social_youtube != blank -%}
                  <a href="{{ settings.social_youtube }}" target="_blank" rel="noopener">{{ 'general.social.youtube' | t }}</a>
                {%- endif -%}
                {%- if settings.social_x != blank -%}
                  <a href="{{ settings.social_x }}" target="_blank" rel="noopener">{{ 'general.social.x_short' | t }}</a>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <div class="footer-{{ section.id }}__bottom-bar">
      
      <div class="footer-{{ section.id }}__localization">
        {%- assign footer_class = 'footer-' | append: section.id -%}
        {%- if section.settings.show_country_selector and localization.available_countries.size > 1 -%}
          {% render 'localization-selector', type: 'country', form_id: 'FooterCountryForm', class_prefix: footer_class %}
        {%- endif -%}

        {%- if section.settings.show_language_selector and localization.available_languages.size > 1 -%}
          {% render 'localization-selector', type: 'language', form_id: 'FooterLanguageForm', class_prefix: footer_class %}
        {%- endif -%}
      </div>

      <div class="footer-{{ section.id }}__copyright">
        {%- assign current_year = 'now' | date: '%Y' -%}{{ 'general.copyright' | t: year: current_year, shop: shop.name }}
      </div>

      <div class="footer-{{ section.id }}__payments">
        {%- for type in shop.enabled_payment_types -%}
          {{ type | payment_type_svg_tag }}
        {%- endfor -%}
      </div>
    </div>

  </div>
</footer>

{% style %}
  .footer-{{ section.id }} {
    position: relative;
    width: 100vw;
    max-width: 100vw;
    margin-left: -50vw;
    margin-right: -50vw;
    left: 50%;
    right: 50%;
    background-color: var(--footer-bg);
    color: var(--footer-text);
    padding: 100px 0 30px;
    font-family: var(--footer-body-font), -apple-system, sans-serif;
    overflow: hidden;
    border-top: 31px solid #753310;
  }

  .footer-{{ section.id }}__scallop-border {
    position: absolute;
    top: -30px;
    left: 0;
    width: 100%;
    height: 30px;
    background-color: var(--footer-bg);
    -webkit-mask-image: radial-gradient(circle at 50% 100%, transparent 30px, black 31px);
    mask-image: radial-gradient(circle at 50% 100%, transparent 30px, black 31px);
    -webkit-mask-size: 60px 100%;
    mask-size: 60px 100%;
    -webkit-mask-repeat: repeat-x;
    mask-repeat: repeat-x;
    z-index: 1;
  }

  .footer-{{ section.id }}::before {
    content: '';
    position: absolute;
    top: -30px;
    left: 0;
    width: 100%;
    height: 30px;
    background-color: var(--footer-scallop);
    z-index: 0;
  }

  .footer-{{ section.id }}__container {
    width: 100%;
    max-width: var(--page-width, 1300px);
    margin: 0 auto;
    padding: 0 var(--page-margin, 20px);
    position: relative;
    z-index: 2;
    box-sizing: border-box;
  }

  .footer-{{ section.id }}__layout {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 60px;
    margin-bottom: 60px;
  }

  .footer-{{ section.id }}__columns-left {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .footer-{{ section.id }}__brand-logo {
    max-width: 150px;
    height: auto;
    margin-bottom: 10px;
    display: block;
  }

  .footer-{{ section.id }}__brand-title {
    font-family: var(--footer-heading-font), serif;
    font-size: 2rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -1px;
    margin: 0 0 10px 0;
  }

  .footer-{{ section.id }}__mission-text {
    font-size: calc(var(--font-body-size) * 0.95);
    line-height: 1.6;
    opacity: 0.8;
    max-width: 400px;
    margin: 0;
  }

  .footer-{{ section.id }}__newsletter-card {
    background-color: var(--footer-card-bg);
    padding: 30px;
    border-radius: 16px;
    box-shadow: 6px 6px 0px rgba(43, 30, 22, 0.1);
    border: 1px solid rgba(43, 30, 22, 0.1);
    max-width: 450px;
  }

  .footer-{{ section.id }}__newsletter-title {
    font-family: var(--footer-heading-font), serif;
    font-size: 16px;
    font-weight: 700;
    text-transform: uppercase;
    margin: 0 0 8px 0;
    color: var(--footer-text);
  }

  .footer-{{ section.id }}__newsletter-text {
    font-size: calc(var(--font-body-size) * 0.85);
    opacity: 0.8;
    margin: 0 0 20px 0;
    color: var(--footer-text);
  }

  .footer-{{ section.id }}__input-group {
    display: flex;
    background-color: var(--input-bg);
    padding: 4px;
    border-radius: 50px;
    box-shadow: 6px 6px 0px var(--link-shadow);
    border: 1px solid rgba(43, 30, 22, 0.1);
  }

  .footer-{{ section.id }}__input {
    flex: 1;
    border: none;
    background: transparent;
    padding: 10px 15px;
    font-size: 14px;
    outline: none;
    color: var(--input-text);
    font-family: inherit;
  }

  .footer-{{ section.id }}__input::placeholder {
    color: #999;
  }

  .footer-{{ section.id }}__submit-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: none;
    background-color: var(--footer-accent);
    color: #000;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .footer-{{ section.id }}__submit-btn:hover {
    background-color: var(--footer-text);
    transform: scale(1.05);
  }

  .footer-{{ section.id }}__success-msg {
    color: #2e7d32;
    font-size: 0.85rem;
    margin-top: 10px;
    font-weight: 600;
  }

  .footer-{{ section.id }}__error-msg {
    color: #d32f2f;
    font-size: 0.85rem;
    margin-top: 10px;
    font-weight: 600;
  }

  .footer-{{ section.id }}__columns-right {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 20px;
  }

  .footer-{{ section.id }}__links-group,
  .footer-{{ section.id }}__social-group {
    background-color: var(--footer-card-bg);
    padding: 20px;
    border-radius: 0;
    box-shadow: 6px 6px 0px rgba(43, 30, 22, 0.1);
    border: 1px solid rgba(43, 30, 22, 0.1);
  }

  .footer-{{ section.id }}__heading {
    font-family: var(--footer-heading-font), serif;
    font-size: 16px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin: 0 0 20px 0;
    color: var(--footer-text);
    text-align: center;
  }

  .footer-{{ section.id }}__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-{{ section.id }}__list a {
    display: block;
    background-color: var(--link-bg);
    color: var(--link-text);
    text-decoration: none;
    font-size: var(--link-size);
    padding: 6px 10px;
    transition: opacity 0.3s ease;
    border: 1px solid rgba(43, 30, 22, 0.1);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    box-shadow: 6px 6px 0px var(--link-shadow);
    text-align: center;
    border-radius: 100px;
  }

  .footer-{{ section.id }}__list a:hover {
    opacity: 0.8;
    border: 1px solid #ffffff;
  }

  .footer-{{ section.id }}__socials-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-{{ section.id }}__socials-list a {
    display: block;
    background-color: var(--social-bg);
    color: var(--social-text);
    text-decoration: none;
    font-size: var(--social-size);
    padding: 6px 10px;
    transition: opacity 0.3s ease;
    border: 1px solid rgba(43, 30, 22, 0.1);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    box-shadow: 6px 6px 0px var(--link-shadow);
    text-align: center;
    border-radius: 100px;
  }

  .footer-{{ section.id }}__socials-list a:hover {
    opacity: 0.8;
    border: 1px solid #ffffff;
  }

  .footer-{{ section.id }}__bottom-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    padding-top: 30px;
    border-top: 1px solid rgba(43, 30, 22, 0.1);
    gap: 20px;
  }

  .footer-{{ section.id }}__localization {
    display: flex;
    gap: 15px;
  }

  .footer-{{ section.id }}__select-wrapper {
    position: relative;
    display: inline-block;
  }

  .footer-{{ section.id }}__select {
    appearance: none;
    background-color: var(--bottom-bg);
    color: var(--bottom-text);
    font-size: var(--bottom-size);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border: 1px solid rgba(43, 30, 22, 0.1);
    padding: 10px 35px 10px 15px;
    border-radius: 100px;
    cursor: pointer;
    outline: none;
    box-shadow: 6px 6px 0px var(--link-shadow);
    transition: opacity 0.3s ease;
    font-family: inherit;
  }

  .footer-{{ section.id }}__select:hover {
    opacity: 0.8;
    border-color: #ffffff;
  }

  .footer-{{ section.id }}__chevron {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    color: var(--bottom-text);
    opacity: 0.8;
  }

  .footer-{{ section.id }}__copyright {
    background-color: var(--bottom-bg);
    color: var(--bottom-text);
    font-size: var(--bottom-size);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 10px 20px;
    border-radius: 100px;
    box-shadow: 6px 6px 0px var(--link-shadow);
    border: 1px solid rgba(43, 30, 22, 0.1);
    text-align: center;
  }

  .footer-{{ section.id }}__payments {
    display: flex;
    gap: 8px;
    opacity: 0.7;
    flex-wrap: wrap;
  }

  .footer-{{ section.id }}__payments svg {
    width: 38px;
    height: 24px;
    border-radius: 4px;
  }

  @media (max-width: 991px) {
    .footer-{{ section.id }}__layout {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .footer-{{ section.id }}__columns-right {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 768px) {
    .footer-{{ section.id }} {
      padding: 80px 0 25px;
    }
    .footer-{{ section.id }}__newsletter-card {
      padding: 20px;
    }
    .footer-{{ section.id }}__links-group,
    .footer-{{ section.id }}__social-group {
      padding: 15px;
    }
    .footer-{{ section.id }}__columns-right {
      grid-template-columns: 1fr 1fr;
      gap: 15px;
    }
    .footer-{{ section.id }}__social-group {
      grid-column: span 2;
    }
    .footer-{{ section.id }}__bottom-bar {
      flex-direction: column;
      align-items: flex-start;
    }
    .footer-{{ section.id }}__localization {
      flex-direction: column;
      width: 100%;
    }
    .footer-{{ section.id }}__select-wrapper {
      width: 100%;
    }
    .footer-{{ section.id }}__select {
      width: 100%;
    }
    .footer-{{ section.id }}__copyright {
      width: 100%;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "t:sections.footer.name",
  "tag": "footer",
  "class": "section-footer",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.footer.headers.localization"
    },
    {
      "type": "checkbox",
      "id": "show_country_selector",
      "label": "t:sections.footer.settings.show_country_selector.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_language_selector",
      "label": "t:sections.footer.settings.show_language_selector.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.footer.headers.default_colors"
    },
    {
      "type": "color",
      "id": "scallop_color",
      "label": "t:sections.footer.settings.scallop_color.label",
      "default": "#2B1E16"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "t:sections.footer.settings.card_background.label",
      "default": "#FCF9F6"
    },
    {
      "type": "header",
      "content": "t:sections.footer.headers.menu_links_style"
    },
    {
      "type": "color",
      "id": "link_bg_color",
      "label": "t:sections.footer.settings.link_bg_color.label",
      "default": "#73391d"
    },
    {
      "type": "color",
      "id": "link_text_color",
      "label": "t:sections.footer.settings.link_text_color.label",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "link_font_size",
      "min": 6,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "t:sections.footer.settings.link_font_size.label",
      "default": 14
    },
    {
      "type": "color",
      "id": "link_shadow_color",
      "label": "t:sections.footer.settings.link_shadow_color.label",
      "default": "#74310b"
    },
    {
      "type": "header",
      "content": "t:sections.footer.headers.social_links_style"
    },
    {
      "type": "color",
      "id": "social_bg_color",
      "label": "t:sections.footer.settings.social_bg_color.label",
      "default": "#73391d"
    },
    {
      "type": "color",
      "id": "social_text_color",
      "label": "t:sections.footer.settings.social_text_color.label",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "social_font_size",
      "min": 6,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "t:sections.footer.settings.social_font_size.label",
      "default": 14
    },
    {
      "type": "header",
      "content": "t:sections.footer.headers.newsletter_input_style"
    },
    {
      "type": "color",
      "id": "input_bg_color",
      "label": "t:sections.footer.settings.input_bg_color.label",
      "default": "#743a1f"
    },
    {
      "type": "color",
      "id": "input_text_color",
      "label": "t:sections.footer.settings.input_text_color.label",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "t:sections.footer.headers.bottom_bar_style"
    },
    {
      "type": "color",
      "id": "bottom_bg_color",
      "label": "t:sections.footer.settings.bottom_bg_color.label",
      "default": "#73391d"
    },
    {
      "type": "color",
      "id": "bottom_text_color",
      "label": "t:sections.footer.settings.bottom_text_color.label",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "bottom_font_size",
      "min": 6,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "t:sections.footer.settings.bottom_font_size.label",
      "default": 12
    },
