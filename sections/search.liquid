{%- if settings.search_suggestions -%}
  {{ 'predictive-search.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'predictive-search.js' | asset_url }}" defer></script>
{%- endif -%}

{%- liquid
  assign input_id = 'SearchPageInput-' | append: section.id
  assign results_id = 'PredictiveSearchResults-' | append: section.id
  assign badge_position = 'search-card__badge--' | append: settings.card_badge_position

  assign search_tag = 'div'
  if settings.search_suggestions
    assign search_tag = 'predictive-search'
  endif
-%}

<div class="search-page">
  <h1 class="search-page__title">{{ 'search.title' | t }}</h1>

  <{{ search_tag }} class="search-page__search" data-url="{{ routes.predictive_search_url }}">
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-page__form">
      <div class="search-page__field">
        <input
          type="search"
          id="{{ input_id }}"
          class="search-page__input"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder=" "
          {% if settings.search_suggestions %}
            role="combobox"
            aria-expanded="false"
            aria-controls="{{ results_id }}"
            aria-autocomplete="list"
            autocomplete="off"
          {% endif %}
        >
        <label for="{{ input_id }}" class="search-page__label">{{ 'search.label' | t }}</label>
        <input type="hidden" name="options[prefix]" value="last">

        {%- if settings.search_suggestions -%}
          <button type="button" class="search-page__clear" aria-label="{{ 'search.clear' | t }}" data-predictive-clear hidden>
            <svg viewBox="0 0 20 20" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true" focusable="false"><circle cx="10" cy="10" r="8.5"/><path d="M7 7l6 6M13 7l-6 6"/></svg>
          </button>
        {%- endif -%}
        <button type="submit" class="search-page__submit" aria-label="{{ 'search.submit' | t }}">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="7"/><path d="M20.5 20.5l-5-5"/></svg>
        </button>
      </div>
    </form>

    {%- if settings.search_suggestions -%}
      <div
        class="predictive-search"
        id="{{ results_id }}"
        role="listbox"
        aria-label="{{ 'search.predictive.label' | t }}"
        data-predictive-results
        hidden
      ></div>
      <span class="visually-hidden" role="status" data-predictive-status></span>
    {%- endif -%}
  </{{ search_tag }}>

  {%- if search.performed -%}
    <p class="search-page__count" data-facets-update="search-count-{{ section.id }}">
      {%- if search.results_count == 0 -%}
        {{ 'search.no_results_html' | t: terms: search.terms }}
      {%- else -%}
        {{ 'search.results_for_html' | t: terms: search.terms, count: search.results_count }}
      {%- endif -%}
    </p>

    {%- if search.filters.size > 0 or search.results_count > 0 -%}
      {%- capture search_clear_url -%}{{ routes.search_url }}?q={{ search.terms | url_encode }}&options%5Bprefix%5D=last{%- endcapture -%}
      {% render 'facets',
        filters: search.filters,
        sort_options: search.sort_options,
        sort_by: search.sort_by,
        action: routes.search_url,
        form_id: 'SearchFacets',
        section_id: section.id,
        terms: search.terms,
        clear_url: search_clear_url
      %}
    {%- endif -%}

    <div data-facets-update="search-results-{{ section.id }}" data-facets-count="{{ 'search.results_for_html' | t: terms: search.terms, count: search.results_count | strip_html }}">
    {%- paginate search.results by 24 -%}
      <ul class="search-page__grid" role="list">
        {%- for result in search.results -%}
          {%- if result.object_type == 'product' -%}
            {%- liquid
              assign image_alt = result.featured_image.alt | default: result.title | escape
              assign loading = 'lazy'
              if forloop.index <= 4
                assign loading = 'eager'
              endif
              assign on_sale = false
              if result.compare_at_price > result.price
                assign on_sale = true
              endif
            -%}
            {%- liquid
              assign image_behavior = settings.card_image_behavior | default: 'slider'
              assign use_slider = false
              if image_behavior == 'slider' and result.images.size > 1
                assign use_slider = true
              endif
            -%}
            <li class="search-card">
              {%- if use_slider -%}
              <div class="search-card__media">
                {% render 'card-image-slider', product: result, url: result.url, image_class: 'search-card__image', sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw' %}
              {%- else -%}
              <a href="{{ result.url }}" class="search-card__media" tabindex="-1" aria-hidden="true">
                {%- if result.featured_image -%}
                  {{
                    result.featured_image
                    | image_url: width: 600
                    | image_tag:
                      widths: '240, 360, 480, 600',
                      sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw',
                      loading: loading,
                      alt: image_alt,
                      class: 'search-card__image'
                  }}
                  {%- if image_behavior == 'hover' and result.images[1] -%}
                    {{
                      result.images[1]
                      | image_url: width: 600
                      | image_tag:
                        widths: '240, 360, 480, 600',
                        sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw',
                        loading: 'lazy',
                        alt: '',
                        class: 'search-card__image search-card__image--hover'
                    }}
                  {%- endif -%}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'search-card__image search-card__placeholder' }}
                {%- endif -%}
              {%- endif -%}

                {%- if result.available == false -%}
                  {%- if settings.card_sold_out_badge -%}
                    <span class="search-card__badge search-card__badge--sold-out {{ badge_position }}">{{ 'products.buy.sold_out' | t }}</span>
                  {%- endif -%}
                {%- elsif on_sale -%}
                  {%- if settings.card_sale_badge -%}
                    {%- liquid
                      case settings.card_sale_badge_format
                        when 'percent'
                          assign discount = result.compare_at_price | minus: result.price | times: 100 | divided_by: result.compare_at_price
                          assign sale_label = 'products.badge.sale_percent' | t: percent: discount
                        when 'amount'
                          assign saved_amount = result.compare_at_price | minus: result.price
                          capture saved
                            render 'price', amount: saved_amount
                          endcapture
                          assign sale_label = 'products.badge.sale_amount' | t: amount: saved
                        else
                          assign sale_label = 'products.badge.sale' | t
                      endcase
                    -%}
                    <span class="search-card__badge search-card__badge--sale {{ badge_position }}">{{ sale_label }}</span>
                  {%- endif -%}
                {%- endif -%}
              {%- if use_slider -%}</div>{%- else -%}</a>{%- endif -%}

              <div class="search-card__body">
                {%- if settings.card_show_vendor and result.vendor != blank -%}
                  <p class="search-card__vendor">{{ result.vendor | escape }}</p>
                {%- endif -%}
                <a href="{{ result.url }}" class="search-card__title">{{ result.title | escape }}</a>
                <div class="search-card__price">
                  {% render 'price-tag', product: result, from: true %}
                </div>
              </div>
            </li>
          {%- else -%}
            <li class="search-card search-card--text">
              <p class="search-card__type">
                {%- if result.object_type == 'article' -%}
                  {{ 'search.type.article' | t }}
                {%- else -%}
                  {{ 'search.type.page' | t }}
                {%- endif -%}
              </p>
              <a href="{{ result.url }}" class="search-card__title">{{ result.title | escape }}</a>
              {%- assign summary = result.excerpt_or_content | default: result.content | strip_html | truncatewords: 22 -%}
              {%- if summary != blank -%}
                <p class="search-card__summary">{{ summary }}</p>
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      {%- if paginate.pages > 1 -%}
        <nav class="search-page__pagination" aria-label="{{ 'search.pagination' | t }}">
          {{ paginate | default_pagination }}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
    </div>
  {%- endif -%}
</div>

{%- if section.blocks.size > 0 -%}
  <div class="app-blocks">
    {%- for block in section.blocks -%}
      {%- if block.type == '@app' -%}
        {% render block %}
      {%- endif -%}
    {%- endfor -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .search-page {
    max-width: var(--page-width, 1200px);
    margin: 0 auto;
    padding: 4rem var(--page-margin, 20px) 5rem;
  }

  .search-page__title {
    margin: 0 0 2rem;
    font-family: var(--font-heading-family, serif);
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: var(--font-heading-weight, 700);
    text-align: center;
  }

  .search-page__search {
    max-width: 46rem;
    margin: 0 auto;
  }

  .search-page__field {
    position: relative;
    display: flex;
    align-items: center;
    border: 1px solid currentColor;
    background: var(--color-background, #fff);
  }

  .search-page__input {
    flex: 1;
    min-width: 0;
    height: 3.25rem;
    padding: 1.125rem 1.25rem 0.375rem;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 1rem;
    outline: none;
    appearance: none;
  }

  .search-page__input::-webkit-search-cancel-button {
    display: none;
  }

  .search-page__label {
    position: absolute;
    top: 50%;
    left: 1.25rem;
    transform: translateY(-50%);
    font-size: 1rem;
    letter-spacing: 0.04em;
    color: color-mix(in srgb, currentColor 65%, transparent);
    pointer-events: none;
    transition: top 0.2s ease, font-size 0.2s ease;
  }

  .search-page__input:focus + .search-page__label,
  .search-page__input:not(:placeholder-shown) + .search-page__label {
    top: 0.875rem;
    font-size: 0.6875rem;
  }

  .search-page__field:focus-within {
    outline: 2px solid currentColor;
    outline-offset: -2px;
  }

  .search-page__clear,
  .search-page__submit {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  .search-page__clear[hidden] {
    display: none;
  }

  .search-page__submit {
    margin-inline-end: 0.25rem;
    border-inline-start: 1px solid color-mix(in srgb, currentColor 15%, transparent);
  }

  .search-page__count {
    margin: 2.5rem 0 1.5rem;
    text-align: center;
    color: color-mix(in srgb, currentColor 70%, transparent);
  }

  .search-page__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .search-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .search-card__media {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: var(--card-image-ratio, 3 / 4);
    background: color-mix(in srgb, currentColor 4%, transparent);
  }

  .search-card__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .search-card__image--hover {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .search-card:hover .search-card__image--hover {
    opacity: 1;
  }

  .search-card {
    transition: transform 0.3s ease;
  }

  .search-card:hover {
    transform: translateY(var(--card-hover-lift));
  }

  .search-card__image {
    transition: transform 0.6s ease, opacity 0.35s ease;
  }

  /* One image: it zooms. Two images: the first fades out and the second fades in and zooms */
  .search-card:hover .search-card__media:not(:has(.search-card__image--hover, .card-slider)) .search-card__image {
    transform: scale(var(--card-image-hover-scale));
  }

  .search-card:hover .search-card__media:has(.search-card__image--hover) .search-card__image:not(.search-card__image--hover) {
    opacity: 0;
  }

  .search-card:hover .search-card__image--hover {
    transform: scale(var(--card-image-hover-scale));
  }

  .search-card__badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.25rem 0.625rem;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .search-card__badge--top_right {
    left: auto;
    right: 0.75rem;
  }

  .search-card__badge--bottom_left {
    top: auto;
    bottom: 0.75rem;
  }

  .search-card__badge--sale {
    background: var(--color-foreground, #2b1e16);
    color: var(--color-background, #fff);
  }

  .search-card__badge--sold-out {
    background: var(--color-background, #fff);
    color: var(--color-foreground, #2b1e16);
  }

  .search-card__body {
    display: grid;
    gap: 0.25rem;
  }

  .search-card__vendor,
  .search-card__type {
    margin: 0;
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, currentColor 60%, transparent);
  }

  .search-card__title {
    font-family: var(--font-heading-family, serif);
    font-size: 1rem;
    font-weight: 700;
    color: inherit;
    text-decoration: none;
  }

  .search-card__title:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .search-card__price {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    font-size: 0.875rem;
  }

  .search-card__price s {
    color: color-mix(in srgb, currentColor 55%, transparent);
  }

  .search-card--text {
    justify-content: flex-start;
    padding: 1.5rem;
    border: 1px solid color-mix(in srgb, currentColor 12%, transparent);
  }

  .search-card__summary {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: color-mix(in srgb, currentColor 75%, transparent);
  }

  .search-page__pagination {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 3rem;
  }

  .search-page__pagination a,
  .search-page__pagination .current {
    display: inline-grid;
    place-items: center;
    min-width: 2.75rem;
    height: 2.75rem;
    padding: 0 0.75rem;
    color: inherit;
    text-decoration: none;
  }

  .search-page__pagination .current {
    border-bottom: 1px solid currentColor;
    font-weight: 700;
  }

  @media screen and (min-width: 750px) {
    .search-page__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2.5rem 1.5rem;
    }
  }

  @media screen and (min-width: 990px) {
    .search-page__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .search-page__label,
    .search-card__image--hover {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.search",
  "settings": [],
  "blocks": [
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
