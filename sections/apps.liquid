<div
  class="color-{{ section.settings.color_scheme }} apps-section{% if section.settings.page_width %} apps-section--page-width{% endif %}"
  style="--apps-padding-top: {{ section.settings.padding_top }}px; --apps-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  {%- for block in section.blocks -%}
    {% render block %}
  {%- endfor -%}
</div>

{% stylesheet %}
  .apps-section {
    padding-top: var(--apps-padding-top);
    padding-bottom: var(--apps-padding-bottom);
  }

  .apps-section--page-width {
    max-width: var(--page-width, 1200px);
    margin-inline: auto;
    padding-inline: var(--page-margin, 20px);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.apps.name",
  "tag": "section",
  "class": "section-apps",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "page_width",
      "label": "t:sections.apps.settings.page_width.label",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.apps.settings.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.apps.settings.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "t:sections.apps.name"
    }
  ]
}
{% endschema %}
