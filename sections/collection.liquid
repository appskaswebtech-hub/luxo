{%- liquid
  assign products_per_page = section.settings.products_per_page
  assign columns_desktop = section.settings.columns_desktop
  assign columns_mobile = section.settings.columns_mobile
  assign image_ratio = settings.card_image_ratio
  assign image_behavior = settings.card_image_behavior | default: 'slider'
  assign show_second_image = false
  if image_behavior == 'hover'
    assign show_second_image = true
  endif
  assign show_vendor = settings.card_show_vendor
  assign badge_position = 'collection-grid-' | append: section.id | append: '__badge--' | append: settings.card_badge_position
  assign quick_add = section.settings.quick_add
  assign show_filters = section.settings.show_filters
  assign filter_layout = section.settings.filter_layout
  assign show_sorting = section.settings.show_sorting
  assign show_banner = section.settings.show_banner
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign featured_product = section.settings.featured_product

  capture placeholder_class
    echo 'collection-grid-' | append: section.id | append: '__card-image collection-grid-' | append: section.id | append: '__card-placeholder'
  endcapture

  capture banner_placeholder_class
    echo 'collection-grid-' | append: section.id | append: '__banner-image collection-grid-' | append: section.id | append: '__banner-placeholder'
  endcapture

  capture form_class
    echo 'collection-grid-' | append: section.id | append: '__card-form'
  endcapture
-%}

<section 
  class="collection-grid-{{ section.id }}" 
  id="CollectionGrid-{{ section.id }}"
  style="
    --grid-bg: {{ section.settings.color_scheme.settings.background }};
    --grid-text: {{ section.settings.color_scheme.settings.text }};
    --grid-accent: {{ section.settings.color_scheme.settings.accent }};
    --grid-border: {{ section.settings.color_scheme.settings.border }};
    --grid-cols-desktop: {{ columns_desktop }};
    --grid-cols-mobile: {{ columns_mobile }};
    padding-top: {{ padding_top }}px;
    padding-bottom: {{ padding_bottom }}px;
  "
>
  <div class="collection-grid-{{ section.id }}__container {% if section.settings.container_width == 'full' %}collection-grid-{{ section.id }}__container--full{% else %}collection-grid-{{ section.id }}__container--page{% endif %}">
    
    {%- if show_banner -%}
      <div class="collection-grid-{{ section.id }}__banner">
        {%- if collection.image != blank -%}
          {%- capture img_alt -%}{{ collection.title }}{%- endcapture -%}{%- capture img_class -%}collection-grid-{{ section.id }}__banner-image{%- endcapture -%}{{ collection.image | image_url: width: 1800 | image_tag: widths: '100, 165, 220, 300, 400, 600, 800, 1000, 1200, 1500, 1800', sizes: '100vw', loading: 'eager', alt: img_alt, class: img_class }}
        {%- else -%}
          {{ 'collection-1' | placeholder_svg_tag: banner_placeholder_class }}
        {%- endif -%}
        <div class="collection-grid-{{ section.id }}__banner-overlay"></div>
        <div class="collection-grid-{{ section.id }}__banner-content">
          <h1 class="collection-grid-{{ section.id }}__banner-title">{{ collection.title | escape }}</h1>
          {%- if collection.description != blank -%}
            <div class="collection-grid-{{ section.id }}__banner-desc rte">{{ collection.description }}</div>
          {%- endif -%}
          <span class="collection-grid-{{ section.id }}__banner-count" data-facets-update="collection-count-{{ section.id }}">{{ 'collection_page.products_count' | t: count: collection.products_count }}</span>
        </div>
      </div>
    {%- endif -%}

    <div class="collection-grid-{{ section.id }}__layout-wrapper collection-grid-{{ section.id }}__layout--{{ filter_layout }}">
      
      {%- if show_filters -%}
        <div class="collection-grid-{{ section.id }}__sidebar-column">
          
          <div class="collection-grid-{{ section.id }}__filter-sidebar" id="FilterSidebar-{{ section.id }}">
            <div class="collection-grid-{{ section.id }}__filter-header">
              <h2 class="collection-grid-{{ section.id }}__filter-heading" id="FilterHeading-{{ section.id }}">{{ 'collection_page.filters' | t }}</h2>
              <button
                type="button"
                class="collection-grid-{{ section.id }}__filter-close"
                id="FilterClose-{{ section.id }}"
                aria-label="{{ 'general.accessibility.close' | t }}"
              >
                <span aria-hidden="true">✕</span>
              </button>
            </div>

            {%- liquid
              assign facets_form_id = 'CollectionFacets-' | append: section.id
              assign clear_url = collection.url
              if collection.sort_by != blank
                assign clear_url = collection.url | append: '?sort_by=' | append: collection.sort_by
              endif
            -%}
            {% render 'facets',
              filters: collection.filters,
              action: collection.url,
              form_id: facets_form_id,
              layout: 'sidebar',
              section_id: section.id,
              clear_url: clear_url
            %}
          </div>

          {%- if filter_layout == 'vertical' and featured_product != blank -%}
            <div class="collection-grid-{{ section.id }}__sidebar-featured">
              <h3 class="collection-grid-{{ section.id }}__featured-heading">{{ 'collection_page.featured' | t }}</h3>
              <a href="{{ featured_product.url }}" class="collection-grid-{{ section.id }}__featured-card">
                <div class="collection-grid-{{ section.id }}__featured-image-wrapper">
                  {%- if featured_product.featured_image != blank -%}
                    {%- capture img_alt -%}{{ featured_product.title }}{%- endcapture -%}{%- capture img_class -%}collection-grid-{{ section.id }}__featured-image{%- endcapture -%}{{ featured_product.featured_image | image_url: width: 400 | image_tag: widths: '100, 165, 220, 300, 400', sizes: '(min-width: 990px) 20vw, 50vw', loading: 'lazy', alt: img_alt, class: img_class }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: placeholder_class }}
                  {%- endif -%}
                  {%- if featured_product.compare_at_price_max > featured_product.price -%}
                    <span class="collection-grid-{{ section.id }}__featured-badge">{{ 'collection_page.sale' | t }}</span>
                  {%- endif -%}
                </div>
                <div class="collection-grid-{{ section.id }}__featured-content">
                  <h4 class="collection-grid-{{ section.id }}__featured-title">{{ featured_product.title | escape }}</h4>
                  <div class="collection-grid-{{ section.id }}__featured-price">
                    {% render 'price-tag', product: featured_product, from: true %}
                  </div>
                </div>
              </a>
            </div>
          {%- endif -%}

        </div>
      {%- endif -%}

      <div class="collection-grid-{{ section.id }}__products-column">
        
        {%- if show_filters or show_sorting -%}
          <div class="collection-grid-{{ section.id }}__toolbar">
            {%- if show_filters and filter_layout == 'horizontal' -%}
              <button type="button" class="collection-grid-{{ section.id }}__filter-toggle" id="FilterToggle-{{ section.id }}" aria-controls="FilterSidebar-{{ section.id }}" aria-expanded="false">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M7 12h10M10 18h4"/></svg>
                {{ 'collection_page.filter' | t }}
              </button>
            {%- elsif show_filters and filter_layout == 'vertical' -%}
              <button type="button" class="collection-grid-{{ section.id }}__filter-toggle collection-grid-{{ section.id }}__filter-toggle--mobile" id="FilterToggleMobile-{{ section.id }}" aria-controls="FilterSidebar-{{ section.id }}" aria-expanded="false">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M7 12h10M10 18h4"/></svg>
                {{ 'collection_page.filter' | t }}
              </button>
            {%- endif -%}

            {%- if show_sorting -%}
              {%- unless show_filters -%}
                <form action="{{ collection.url }}" method="get" class="collection-grid-{{ section.id }}__sort-form">
              {%- endunless -%}
              <div class="collection-grid-{{ section.id }}__sort-wrapper">
                <label for="SortBy-{{ section.id }}" class="collection-grid-{{ section.id }}__sort-label">{{ 'collection_page.sort_by' | t }}</label>
                <select
                  name="sort_by"
                  id="SortBy-{{ section.id }}"
                  class="collection-grid-{{ section.id }}__sort-select"
                  {% if show_filters %}
                    form="CollectionFacets-{{ section.id }}"
                  {% else %}
                    data-sort-only="{{ section.id }}"
                  {% endif %}
                >
                  {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
                  {%- for option in collection.sort_options -%}
                    <option value="{{ option.value | escape }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name | escape }}</option>
                  {%- endfor -%}
                </select>
              </div>
              {%- unless show_filters -%}
                  <noscript><button type="submit">{{ 'collection_page.apply' | t }}</button></noscript>
                </form>
              {%- endunless -%}
            {%- endif -%}
          </div>
        {%- endif -%}

        <div data-facets-update="collection-results-{{ section.id }}" data-facets-count="{{ 'collection_page.products_count' | t: count: collection.products_count }}">
        {%- paginate collection.products by products_per_page -%}
          {%- if collection.products.size > 0 -%}
            <div class="collection-grid-{{ section.id }}__grid">
              {%- for product in collection.products -%}
                {%- assign card_variant = product.selected_or_first_available_variant -%}
                <card-variants
                  class="collection-grid-{{ section.id }}__card"
                  data-selected="{{ card_variant.options | json | escape }}"
                >
                  
                  <div class="collection-grid-{{ section.id }}__card-top-bar">
                    <span class="collection-grid-{{ section.id }}__card-store">{{ shop.name }}</span>
                    <span class="collection-grid-{{ section.id }}__card-collection">{{ collection.title }}</span>
                  </div>

                  <div class="collection-grid-{{ section.id }}__card-image-wrapper">
                    {%- if image_behavior == 'slider' and product.images.size > 1 -%}
                      {%- capture slider_class -%}collection-grid-{{ section.id }}__card-image collection-grid-{{ section.id }}__card-image-ratio--{{ image_ratio }}{%- endcapture -%}
                      <div class="collection-grid-{{ section.id }}__card-image-link">
                        {% render 'card-image-slider', product: product, url: product.url, image_class: slider_class %}
                      </div>
                    {%- else -%}
                    <a href="{{ product.url }}" class="collection-grid-{{ section.id }}__card-image-link">
                      {%- if product.featured_image != blank -%}
                        {%- capture img_alt -%}{{ product.featured_image.alt }}{%- endcapture -%}{%- capture img_class -%}collection-grid-{{ section.id }}__card-image collection-grid-{{ section.id }}__card-image-ratio--{{ image_ratio }}{%- endcapture -%}{{ product.featured_image | image_url: width: 600 | image_tag: widths: '100, 165, 220, 300, 400, 600', sizes: '(min-width: 990px) 25vw, 50vw', loading: 'lazy', alt: img_alt, class: img_class }}
                      {%- else -%}
                        {{ 'product-1' | placeholder_svg_tag: placeholder_class }}
                      {%- endif -%}
                      
                      {%- if show_second_image and product.images[1] != blank -%}
                        {%- capture img_alt -%}{{ product.images[1].alt }}{%- endcapture -%}{%- capture img_class -%}collection-grid-{{ section.id }}__card-image collection-grid-{{ section.id }}__card-image--secondary{%- endcapture -%}{{ product.images[1] | image_url: width: 600 | image_tag: widths: '100, 165, 220, 300, 400, 600', sizes: '(min-width: 990px) 25vw, 50vw', loading: 'lazy', alt: img_alt, class: img_class }}
                      {%- endif -%}
                    </a>
                    {%- endif -%}

                    <span class="collection-grid-{{ section.id }}__corner collection-grid-{{ section.id }}__corner--tl"></span>
                    <span class="collection-grid-{{ section.id }}__corner collection-grid-{{ section.id }}__corner--tr"></span>
                    <span class="collection-grid-{{ section.id }}__corner collection-grid-{{ section.id }}__corner--bl"></span>
                    <span class="collection-grid-{{ section.id }}__corner collection-grid-{{ section.id }}__corner--br"></span>

                    {%- if product.available == false -%}
                      {%- if settings.card_sold_out_badge -%}
                        <span class="collection-grid-{{ section.id }}__badge collection-grid-{{ section.id }}__badge--soldout {{ badge_position }}">{{ 'products.buy.sold_out' | t }}</span>
                      {%- endif -%}
                    {%- elsif product.compare_at_price > product.price -%}
                      {%- if settings.card_sale_badge -%}
                        {%- liquid
                          case settings.card_sale_badge_format
                            when 'percent'
                              assign discount = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price
                              assign sale_label = 'products.badge.sale_percent' | t: percent: discount
                            when 'amount'
                              assign saved_amount = product.compare_at_price | minus: product.price
                              capture saved
                                render 'price', amount: saved_amount
                              endcapture
                              assign sale_label = 'products.badge.sale_amount' | t: amount: saved
                            else
                              assign sale_label = 'products.badge.sale' | t
                          endcase
                        -%}
                        <span class="collection-grid-{{ section.id }}__badge collection-grid-{{ section.id }}__badge--sale {{ badge_position }}">{{ sale_label }}</span>
                      {%- endif -%}
                    {%- endif -%}
                  </div>

                  <div class="collection-grid-{{ section.id }}__card-content">
                    {%- if show_vendor and product.vendor != blank -%}
                      <span class="collection-grid-{{ section.id }}__card-vendor">{{ product.vendor | escape }}</span>
                    {%- endif -%}

                    <h3 class="collection-grid-{{ section.id }}__card-title">
                      <a href="{{ product.url }}">{{ product.title | escape }}<span>.</span></a>
                    </h3>

                    <p class="collection-grid-{{ section.id }}__card-description">
                      {%- if product.description != blank -%}
                        {{ product.description | strip_html | truncate: 60 }}
                      {%- else -%}
                        {{ 'products.description_fallback' | t }}
                      {%- endif -%}
                    </p>

                    {% render 'card-variant-options', product: product, variant: card_variant %}
                  </div>

                  <div class="collection-grid-{{ section.id }}__card-bottom">
                    <span class="collection-grid-{{ section.id }}__price" data-card-price>
                      {% render 'price-tag', product: product, variant: card_variant, from: true %}
                    </span>

                    {%- if quick_add != 'none' -%}
                      {%- form 'product', product, class: form_class -%}
                        <input type="hidden" name="id" value="{{ card_variant.id }}" data-card-variant-id>
                        <button type="submit" name="add" class="collection-grid-{{ section.id }}__card-button"{% unless card_variant.available %} disabled{% endunless %}>
                          <span
                            data-card-button-label
                            data-label-add="{{ 'products.buy.add_to_cart' | t }}"
                            data-label-sold-out="{{ 'products.buy.sold_out' | t }}"
                            data-label-unavailable="{{ 'products.variant.unavailable' | t }}"
                          >
                            {%- if card_variant.available -%}
                              {{ 'products.buy.add_to_cart' | t }}
                            {%- else -%}
                              {{ 'products.buy.sold_out' | t }}
                            {%- endif -%}
                          </span>
                          <svg width="12" height="5" viewBox="0 0 13 5" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9.45052 4.21172C9.63052 3.82772 9.80452 3.49172 9.97252 3.20372C10.1525 2.91572 10.3265 2.67572 10.4945 2.48372H0.000515878V1.72772H10.4945C10.3265 1.52372 10.1525 1.27772 9.97252 0.989718C9.80452 0.701718 9.63052 0.371718 9.45052 -0.000281632H10.0805C10.8365 0.875719 11.6285 1.52372 12.4565 1.94372V2.26772C11.6285 2.67572 10.8365 3.32372 10.0805 4.21172H9.45052Z" fill="currentColor"></path></svg>
                        </button>
                      {%- endform -%}
                    {%- endif -%}
                  </div>
                </card-variants>
              {%- endfor -%}
            </div>
            <script src="{{ 'card-variants.js' | asset_url }}" defer></script>

            {%- if paginate.pages > 1 -%}
              <div class="collection-grid-{{ section.id }}__pagination">
                {{ paginate | default_pagination }}
              </div>
            {%- endif -%}
          {%- else -%}
            <div class="collection-grid-{{ section.id }}__empty">
              <p>{{ 'collection_page.empty' | t }}</p>
              <a href="{{ collection.url }}" class="collection-grid-{{ section.id }}__empty-btn">{{ 'collection_page.clear_filters' | t }}</a>
            </div>
          {%- endif -%}
        {%- endpaginate -%}
        </div>
      </div>
    </div>

  </div>
</section>

{%- if section.blocks.size > 0 -%}
  <div class="app-blocks">
    {%- for block in section.blocks -%}
      {%- if block.type == '@app' -%}
        {% render block %}
      {%- endif -%}
    {%- endfor -%}
  </div>
{%- endif -%}

{% style %}
  .collection-grid-{{ section.id }} {
    width: 100vw;
    max-width: 100vw;
    margin-left: -50vw;
    margin-right: -50vw;
    left: 50%;
    right: 50%;
    position: relative;
    background-color: var(--grid-bg);
    color: var(--grid-text);
    font-family: var(--font-body-family), -apple-system, sans-serif;
    overflow: hidden;
  }

  .collection-grid-{{ section.id }} * {
    box-sizing: border-box;
  }

  .collection-grid-{{ section.id }}__container {
    margin: 0 auto;
    width: 100%;
  }

  .collection-grid-{{ section.id }}__container--full {
    max-width: 100%;
    padding: 0 2%;
  }

  .collection-grid-{{ section.id }}__container--page {
    max-width: var(--page-width, 1400px);
    padding: 0 var(--page-margin, 20px);
  }

  .collection-grid-{{ section.id }}__banner {
    position: relative;
    width: 100%;
    height: 40vh;
    min-height: 300px;
    max-height: 450px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 40px;
  }

  .collection-grid-{{ section.id }}__banner-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .collection-grid-{{ section.id }}__banner-placeholder {
    background-color: #E8E2D9;
  }

  .collection-grid-{{ section.id }}__banner-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(43, 30, 22, 0.3), rgba(43, 30, 22, 0.7));
  }

  .collection-grid-{{ section.id }}__banner-content {
    position: relative;
    z-index: 2;
    text-align: center;
    color: #fff;
    padding: 20px;
  }

  .collection-grid-{{ section.id }}__banner-title {
    font-family: var(--font-heading-family), serif;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    text-transform: uppercase;
    margin: 0 0 15px;
    letter-spacing: 2px;
  }

  .collection-grid-{{ section.id }}__banner-desc {
    font-size: 1rem;
    max-width: 600px;
    margin: 0 auto 20px;
    opacity: 0.9;
  }

  .collection-grid-{{ section.id }}__banner-count {
    display: inline-block;
    padding: 6px 16px;
    background: var(--grid-accent);
    color: #fff;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    border-radius: 50px;
  }

  .collection-grid-{{ section.id }}__layout-wrapper {
    display: flex;
    gap: 40px;
    align-items: flex-start;
  }

  .collection-grid-{{ section.id }}__layout--vertical .collection-grid-{{ section.id }}__products-column {
    flex: 1;
    min-width: 0;
  }

  .collection-grid-{{ section.id }}__layout--vertical .collection-grid-{{ section.id }}__sidebar-column {
    width: 280px;
    flex-shrink: 0;
  }

  .collection-grid-{{ section.id }}__layout--horizontal {
    flex-direction: column;
    gap: 20px;
  }

  .collection-grid-{{ section.id }}__layout--horizontal .collection-grid-{{ section.id }}__products-column {
    width: 100%;
  }

  .collection-grid-{{ section.id }}__layout--horizontal .collection-grid-{{ section.id }}__sidebar-column {
    width: 100%;
  }

  .collection-grid-{{ section.id }}__sidebar-column {
    display: flex;
    flex-direction: column;
    gap: 30px;
  }

  .collection-grid-{{ section.id }}__filter-sidebar {
    width: 100%;
  }

  .collection-grid-{{ section.id }}__layout--horizontal .collection-grid-{{ section.id }}__filter-sidebar {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 320px;
    height: 100vh;
    background: var(--grid-bg);
    z-index: 9999;
    padding: 25px;
    box-shadow: 4px 0 20px rgba(0,0,0,0.1);
    transform: translateX(-100%);
    transition: transform 0.3s ease;
    overflow-y: auto;
  }

  .collection-grid-{{ section.id }}__layout--horizontal .collection-grid-{{ section.id }}__filter-sidebar.is-open {
    display: block;
    transform: translateX(0);
  }

  .collection-grid-{{ section.id }}__filter-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
  }

  .collection-grid-{{ section.id }}__filter-heading {
    font-family: var(--font-heading-family), serif;
    font-size: 1.5rem;
    margin: 0;
    text-transform: uppercase;
  }

  .collection-grid-{{ section.id }}__filter-close {
    background: transparent;
    border: none;
    font-size: 1.5rem;
    cursor: pointer;
    color: var(--grid-text);
    display: none;
  }

  .collection-grid-{{ section.id }}__layout--horizontal .collection-grid-{{ section.id }}__filter-close {
    display: block;
  }

  .collection-grid-{{ section.id }}__filter-sidebar .facets input[type='checkbox'] {
    width: 18px;
    height: 18px;
    accent-color: var(--grid-accent);
  }

  .collection-grid-{{ section.id }}__sidebar-featured {
    display: none;
  }

  .collection-grid-{{ section.id }}__layout--vertical .collection-grid-{{ section.id }}__sidebar-featured {
    display: block;
  }

  .collection-grid-{{ section.id }}__featured-heading {
    font-family: var(--font-heading-family), serif;
    font-size: 1.2rem;
    text-transform: uppercase;
    margin: 0 0 15px;
    padding-bottom: 10px;
    border-bottom: 2px solid var(--grid-text);
    color: var(--grid-text);
  }

  .collection-grid-{{ section.id }}__featured-card {
    display: block;
    text-decoration: none;
    border: 1px solid var(--grid-border);
    background: #fff;
    transition: transform 0.3s ease;
  }

  .collection-grid-{{ section.id }}__featured-card:hover {
    transform: translateY(-3px);
  }

  .collection-grid-{{ section.id }}__featured-image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 1/1;
    overflow: hidden;
  }

  .collection-grid-{{ section.id }}__featured-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .collection-grid-{{ section.id }}__featured-badge {
    position: absolute;
    top: 10px;
    left: 10px;
    background: var(--grid-accent);
    color: #fff;
    padding: 4px 10px;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .collection-grid-{{ section.id }}__featured-content {
    padding: 15px;
  }

  .collection-grid-{{ section.id }}__featured-title {
    font-family: var(--font-heading-family), serif;
    font-size: 1rem;
    text-transform: uppercase;
    margin: 0 0 8px;
    color: var(--grid-text);
  }

  .collection-grid-{{ section.id }}__featured-price {
    display: flex;
    gap: 8px;
    align-items: center;
    font-weight: 700;
  }

  .collection-grid-{{ section.id }}__price-current {
    color: var(--grid-text);
    font-size: 1rem;
  }

  .collection-grid-{{ section.id }}__price-compare {
    color: var(--grid-text);
