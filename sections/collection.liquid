<script>
  (function () {
    const sectionId = '{{ section.id }}';
    const filterSidebar = document.getElementById('FilterSidebar-' + sectionId);
    const filterToggle = document.getElementById('FilterToggle-' + sectionId);
    const filterToggleMobile = document.getElementById('FilterToggleMobile-' + sectionId);
    const filterClose = document.getElementById('FilterClose-' + sectionId);
    const toggles = [filterToggle, filterToggleMobile].filter(Boolean);
    let lastToggle = null;

    const focusable = () =>
      [...filterSidebar.querySelectorAll('a[href], button:not([disabled]), input:not([disabled]), select, summary')].filter(
        (element) => element.offsetParent !== null
      );

    /* While the panel is open, Tab stays inside it and Escape closes it */
    const onKeydown = (event) => {
      if (event.key === 'Escape') {
        closeFilter();
        return;
      }
      if (event.key !== 'Tab') return;
      const items = focusable();
      if (!items.length) return;
      const first = items[0];
      const last = items[items.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    };

    const openFilter = (event) => {
      if (!filterSidebar) return;
      lastToggle = event.currentTarget;
      filterSidebar.classList.add('is-open');
      toggles.forEach((toggle) => toggle.setAttribute('aria-expanded', 'true'));
      document.addEventListener('keydown', onKeydown);
      filterClose?.focus();
    };

    const closeFilter = () => {
      if (!filterSidebar?.classList.contains('is-open')) return;
      filterSidebar.classList.remove('is-open');
      toggles.forEach((toggle) => toggle.setAttribute('aria-expanded', 'false'));
      document.removeEventListener('keydown', onKeydown);
      lastToggle?.focus();
    };

    toggles.forEach((toggle) => toggle.addEventListener('click', openFilter));
    filterClose?.addEventListener('click', closeFilter);

    /* Sorting without the filter form: reload with the chosen order */
    const sortOnly = document.querySelector('[data-sort-only="' + sectionId + '"]');
    sortOnly?.addEventListener('change', () => sortOnly.form?.requestSubmit());
  })();
</script>

