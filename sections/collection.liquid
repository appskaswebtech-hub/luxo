<script>
  (function () {
    const sectionId = '{{ section.id }}';
    const filterSidebar = document.getElementById('FilterSidebar-' + sectionId);
    const filterToggle = document.getElementById('FilterToggle-' + sectionId);
    const filterToggleMobile = document.getElementById('FilterToggleMobile-' + sectionId);
    const filterClose = document.getElementById('FilterClose-' + sectionId);
    const filterApply = document.getElementById('FilterApply-' + sectionId);
    const sortBySelect = document.getElementById('SortBy-' + sectionId);
    const filterForm = document.getElementById('CollectionGridForm-' + sectionId);

    const openFilter = () => {
      if (filterSidebar) filterSidebar.classList.add('is-open');
    };

    const closeFilter = () => {
      if (filterSidebar) filterSidebar.classList.remove('is-open');
    };

    if (filterToggle) {
      filterToggle.addEventListener('click', openFilter);
    }

    if (filterToggleMobile) {
      filterToggleMobile.addEventListener('click', openFilter);
    }

    if (filterClose) {
      filterClose.addEventListener('click', closeFilter);
    }

    function applyFilters() {
      if (!filterForm) return;
      const formData = new FormData(filterForm);
      const params = new URLSearchParams(formData);
      
      if (sortBySelect) {
        params.set('sort_by', sortBySelect.value);
      }

      const newUrl = window.location.pathname + '?' + params.toString();
      window.location.href = newUrl;
    }

    if (filterApply) {
      filterApply.addEventListener('click', applyFilters);
    }

    if (sortBySelect) {
      sortBySelect.addEventListener('change', applyFilters);
    }
  })();
</script>

