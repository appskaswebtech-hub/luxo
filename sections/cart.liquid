{%- liquid
  assign use_custom = section.settings.enable_custom_design

  if use_custom
    assign cart_bg = section.settings.custom_bg_color
    assign cart_text = section.settings.custom_text_color
    assign cart_accent = section.settings.custom_accent_color
    assign cart_border = section.settings.custom_border_color
    assign heading_font = section.settings.custom_heading_font
    assign body_font = section.settings.custom_body_font
  else
    assign cart_bg = section.settings.color_scheme.settings.background
    assign cart_text = section.settings.color_scheme.settings.text
    assign cart_accent = section.settings.color_scheme.settings.accent
    assign cart_border = section.settings.color_scheme.settings.border
    assign heading_font = 'var(--font-heading-family)'
    assign body_font = 'var(--font-body-family)'
  endif

  assign form_id = 'CartForm-' | append: section.id

  assign layout_class = ''
  if settings.cart_layout == 'cart-page--split'
    assign layout_class = ' cart-page-' | append: section.id | append: '--split'
    if settings.cart_sticky_summary
      assign layout_class = layout_class | append: ' cart-page-' | append: section.id | append: '--sticky'
    endif
  endif
-%}

<cart-items
  class="cart-page-{{ section.id }}{{ layout_class }}"
  id="CartPage-{{ section.id }}"
  data-section="{{ section.id }}"
  data-cart-total-value="{% render 'price', amount: cart.total_price %}"
  data-cart-count-value="{{ cart.item_count }}"
  data-quantity-error="{{ 'cart.errors.quantity_limit' | t: quantity: '[quantity]' }}"
  {% if cart.empty? %}data-empty{% endif %}
  style="
    --cart-bg: {{ cart_bg }};
    --cart-text: {{ cart_text }};
    --cart-accent: {{ cart_accent }};
    --cart-border: {{ cart_border }};
    --cart-heading-font: {{ heading_font }};
    --cart-body-font: {{ body_font }};
    --cart-image-width: {{ settings.cart_image_width }}px;
    --cart-image-radius: {{ settings.cart_image_radius }}px;
    --cart-image-border-width: {% if settings.cart_image_border %}1px{% else %}0px{% endif %};
  "
>
  {%- if cart.empty? -%}
    <div class="cart-page-{{ section.id }}__empty">
      <h1 class="cart-page-{{ section.id }}__title">{{ 'cart.empty.title' | t }}</h1>
      <a href="{{ routes.all_products_collection_url }}" class="cart-page-{{ section.id }}__empty-link">
        {{- 'cart.continue_shopping' | t -}}
      </a>

      {%- if shop.customer_accounts_enabled and customer == nil -%}
        <p class="cart-page-{{ section.id }}__login">
          {{ 'cart.empty.login_html' | t: link: routes.account_login_url }}
        </p>
      {%- endif -%}
    </div>
  {%- else -%}
    <div class="cart-page-{{ section.id }}__header">
      <h1 class="cart-page-{{ section.id }}__title">{{ 'cart.title' | t }}<span class="cart-page-{{ section.id }}__count" data-cart-region="count">({{ cart.item_count }})</span></h1>
      <a href="{{ routes.all_products_collection_url }}" class="cart-page-{{ section.id }}__continue">
        {{- 'cart.continue_shopping' | t -}}
      </a>
    </div>

    <div class="cart-page-{{ section.id }}__body">
      <form action="{{ routes.cart_url }}" method="post" id="{{ form_id }}" class="cart-page-{{ section.id }}__form" novalidate>
        <div class="cart-page-{{ section.id }}__columns" aria-hidden="true">
          <span>{{ 'cart.columns.product' | t }}</span>
          <span>{{ 'cart.columns.quantity' | t }}</span>
          <span>{{ 'cart.columns.total' | t }}</span>
        </div>

        <ul class="cart-page-{{ section.id }}__items" role="list" data-cart-region="items">
          {%- for item in cart.items -%}
            {% render 'cart-line-item', item: item, index: forloop.index, section_id: section.id %}
          {%- endfor -%}
        </ul>

        <noscript>
          <button type="submit" name="update" class="cart-page-{{ section.id }}__update">{{ 'cart.update' | t }}</button>
        </noscript>
      </form>

      <div class="cart-page-{{ section.id }}__footer">
        {% render 'cart-summary', form_id: form_id, show_express: true, card: settings.cart_summary_card %}
      </div>
    </div>
  {%- endif -%}
</cart-items>

{%- if section.blocks.size > 0 -%}
  <div class="app-blocks">
    {%- for block in section.blocks -%}
      {%- if block.type == '@app' -%}
        {% render block %}
      {%- endif -%}
    {%- endfor -%}
  </div>
{%- endif -%}

{% style %}
  .cart-page-{{ section.id }} {
    display: block;
    width: 100vw;
    max-width: 100vw;
    margin-left: -50vw;
    margin-right: -50vw;
    left: 50%;
    right: 50%;
    position: relative;
    background-color: var(--cart-bg);
    color: var(--cart-text);
    font-family: var(--cart-body-font), -apple-system, sans-serif;
    padding: 60px 0 100px;
    box-sizing: border-box;
    overflow: hidden;
  }

  .cart-page-{{ section.id }}__header {
    max-width: var(--page-width, 1200px);
    margin: 0 auto 40px;
    padding: 0 var(--page-margin, 20px);
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 15px;
    border-bottom: 1px solid var(--cart-border);
    padding-bottom: 20px;
  }

  .cart-page-{{ section.id }}__title {
    font-family: var(--cart-heading-font), serif;
    font-size: clamp(28px, 4vw, 42px);
    text-transform: uppercase;
    margin: 0;
    line-height: 1.1;
  }

  .cart-page-{{ section.id }}__continue {
    color: var(--cart-text);
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    text-decoration: underline;
    opacity: 0.7;
    transition: opacity 0.3s ease;
  }

  .cart-page-{{ section.id }}__continue:hover {
    opacity: 1;
    color: var(--cart-accent);
  }

  .cart-page-{{ section.id }}__body {
    max-width: var(--page-width, 1200px);
    margin: 0 auto;
    padding: 0 var(--page-margin, 20px);
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
  }

  @media (min-width: 990px) {
    .cart-page-{{ section.id }}--split .cart-page-{{ section.id }}__body {
      grid-template-columns: 2fr 1fr;
      align-items: start;
    }
    .cart-page-{{ section.id }}--sticky .cart-page-{{ section.id }}__footer {
      position: sticky;
      top: 40px;
    }
  }

  .cart-page-{{ section.id }}__columns {
    display: none;
    grid-template-columns: 3fr 1fr 1fr;
    gap: 20px;
    padding: 10px 0;
    border-bottom: 1px solid var(--cart-border);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 700;
    opacity: 0.5;
  }

  @media (min-width: 768px) {
    .cart-page-{{ section.id }}__columns {
      display: grid;
    }
  }

  .cart-page-{{ section.id }}__items {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .cart-page-{{ section.id }}__form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .cart-page-{{ section.id }}__update {
    align-self: flex-start;
    padding: 10px 20px;
    background: transparent;
    border: 1px solid var(--cart-border);
    color: var(--cart-text);
    text-transform: uppercase;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .cart-page-{{ section.id }}__update:hover {
    background: var(--cart-text);
    color: var(--cart-bg);
  }

  .cart-page-{{ section.id }}__footer {
    width: 100%;
  }

  .cart-page-{{ section.id }}__empty {
    text-align: center;
    max-width: 600px;
    margin: 80px auto;
    padding: 0 20px;
  }

  .cart-page-{{ section.id }}__empty-link {
    display: inline-block;
    margin-top: 20px;
    padding: 14px 30px;
    background: var(--cart-accent);
    color: #fff;
    text-decoration: none;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 13px;
    letter-spacing: 1px;
    border-radius: 4px;
    transition: opacity 0.3s ease;
  }

  .cart-page-{{ section.id }}__empty-link:hover {
    opacity: 0.9;
  }

  .cart-page-{{ section.id }}__login {
    margin-top: 20px;
    font-size: 14px;
    opacity: 0.7;
  }

  .cart-page-{{ section.id }}__login a {
    color: var(--cart-accent);
    font-weight: 600;
  }

  .cart-page-{{ section.id }} .cart-item {
    padding: 24px 0;
    border-bottom: 1px solid var(--cart-border);
    align-items: center;
  }

  .cart-page-{{ section.id }} .cart-item__media {
    background: color-mix(in srgb, var(--cart-text) 4%, var(--cart-bg));
    transition: opacity 0.2s ease;
  }

  .cart-page-{{ section.id }} .cart-item__media:hover {
    opacity: 0.88;
  }

  .cart-page-{{ section.id }} .cart-item__title {
    font-family: var(--cart-heading-font), serif;
    font-size: 17px;
    line-height: 1.35;
    color: var(--cart-text);
  }

  .cart-page-{{ section.id }} .cart-item__price,
  .cart-page-{{ section.id }} .cart-item__options,
  .cart-page-{{ section.id }} .cart-item__meta {
    font-size: 14px;
  }

  .cart-page-{{ section.id }} .cart-item__options dt {
    opacity: 0.75;
  }

  .cart-page-{{ section.id }} .quantity {
    height: 44px;
    border-color: var(--cart-border);
    border-radius: 999px;
    background: var(--cart-bg);
  }

  .cart-page-{{ section.id }} .quantity__button {
    width: 40px;
    border-radius: 999px;
    transition: background 0.2s ease;
  }

  .cart-page-{{ section.id }} .quantity__button:hover:not(:disabled) {
    background: color-mix(in srgb, var(--cart-text) 6%, transparent);
  }

  .cart-page-{{ section.id }} .cart-item__remove {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    opacity: 0.6;
    transition: opacity 0.2s ease, background 0.2s ease, color 0.2s ease;
  }

  .cart-page-{{ section.id }} .cart-item__remove:hover,
  .cart-page-{{ section.id }} .cart-item__remove:focus-visible {
    opacity: 1;
    background: color-mix(in srgb, var(--cart-accent) 10%, transparent);
    color: var(--cart-accent);
  }

  .cart-page-{{ section.id }} .cart-item__total {
    font-size: 16px;
    font-weight: 600;
  }

  .cart-page-{{ section.id }} .cart-summary__checkout {
    border-color: var(--cart-text);
    background: var(--cart-text);
    color: var(--cart-bg);
  }

  .cart-page-{{ section.id }} .cart-summary__checkout:hover {
    border-color: var(--cart-accent);
    background: var(--cart-accent);
    opacity: 1;
  }

  .cart-page-{{ section.id }}__columns {
    border-bottom-color: var(--cart-accent);
    color: var(--cart-text);
  }

  .cart-page-{{ section.id }}__count {
    margin-left: 8px;
    font-family: var(--cart-body-font), sans-serif;
    font-size: 0.45em;
    font-weight: 500;
    vertical-align: middle;
    opacity: 0.6;
  }
{% endstyle %}

{% schema %}
{
  "name": "t:sections.cart.name",
  "tag": "section",
  "class": "section-cart-page",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.cart.headers.default_colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.cart.headers.custom_design_override"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_design",
      "label": "t:sections.cart.settings.enable_custom_design.label",
      "info": "t:sections.cart.settings.enable_custom_design.info",
      "default": false
    },
    {
      "type": "color",
      "id": "custom_bg_color",
      "label": "t:sections.cart.settings.custom_bg_color.label",
      "default": "#FFFFFF",
      "visible_if": "{{ section.settings.enable_custom_design }}"
    },
    {
      "type": "color",
      "id": "custom_text_color",
      "label": "t:sections.cart.settings.custom_text_color.label",
      "default": "#111111",
      "visible_if": "{{ section.settings.enable_custom_design }}"
    },
    {
      "type": "color",
      "id": "custom_accent_color",
      "label": "t:sections.cart.settings.custom_accent_color.label",
      "default": "#000000",
      "visible_if": "{{ section.settings.enable_custom_design }}"
    },
    {
      "type": "color",
      "id": "custom_border_color",
      "label": "t:sections.cart.settings.custom_border_color.label",
      "default": "#E0E0E0",
      "visible_if": "{{ section.settings.enable_custom_design }}"
    },
    {
      "type": "font_picker",
      "id": "custom_heading_font",
      "label": "t:sections.cart.settings.custom_heading_font.label",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_design }}"
    },
    {
      "type": "font_picker",
      "id": "custom_body_font",
      "label": "t:sections.cart.settings.custom_body_font.label",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_design }}"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ]
}
{% endschema %}