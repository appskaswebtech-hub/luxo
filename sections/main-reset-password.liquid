{{ 'customer.css' | asset_url | stylesheet_tag }}

<div class="customer">
  <h1 class="customer__title">{{ 'customer.reset.title' | t }}</h1>
  <p>{{ 'customer.reset.description' | t }}</p>

  {%- form 'reset_customer_password' -%}
    {% render 'customer-errors', errors: form.errors %}

    <div class="customer__field">
      <label for="ResetPassword">{{ 'customer.fields.password' | t }}</label>
      <input type="password" id="ResetPassword" name="customer[password]" autocomplete="new-password" required>
    </div>

    <div class="customer__field">
      <label for="ResetPasswordConfirm">{{ 'customer.fields.password_confirm' | t }}</label>
      <input type="password" id="ResetPasswordConfirm" name="customer[password_confirmation]" autocomplete="new-password" required>
    </div>

    <button type="submit" class="customer__button">{{ 'customer.reset.submit' | t }}</button>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "t:sections.customer.reset",
  "settings": []
}
{% endschema %}
