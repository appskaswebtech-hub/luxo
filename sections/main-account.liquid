{{ 'customer.css' | asset_url | stylesheet_tag }}

<div class="customer customer--wide">
  <h1 class="customer__title">{{ 'customer.account.title' | t }}</h1>

  <div class="customer__links">
    <p>{{ 'customer.account.welcome' | t: name: customer.first_name }}</p>
    <a href="{{ routes.account_logout_url }}">{{ 'customer.account.log_out' | t }}</a>
  </div>

  <div class="customer__grid">
    <div>
      <h2 class="customer__subtitle">{{ 'customer.account.orders' | t }}</h2>

      {%- paginate customer.orders by 20 -%}
        {%- if customer.orders.size > 0 -%}
          <table class="customer__table">
            <thead>
              <tr>
                <th scope="col">{{ 'customer.orders.order' | t }}</th>
                <th scope="col">{{ 'customer.orders.date' | t }}</th>
                <th scope="col">{{ 'customer.orders.payment' | t }}</th>
                <th scope="col">{{ 'customer.orders.fulfillment' | t }}</th>
                <th scope="col">{{ 'customer.orders.total' | t }}</th>
              </tr>
            </thead>
            <tbody>
              {%- for order in customer.orders -%}
                <tr>
                  <td data-label="{{ 'customer.orders.order' | t }}">
                    <a href="{{ order.customer_url }}" aria-label="{{ 'customer.orders.view' | t: name: order.name }}">{{ order.name }}</a>
                  </td>
                  <td data-label="{{ 'customer.orders.date' | t }}">{{ order.created_at | time_tag: format: 'date' }}</td>
                  <td data-label="{{ 'customer.orders.payment' | t }}">{{ order.financial_status_label }}</td>
                  <td data-label="{{ 'customer.orders.fulfillment' | t }}">{{ order.fulfillment_status_label }}</td>
                  <td data-label="{{ 'customer.orders.total' | t }}">{{ order.total_net_amount | money_with_currency }}</td>
                </tr>
              {%- endfor -%}
            </tbody>
          </table>

          {%- if paginate.pages > 1 -%}
            <nav aria-label="{{ 'customer.orders.pagination' | t }}">{{ paginate | default_pagination }}</nav>
          {%- endif -%}
        {%- else -%}
          <p>{{ 'customer.orders.none' | t }}</p>
        {%- endif -%}
      {%- endpaginate -%}
    </div>

    <div>
      <h2 class="customer__subtitle">{{ 'customer.account.details' | t }}</h2>
      {%- if customer.default_address -%}
        <address>{{ customer.default_address | format_address }}</address>
      {%- endif -%}
      <p>
        <a href="{{ routes.account_addresses_url }}">
          {{ 'customer.account.view_addresses' | t: count: customer.addresses_count }}
        </a>
      </p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.customer.account",
  "settings": []
}
{% endschema %}
