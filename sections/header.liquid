{{ 'header.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign design = section.settings.header_style
  assign sticky = section.settings.enable_sticky
  assign hide_scroll = section.settings.hide_on_scroll
  assign use_custom = section.settings.enable_custom_design
-%}

<div class="header-wrapper header-wrapper--{{ design }}{% if sticky %} header-wrapper--sticky{% endif %}{% if hide_scroll %} header-wrapper--hide-scroll{% endif %}{% if use_custom %} header-wrapper--custom{% endif %}"
     id="HeaderMain"
     data-header-main
     style="{% if use_custom %}
       --header-bg: {{ section.settings.custom_bg }};
       --header-bg-2: {{ section.settings.custom_bg_2 }};
       --header-text: {{ section.settings.custom_text }};
       --header-accent: {{ section.settings.custom_accent }};
       --header-accent-2: {{ section.settings.custom_accent_2 }};
       --header-border-color: {{ section.settings.custom_border }};
       --header-font-size: {{ section.settings.custom_font_size }}px;
       --header-nav-font-size: {{ section.settings.custom_nav_font_size }}px;
       --header-padding-top: {{ section.settings.custom_padding_top }}px;
       --header-padding-bottom: {{ section.settings.custom_padding_bottom }}px;
       --header-radius: {{ section.settings.custom_radius }}px;
     {% endif %}">

  <div class="header-topbar">
    <div class="header-container">
      <div class="header-topbar__grid">
        
        <ul class="header-topbar__links">
          {%- if section.settings.topbar_menu != blank -%}
            {%- for link in linklists[section.settings.topbar_menu].links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          {%- endif -%}
        </ul>

        {%- if section.settings.phone != blank -%}
          <div class="header-topbar__phone">
            <span class="header-pulse-dot"></span>
            Call Us:
            <a href="tel:{{ section.settings.phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' }}">
              {{- section.settings.phone -}}
            </a>
          </div>
        {%- endif -%}

        <ul class="header-topbar__account">
          <li class="header-has-drop">
            <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}">
              {%- if customer -%}My Account{%- else -%}Login{%- endif -%}
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M6 9l6 6 6-6"/></svg>
            </a>
            <ul class="header-drop">
              {%- if customer -%}
                <li><a href="{{ routes.account_url }}">My Account</a></li>
                <li><a href="{{ routes.account_addresses_url }}">Addresses</a></li>
                <li><a href="{{ routes.account_logout_url }}">Logout</a></li>
              {%- else -%}
                <li><a href="{{ routes.account_login_url }}">Login</a></li>
                <li><a href="{{ routes.account_register_url }}">Register</a></li>
              {%- endif -%}
              <li><a href="{{ routes.cart_url }}">My Cart</a></li>
            </ul>
          </li>

          {%- if section.settings.show_currency and localization.available_countries.size > 1 -%}
            <li class="header-has-drop">
              <a href="#">
                {{ localization.country.currency.iso_code }}
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M6 9l6 6 6-6"/></svg>
              </a>
              <ul class="header-drop">
                {%- for country in localization.available_countries -%}
                  <li>
                    {%- form 'localization', id: 'HeaderCurrencyForm' -%}
                      <input type="hidden" name="country_code" value="{{ country.iso_code }}">
                      <button type="submit" class="header-drop__currency-btn {% if country.iso_code == localization.country.iso_code %}is-active{% endif %}">
                        {{ country.name }} ({{ country.currency.iso_code }})
                      </button>
                    {%- endform -%}
                  </li>
                {%- endfor -%}
              </ul>
            </li>
          {%- endif -%}
        </ul>

      </div>
    </div>
  </div>

  <div class="header-mainbar">
    <div class="header-container">
      <div class="header-mainbar__grid">
        
        <button class="header-burger" id="HeaderBurger" aria-label="Open menu" aria-controls="HeaderMobile" aria-expanded="false">
          <span></span><span></span><span></span>
        </button>

        <div class="header-logo">
          <a href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
            {%- if section.settings.logo != blank -%}
              <img src="{{ section.settings.logo | image_url: width: 220 }}"
                   alt="{{ shop.name }}"
                   width="220" height="44"
                   loading="eager" fetchpriority="high">
            {%- elsif settings.logo_default != blank -%}
              <img src="{{ settings.logo_default | image_url: width: 220 }}"
                   alt="{{ shop.name }}"
                   width="{{ settings.logo_width }}"
                   loading="eager" fetchpriority="high">
            {%- else -%}
              <span class="header-logo__text">{{ shop.name }}</span>
            {%- endif -%}
          </a>
        </div>

        {%- if section.settings.show_search -%}
          <div class="header-search">
            <form action="{{ routes.search_url }}" method="get" class="header-search__form" role="search">
              <div class="header-search__cat">
                <select name="type" aria-label="Search category">
                  <option value="">All Categories</option>
                  <option value="product">Products</option>
                  <option value="article">Articles</option>
                  <option value="page">Pages</option>
                </select>
              </div>
              <input type="search" name="q" placeholder="Search products…" aria-label="Search">
              <button type="submit" aria-label="Search">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.35-4.35"/></svg>
              </button>
            </form>
          </div>
        {%- endif -%}

        <div class="header-actions">

          {%- if section.settings.show_compare -%}
            <a href="{{ section.settings.compare_url | default: '#' }}" class="header-icon-btn" aria-label="Compare" title="Compare">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
            </a>
          {%- endif -%}

          <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="header-icon-btn" aria-label="Account" title="Account">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg>
          </a>

          <div class="header-cart-wrap">
            <a href="{{ routes.cart_url }}" class="header-cart-btn" aria-label="Cart">
              <span class="header-cart-btn__icon">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3h2l2.4 12.5a2 2 0 0 0 2 1.5h8.5a2 2 0 0 0 2-1.6L22 7H6"/><circle cx="10" cy="21" r="1"/><circle cx="19" cy="21" r="1"/></svg>
                <span class="header-cart-badge">{{ cart.item_count }}</span>
              </span>
              <span class="header-cart-price">{{ cart.total_price | money }}</span>
            </a>

            <div class="header-mini-cart">
              {%- if cart.item_count > 0 -%}
                <ul>
                  {%- for item in cart.items limit: 4 -%}
                    <li class="header-mini-cart__item">
                      <div class="header-mini-cart__img">
                        {%- if item.image -%}
                          <img src="{{ item.image | image_url: width: 120 }}" alt="{{ item.product.title | escape }}" width="60" height="60" loading="lazy">
                        {%- endif -%}
                      </div>
                      <div class="header-mini-cart__info">
                        <div class="header-mini-cart__name">{{ item.product.title | truncate: 42 }}</div>
                        <div class="header-mini-cart__price">
                          <span>{{ item.quantity }} × </span>
                          <span>{{ item.final_line_price | money }}</span>
                        </div>
                      </div>
                    </li>
                  {%- endfor -%}
                </ul>
                <div class="header-mini-cart__total">
                  <span>Subtotal:</span>
                  <span class="header-mini-cart__total-price">{{ cart.total_price | money }}</span>
                </div>
                <div class="header-mini-cart__btns">
                  <a href="{{ routes.cart_url }}" class="header-btn header-btn--outline">View Cart</a>
                  <a href="{{ routes.cart_url }}/checkout" class="header-btn header-btn--solid">Checkout</a>
                </div>
              {%- else -%}
                <div class="header-mini-cart__empty">Your cart is empty</div>
              {%- endif -%}
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>

  <div class="header-navbar">
    <div class="header-container">
      <div class="header-navbar__grid">

        <div class="header-mega-wrap">
          <div class="header-mega-btn" id="HeaderMegaBtn" tabindex="0" role="button" aria-haspopup="true">
            <span class="header-mega-btn__lines"><i></i><i></i><i></i></span>
            {{ section.settings.mega_label | default: 'ALL CATEGORIES' }}
          </div>
          <ul class="header-mega-list">
            {%- for block in section.blocks -%}
              {%- if block.type == 'menu_item' -%}
                <li class="{% if block.settings.submenu != blank %}header-has-mega{% endif %}" {{ block.shopify_attributes }}>
                  <a href="{{ block.settings.link | default: '#' }}" class="header-mega-link">
                    <span class="header-mega-link__title">{{ block.settings.title }}</span>
                    {%- if block.settings.submenu != blank -%}
                      <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M9 6l6 6-6 6"/></svg>
                    {%- endif -%}
                  </a>
                  {%- if block.settings.submenu != blank -%}
                    <div class="header-mega-panel">{{ block.settings.submenu }}</div>
                  {%- endif -%}
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>

        <nav class="header-mainnav" id="HeaderMainNav" aria-label="Primary">
          <ul>
            {%- if section.settings.main_menu != blank -%}
              {%- for link in linklists[section.settings.main_menu].links -%}
                <li class="{% if link.links.size > 0 %}header-has-sub{% endif %}">
                  <a href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>
                    {{ link.title }}
                    {%- if link.links.size > 0 -%}
                      <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M6 9l6 6 6-6"/></svg>
                    {%- endif -%}
                  </a>
                  {%- if link.links.size > 0 -%}
                    <ul class="header-subnav">
                      {%- for child in link.links -%}
                        <li>
                          <a href="{{ child.url }}">
                            <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M9 6l6 6-6 6"/></svg>
                            {{ child.title }}
                          </a>
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            {%- endif -%}
          </ul>
        </nav>

        {%- if section.settings.deal_text != blank and section.settings.deal_link != blank -%}
          <a href="{{ section.settings.deal_link }}" class="header-deal">
            <span class="header-deal__dot"></span>
            {{ section.settings.deal_text }}
          </a>
        {%- endif -%}

      </div>
    </div>
  </div>

  <div class="header-mobile" id="HeaderMobile" aria-hidden="true">
    <div class="header-mobile__head">
      <span>{{ shop.name }}</span>
      <button id="HeaderClose" aria-label="Close menu">&times;</button>
    </div>
    <ul class="header-mobile__list">
      {%- if section.settings.main_menu != blank -%}
        {%- for link in linklists[section.settings.main_menu].links -%}
          <li>
            {%- if link.links.size > 0 -%}
              <button class="header-mobile__toggle" aria-expanded="false" data-header-toggle>
                {{ link.title }}
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M6 9l6 6 6-6"/></svg>
              </button>
              <ul class="header-mobile__sub">
                {%- for child in link.links -%}
                  <li><a href="{{ child.url }}">{{ child.title }}</a></li>
                {%- endfor -%}
              </ul>
            {%- else -%}
              <a href="{{ link.url }}">{{ link.title }}</a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
  <div class="header-overlay" id="HeaderOverlay"></div>

</div>

{{ 'header.js' | asset_url | script_tag }}

{% schema %}
{
  "name": "Header",
  "tag": "header",
  "class": "section-header",
  "settings": [
    {
      "type": "header",
      "content": "Style Options"
    },
    {
      "type": "select",
      "id": "header_style",
      "label": "Header style",
      "info": "Animated = premium motion, Minimal = flat clean, Classic = default",
      "options": [
        { "value": "classic",  "label": "Classic" },
        { "value": "animated", "label": "Animated (premium)" },
        { "value": "minimal",  "label": "Minimal (flat)" }
      ],
      "default": "classic"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "label": "Sticky header on scroll",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_scroll",
      "label": "Hide on scroll down, show on scroll up",
      "info": "Only works when sticky is enabled",
      "default": false
    },
    {
      "type": "header",
      "content": "Custom Design Override"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_design",
      "label": "Enable custom design override",
      "info": "When enabled, these values override theme settings for this header only",
      "default": false
    },
    {
      "type": "color",
      "id": "custom_bg",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "custom_bg_2",
      "label": "Top bar background",
      "default": "#2B1E16"
    },
    {
      "type": "color",
      "id": "custom_text",
      "label": "Text color",
      "default": "#2B1E16"
    },
    {
      "type": "color",
      "id": "custom_accent",
      "label": "Accent color",
      "default": "#9C4A1A"
    },
    {
      "type": "color",
      "id": "custom_accent_2",
      "label": "Secondary accent",
      "default": "#D4A373"
    },
    {
      "type": "color",
      "id": "custom_border",
      "label": "Border color",
      "default": "#E8E0D8"
    },
    {
      "type": "range",
      "id": "custom_font_size",
      "label": "Base font size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "custom_nav_font_size",
      "label": "Navigation font size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "custom_padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "custom_padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "custom_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Branding"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image",
      "info": "Leave blank to use theme logo from theme settings"
    },
    {
      "type": "header",
      "content": "Top Bar"
    },
    {
      "type": "link_list",
      "id": "topbar_menu",
      "label": "Top bar menu"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone number",
      "default": "(+91) 90129 83208"
    },
    {
      "type": "checkbox",
      "id": "show_currency",
      "label": "Show currency selector",
      "default": true
    },
    {
      "type": "header",
      "content": "Main Bar"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search bar",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_compare",
      "label": "Show compare icon",
      "default": true
    },
    {
      "type": "url",
      "id": "compare_url",
      "label": "Compare page URL"
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "text",
      "id": "mega_label",
      "label": "Mega menu button label",
      "default": "ALL CATEGORIES"
    },
    {
      "type": "link_list",
      "id": "main_menu",
      "label": "Main menu"
    },
    {
      "type": "text",
      "id": "deal_text",
      "label": "Deal badge text",
      "info": "Leave blank to hide",
      "default": "TODAY DEALS"
    },
    {
      "type": "url",
      "id": "deal_link",
      "label": "Deal badge link"
    }
  ],
  "blocks": [
    {
      "type": "menu_item",
      "name": "Mega Menu Item",
      "limit": 12,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Laptops & Mac" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "html", "id": "submenu", "label": "Submenu HTML (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Header",
      "blocks": [
        { "type": "menu_item", "settings": { "title": "Laptops & Mac" } },
        { "type": "menu_item", "settings": { "title": "Mobile & Tablet" } },
        { "type": "menu_item", "settings": { "title": "Audio & Video" } }
      ]
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}