{{ 'header.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign design = section.settings.header_style
  assign sticky = section.settings.enable_sticky
  assign hide_scroll = section.settings.hide_on_scroll
  assign use_custom = section.settings.enable_custom_design
-%}

<div class="header-wrapper header-wrapper--{{ design }}{% if sticky %} header-wrapper--sticky{% endif %}{% if hide_scroll %} header-wrapper--hide-scroll{% endif %}{% if use_custom %} header-wrapper--custom{% endif %}"
     id="HeaderMain"
     data-header-main
     style="{% if use_custom %}
       --header-bg: {{ section.settings.custom_bg }};
       --header-bg-2: {{ section.settings.custom_bg_2 }};
       --header-text: {{ section.settings.custom_text }};
       --header-accent: {{ section.settings.custom_accent }};
       --header-accent-2: {{ section.settings.custom_accent_2 }};
       --header-border-color: {{ section.settings.custom_border }};
       --header-font-size: {{ section.settings.custom_font_size }}px;
       --header-nav-font-size: {{ section.settings.custom_nav_font_size }}px;
       --header-padding-top: {{ section.settings.custom_padding_top }}px;
       --header-padding-bottom: {{ section.settings.custom_padding_bottom }}px;
       --header-radius: {{ section.settings.custom_radius }}px;
     {% endif %}">

  <div class="header-mainbar">
    <div class="header-container">
      <div class="header-mainbar__grid">
        
        <button class="header-burger" id="HeaderBurger" aria-label="{{ 'general.accessibility.open_menu' | t }}" aria-controls="HeaderMobile" aria-expanded="false">
          <span></span><span></span><span></span>
        </button>

        <div class="header-logo">
          <a href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
            {%- if section.settings.logo != blank -%}
              {%- capture img_alt -%}{{ shop.name }}{%- endcapture -%}{{ section.settings.logo | image_url: width: 220 | image_tag: widths: '100, 165, 220', sizes: '220px', loading: 'eager', alt: img_alt, fetchpriority: 'high' }}
            {%- elsif settings.logo_default != blank -%}
              {%- capture img_alt -%}{{ shop.name }}{%- endcapture -%}{{ settings.logo_default | image_url: width: 220 | image_tag: widths: '100, 165, 220', sizes: '220px', loading: 'eager', alt: img_alt, fetchpriority: 'high' }}
            {%- else -%}
              <span class="header-logo__text">{{ shop.name }}</span>
            {%- endif -%}
          </a>
        </div>

        {%- if section.settings.show_search -%}
          {%- liquid
            assign search_tag = 'div'
            if settings.search_suggestions
              assign search_tag = 'predictive-search'
            endif
          -%}
          {%- if settings.search_suggestions -%}
            <link rel="stylesheet" href="{{ 'predictive-search.css' | asset_url }}" media="print" onload="this.media='all'">
            <script src="{{ 'predictive-search.js' | asset_url }}" defer></script>
          {%- endif -%}
          <{{ search_tag }} class="header-search" data-url="{{ routes.predictive_search_url }}">
            <form action="{{ routes.search_url }}" method="get" class="header-search__form" role="search">
              <div class="header-search__cat">
                <select name="type" aria-label="{{ 'general.header.search_category' | t }}">
                  <option value="">{{ 'general.header.all_categories' | t }}</option>
                  <option value="product">{{ 'search.predictive.products' | t }}</option>
                  <option value="article">{{ 'search.predictive.articles' | t }}</option>
                  <option value="page">{{ 'search.predictive.pages' | t }}</option>
                </select>
              </div>
              <input
                type="search"
                name="q"
                placeholder="{{ 'general.header.search_placeholder' | t }}"
                aria-label="{{ 'search.label' | t }}"
                {% if settings.search_suggestions %}
                  role="combobox"
                  aria-expanded="false"
                  aria-controls="PredictiveSearchResults"
                  aria-autocomplete="list"
                  autocomplete="off"
                {% endif %}
              >
              <input type="hidden" name="options[prefix]" value="last">
              <button type="submit" aria-label="{{ 'search.submit' | t }}">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.35-4.35"/></svg>
              </button>
            </form>
            {%- if settings.search_suggestions -%}
              <div
                class="predictive-search"
                id="PredictiveSearchResults"
                role="listbox"
                aria-label="{{ 'search.predictive.label' | t }}"
                data-predictive-results
                hidden
              ></div>
              <span class="visually-hidden" role="status" data-predictive-status></span>
            {%- endif -%}
          </{{ search_tag }}>
        {%- endif -%}

        <div class="header-actions">

          {%- if section.settings.show_compare -%}
            <a href="{{ section.settings.compare_url | default: '#' }}" class="header-icon-btn" aria-label="{{ 'general.header.compare' | t }}" title="{{ 'general.header.compare' | t }}">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
            </a>
          {%- endif -%}

          <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="header-icon-btn" aria-label="{{ 'general.header.account' | t }}" title="{{ 'general.header.account' | t }}">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg>
          </a>

          <div class="header-cart-wrap">
            {%- case settings.cart_type -%}
              {%- when 'drawer' -%}
                {% render 'cart-drawer' %}
              {%- when 'popup' -%}
                {% render 'cart-popup' %}
              {%- else -%}
                {% render 'cart-icon' %}
            {%- endcase -%}
          </div>

        </div>
      </div>
    </div>
  </div>

  <div class="header-navbar">
    <div class="header-container">
      <div class="header-navbar__grid">

        <div class="header-mega-wrap">
          <div class="header-mega-btn" id="HeaderMegaBtn" tabindex="0" role="button" aria-haspopup="true">
            <span class="header-mega-btn__lines"><i></i><i></i><i></i></span>
            {%- assign mega_fallback = 'general.header.all_categories' | t -%}{{ section.settings.mega_label | default: mega_fallback }}
          </div>
          <ul class="header-mega-list">
            {%- for block in section.blocks -%}
              {%- if block.type == 'menu_item' -%}
                {%- assign submenu = linklists[block.settings.submenu_menu] -%}
                <li class="{% if submenu.links.size > 0 %}header-has-mega{% endif %}" {{ block.shopify_attributes }}>
                  <a href="{{ block.settings.link | default: '#' }}" class="header-mega-link">
                    <span class="header-mega-link__title">{{ block.settings.title | escape }}</span>
                    {%- if submenu.links.size > 0 -%}
                      <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
                    {%- endif -%}
                  </a>
                  {%- if submenu.links.size > 0 -%}
                    <div class="header-mega-panel">
                      <ul class="header-mega-columns">
                        {%- for link in submenu.links -%}
                          <li class="header-mega-column">
                            <a href="{{ link.url }}" class="header-mega-column__title">{{ link.title | escape }}</a>
                            {%- if link.links.size > 0 -%}
                              <ul class="header-mega-column__links">
                                {%- for child in link.links -%}
                                  <li><a href="{{ child.url }}">{{ child.title | escape }}</a></li>
                                {%- endfor -%}
                              </ul>
                            {%- endif -%}
                          </li>
                        {%- endfor -%}
                      </ul>
                    </div>
                  {%- endif -%}
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>

        <nav class="header-mainnav" id="HeaderMainNav" aria-label="{{ 'general.accessibility.primary_navigation' | t }}">
          <ul>
            {%- if section.settings.main_menu != blank -%}
              {%- for link in linklists[section.settings.main_menu].links -%}
                <li class="{% if link.links.size > 0 %}header-has-sub{% endif %}">
                  <a href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>
                    {{ link.title }}
                    {%- if link.links.size > 0 -%}
                      <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M6 9l6 6 6-6"/></svg>
                    {%- endif -%}
                  </a>
                  {%- if link.links.size > 0 -%}
                    <ul class="header-subnav">
                      {%- for child in link.links -%}
                        <li class="{% if child.links.size > 0 %}header-has-third{% endif %}">
                          <a href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>
                            <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
                            <span>{{ child.title | escape }}</span>
                          </a>
                          {%- if child.links.size > 0 -%}
                            <ul class="header-thirdnav">
                              {%- for grandchild in child.links -%}
                                <li>
                                  <a href="{{ grandchild.url }}"{% if grandchild.current %} aria-current="page"{% endif %}>{{ grandchild.title | escape }}</a>
                                </li>
                              {%- endfor -%}
                            </ul>
                          {%- endif -%}
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            {%- endif -%}
          </ul>
        </nav>

        {%- if section.settings.deal_text != blank and section.settings.deal_link != blank -%}
          <a href="{{ section.settings.deal_link }}" class="header-deal">
            <span class="header-deal__dot"></span>
            {{ section.settings.deal_text }}
          </a>
        {%- endif -%}

      </div>
    </div>
  </div>

  <div class="header-mobile" id="HeaderMobile" aria-hidden="true">
    <div class="header-mobile__head">
      <span>{{ shop.name }}</span>
      <button id="HeaderClose" aria-label="{{ 'general.accessibility.close_menu' | t }}">&times;</button>
    </div>
    <ul class="header-mobile__list">
      {%- if section.settings.main_menu != blank -%}
        {%- for link in linklists[section.settings.main_menu].links -%}
          <li>
            {%- if link.links.size > 0 -%}
              <button class="header-mobile__toggle" aria-expanded="false" data-header-toggle>
                {{ link.title }}
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M6 9l6 6 6-6"/></svg>
              </button>
              <ul class="header-mobile__sub">
                {%- for child in link.links -%}
                  <li>
                    {%- if child.links.size > 0 -%}
                      <button class="header-mobile__toggle header-mobile__toggle--child" aria-expanded="false" data-header-toggle>
                        {{ child.title | escape }}
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
                      </button>
                      <ul class="header-mobile__sub header-mobile__sub--third">
                        {%- for grandchild in child.links -%}
                          <li><a href="{{ grandchild.url }}">{{ grandchild.title | escape }}</a></li>
                        {%- endfor -%}
                      </ul>
                    {%- else -%}
                      <a href="{{ child.url }}">{{ child.title | escape }}</a>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            {%- else -%}
              <a href="{{ link.url }}">{{ link.title }}</a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
  <div class="header-overlay" id="HeaderOverlay"></div>

</div>

<script src="{{ 'header.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "t:sections.header.name",
  "tag": "header",
  "class": "section-header",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.header.headers.style_options"
    },
    {
      "type": "select",
      "id": "header_style",
      "label": "t:sections.header.settings.header_style.label",
      "info": "t:sections.header.settings.header_style.info",
      "options": [
        {
          "value": "classic",
          "label": "t:sections.header.settings.header_style.options.classic"
        },
        {
          "value": "animated",
          "label": "t:sections.header.settings.header_style.options.animated"
        },
        {
          "value": "minimal",
          "label": "t:sections.header.settings.header_style.options.minimal"
        }
      ],
      "default": "classic"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "label": "t:sections.header.settings.enable_sticky.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_scroll",
      "label": "t:sections.header.settings.hide_on_scroll.label",
      "info": "t:sections.header.settings.hide_on_scroll.info",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.header.headers.custom_design_override"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_design",
      "label": "t:sections.header.settings.enable_custom_design.label",
      "info": "t:sections.header.settings.enable_custom_design.info",
      "default": false
    },
    {
      "type": "color",
      "id": "custom_bg",
      "label": "t:sections.header.settings.custom_bg.label",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "custom_bg_2",
      "label": "t:sections.header.settings.custom_bg_2.label",
      "default": "#2B1E16"
    },
    {
      "type": "color",
      "id": "custom_text",
      "label": "t:sections.header.settings.custom_text.label",
      "default": "#2B1E16"
    },
    {
      "type": "color",
      "id": "custom_accent",
      "label": "t:sections.header.settings.custom_accent.label",
      "default": "#9C4A1A"
    },
    {
      "type": "color",
      "id": "custom_accent_2",
      "label": "t:sections.header.settings.custom_accent_2.label",
      "default": "#D4A373"
    },
    {
      "type": "color",
      "id": "custom_border",
      "label": "t:sections.header.settings.custom_border.label",
      "default": "#E8E0D8"
    },
    {
      "type": "range",
      "id": "custom_font_size",
      "label": "t:sections.header.settings.custom_font_size.label",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "custom_nav_font_size",
      "label": "t:sections.header.settings.custom_nav_font_size.label",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "custom_padding_top",
      "label": "t:sections.header.settings.custom_padding_top.label",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "custom_padding_bottom",
      "label": "t:sections.header.settings.custom_padding_bottom.label",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "custom_radius",
      "label": "t:sections.header.settings.custom_radius.label",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "t:sections.header.headers.branding"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:sections.header.settings.logo.label",
      "info": "t:sections.header.settings.logo.info"
    },
    {
      "type": "header",
      "content": "t:sections.header.headers.main_bar"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "t:sections.header.settings.show_search.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_compare",
      "label": "t:sections.header.settings.show_compare.label",
      "default": true
    },
    {
      "type": "url",
      "id": "compare_url",
      "label": "t:sections.header.settings.compare_url.label"
    },
    {
      "type": "header",
      "content": "t:sections.header.headers.navigation"
    },
    {
      "type": "text",
      "id": "mega_label",
      "label": "t:sections.header.settings.mega_label.label",
      "default": "ALL CATEGORIES"
    },
    {
      "type": "link_list",
      "id": "main_menu",
      "label": "t:sections.header.settings.main_menu.label"
    },
    {
      "type": "text",
      "id": "deal_text",
      "label": "t:sections.header.settings.deal_text.label",
      "info": "t:sections.header.settings.deal_text.info",
      "default": "TODAY DEALS"
    },
    {
      "type": "url",
      "id": "deal_link",
      "label": "t:sections.header.settings.deal_link.label"
    }
  ],
  "blocks": [
    {
      "type": "menu_item",
      "name": "t:sections.header.blocks.menu_item.name",
      "limit": 12,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.header.blocks.menu_item.settings.title.label",
          "default": "Laptops & Mac"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.header.blocks.menu_item.settings.link.label"
        },
        {
          "type": "link_list",
          "id": "submenu_menu",
          "label": "t:sections.header.blocks.menu_item.settings.submenu_menu.label",
          "info": "t:sections.header.blocks.menu_item.settings.submenu_menu.info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.header.name",
      "blocks": [
        {
          "type": "menu_item",
          "settings": {
            "title": "Laptops & Mac"
          }
        },
        {
          "type": "menu_item",
          "settings": {
            "title": "Mobile & Tablet"
          }
        },
        {
          "type": "menu_item",
          "settings": {
            "title": "Audio & Video"
          }
        }
      ]
    }
  ],
  "enabled_on": {
    "groups": [
      "header"
    ]
  }
}
{% endschema %}
