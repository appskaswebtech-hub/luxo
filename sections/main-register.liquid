{{ 'customer.css' | asset_url | stylesheet_tag }}

<div class="customer">
  <h1 class="customer__title">{{ 'customer.register.title' | t }}</h1>

  {%- form 'create_customer', novalidate: 'novalidate' -%}
    {% render 'customer-errors', errors: form.errors %}

    <div class="customer__field">
      <label for="RegisterFirstName">{{ 'customer.fields.first_name' | t }}</label>
      <input type="text" id="RegisterFirstName" name="customer[first_name]" autocomplete="given-name">
    </div>

    <div class="customer__field">
      <label for="RegisterLastName">{{ 'customer.fields.last_name' | t }}</label>
      <input type="text" id="RegisterLastName" name="customer[last_name]" autocomplete="family-name">
    </div>

    <div class="customer__field">
      <label for="RegisterEmail">{{ 'customer.fields.email' | t }}</label>
      <input
        type="email"
        id="RegisterEmail"
        name="customer[email]"
        autocomplete="email"
        autocapitalize="off"
        required
        {% if form.errors contains 'email' %}
          aria-invalid="true"
        {% endif %}
      >
    </div>

    <div class="customer__field">
      <label for="RegisterPassword">{{ 'customer.fields.password' | t }}</label>
      <input
        type="password"
        id="RegisterPassword"
        name="customer[password]"
        autocomplete="new-password"
        required
        {% if form.errors contains 'password' %}
          aria-invalid="true"
        {% endif %}
      >
    </div>

    <label class="customer__check" for="RegisterMarketing">
      <input type="checkbox" id="RegisterMarketing" name="customer[accepts_marketing]" value="true">
      <span>{{ 'customer.register.marketing' | t }}</span>
    </label>

    <button type="submit" class="customer__button">{{ 'customer.register.submit' | t }}</button>

    <div class="customer__links">
      <a href="{{ routes.account_login_url }}">{{ 'customer.register.login' | t }}</a>
    </div>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "t:sections.customer.register",
  "settings": []
}
{% endschema %}
