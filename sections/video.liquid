{%- liquid
  assign scheme = section.settings.color_scheme.settings
  assign hosted = section.settings.video
  assign external = section.settings.video_url

  assign title = section.settings.description
  if title == blank
    assign title = 'sections.video.default_title' | t
  endif

  assign has_video = false
  if hosted != blank
    assign has_video = true
  elsif external != blank
    assign has_video = true
  endif

  assign cover = section.settings.cover_image
  if cover == blank
    if hosted != blank
      assign cover = hosted.preview_image
    endif
  endif
-%}

<div
  class="video-section{% if section.settings.full_width %} video-section--full{% endif %}"
  style="
    --vs-bg: {{ scheme.background }};
    --vs-text: {{ scheme.text }};
    --vs-accent: {{ scheme.accent }};
    --vs-pt: {{ section.settings.padding_top }}px;
    --vs-pb: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="video-section__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="video-section__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <deferred-video class="video-section__frame">
      {%- capture play_label -%}{{ 'sections.video.play' | t: title: title }}{%- endcapture -%}
      {%- if has_video -%}<button type="button" class="video-section__poster" aria-label="{{ play_label | escape }}" data-play>{%- else -%}<div class="video-section__poster">{%- endif -%}
        {%- if cover != blank -%}
          {{
            cover
            | image_url: width: 2400
            | image_tag:
              widths: '375, 750, 1100, 1500, 1800, 2400',
              sizes: '100vw',
              loading: 'lazy',
              alt: '',
              class: 'video-section__cover'
          }}
        {%- else -%}
          {{ 'hero-apparel-3' | placeholder_svg_tag: 'video-section__cover video-section__placeholder' }}
        {%- endif -%}
        {%- if has_video -%}
          <span class="video-section__play" aria-hidden="true">
            <svg viewBox="0 0 24 24" focusable="false"><path d="M8 5.5v13l11-6.5z" fill="currentColor"/></svg>
          </span>
          {%- endif -%}
      {%- if has_video -%}</button>{%- else -%}</div>{%- endif -%}

      <template data-video>
        {%- if hosted != blank -%}
          {{ hosted | video_tag: controls: true, autoplay: true, playsinline: true, class: 'video-section__media' }}
        {%- elsif external.type == 'youtube' -%}
          <iframe
            class="video-section__media"
            src="https://www.youtube-nocookie.com/embed/{{ external.id }}?autoplay=1&rel=0&playsinline=1"
            title="{{ title | escape }}"
            allow="autoplay; encrypted-media; picture-in-picture; fullscreen"
            allowfullscreen
          ></iframe>
        {%- elsif external.type == 'vimeo' -%}
          <iframe
            class="video-section__media"
            src="https://player.vimeo.com/video/{{ external.id }}?autoplay=1&dnt=1"
            title="{{ title | escape }}"
            allow="autoplay; fullscreen; picture-in-picture"
            allowfullscreen
          ></iframe>
        {%- endif -%}
      </template>
    </deferred-video>
  </div>
</div>

{% stylesheet %}
  .video-section {
    padding: var(--vs-pt) 1.25rem var(--vs-pb);
    background: var(--vs-bg);
    color: var(--vs-text);
  }

  .video-section--full {
    padding-right: 0;
    padding-left: 0;
  }

  .video-section__inner {
    max-width: var(--page-width, 1400px);
    margin: 0 auto;
  }

  .video-section--full .video-section__inner {
    max-width: none;
  }

  .video-section__heading {
    margin: 0 0 1.5rem;
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    text-align: center;
    color: inherit;
  }

  .video-section--full .video-section__heading {
    padding: 0 1.25rem;
  }

  .video-section__frame {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #000;
  }

  .video-section__poster {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .video-section__cover,
  .video-section__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
  }

  .video-section__placeholder {
    background: color-mix(in srgb, var(--vs-text) 8%, var(--vs-bg));
    fill: color-mix(in srgb, var(--vs-text) 40%, transparent);
  }

  .video-section__play {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    background: var(--vs-accent);
    color: var(--vs-bg);
    transform: translate(-50%, -50%);
    transition: transform 0.2s ease;
  }

  .video-section__play svg {
    width: 1.75rem;
    height: 1.75rem;
  }

  .video-section__poster:hover .video-section__play {
    transform: translate(-50%, -50%) scale(1.06);
  }

  .video-section__poster:focus-visible {
    outline: 3px solid var(--vs-accent);
    outline-offset: -3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .video-section__play {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('deferred-video')) {
    customElements.define(
      'deferred-video',
      class DeferredVideo extends HTMLElement {
        connectedCallback() {
          const button = this.querySelector('[data-play]');
          if (button) button.addEventListener('click', () => this.load(), { once: true });
        }

        load() {
          const template = this.querySelector('template[data-video]');
          if (!template) return;
          const content = template.content.cloneNode(true);
          const media = content.querySelector('video, iframe');
          this.replaceChildren(content);
          if (media) media.focus();
        }
      }
    );
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.video.name",
  "class": "video-section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.video.settings.heading.label",
      "default": "Watch the story"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:sections.video.settings.video.label"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "t:sections.video.settings.video_url.label",
      "info": "t:sections.video.settings.video_url.info",
      "accept": ["youtube", "vimeo"]
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "t:sections.video.settings.cover_image.label"
    },
    {
      "type": "text",
      "id": "description",
      "label": "t:sections.video.settings.description.label",
      "info": "t:sections.video.settings.description.info"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:sections.video.settings.full_width.label",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.video.settings.padding_top.label",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.video.settings.padding_bottom.label",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "t:sections.video.name"
    }
  ]
}
{% endschema %}
