{%- liquid
  assign use_custom = section.settings.enable_custom_design

  if use_custom
    assign blog_bg = section.settings.custom_bg_color
    assign blog_text = section.settings.custom_text_color
    assign blog_accent = section.settings.custom_accent_color
    assign blog_border = section.settings.custom_border_color
    assign heading_font = section.settings.custom_heading_font
    assign body_font = section.settings.custom_body_font
  else
    assign blog_bg = section.settings.background_color
    assign blog_text = section.settings.text_color
    assign blog_accent = section.settings.accent_color
    assign blog_border = section.settings.border_color
    assign heading_font = 'var(--font-heading-family)'
    assign body_font = 'var(--font-body-family)'
  endif

  capture main_placeholder_class
    echo 'editorial-blog-' | append: section.id | append: '__image editorial-blog-' | append: section.id | append: '__placeholder'
  endcapture
-%}

<section 
  class="editorial-blog-{{ section.id }}" 
  id="EditorialBlog-{{ section.id }}"
  style="
    --blog-bg: {{ blog_bg }};
    --blog-text: {{ blog_text }};
    --blog-accent: {{ blog_accent }};
    --blog-border: {{ blog_border }};
    --blog-heading-font: {{ heading_font }};
    --blog-body-font: {{ body_font }};
  "
>
  <div class="editorial-blog-{{ section.id }}__container">
    
    <header class="editorial-blog-{{ section.id }}__header">
      <h1 class="editorial-blog-{{ section.id }}__heading">{{ blog.title | default: 'Latest Articles' }}</h1>
    </header>

    {% paginate blog.articles by 6 %}
      <div class="editorial-blog-{{ section.id }}__grid">
        {%- if blog.articles.size > 0 -%}
          {%- for article in blog.articles -%}
            
            <article class="editorial-blog-{{ section.id }}__post-card">
              
              <a href="{{ article.url }}" class="editorial-blog-{{ section.id }}__image-wrapper">
                {%- if article.image != blank -%}
                  <img 
                    src="{{ article.image | image_url: width: 800 }}" 
                    alt="{{ article.image.alt | escape }}" 
                    class="editorial-blog-{{ section.id }}__image"
                    loading="lazy"
                    width="800"
                    height="450"
                  >
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: main_placeholder_class }}
                {%- endif -%}
              </a>

              <div class="editorial-blog-{{ section.id }}__content">
                <h3 class="editorial-blog-{{ section.id }}__title">
                  <a href="{{ article.url }}">{{ article.title | escape }}</a>
                </h3>
                
                <p class="editorial-blog-{{ section.id }}__date">{{ article.published_at | date: "%B %d, %Y" }}</p>
                
                <hr class="editorial-blog-{{ section.id }}__divider" />
                
                <p class="editorial-blog-{{ section.id }}__excerpt">
                  {%- if article.excerpt != blank -%}
                    {{ article.excerpt | strip_html | truncate: 120 }}
                  {%- else -%}
                    {{ article.content | strip_html | truncate: 120 }}
                  {%- endif -%}
                </p>
                
                <a href="{{ article.url }}" class="editorial-blog-{{ section.id }}__read-more">
                  Read Article
                </a>
              </div>

            </article>
            
          {%- endfor -%}
        {%- else -%}
          <div class="editorial-blog-{{ section.id }}__empty">
            No articles found in this blog.
          </div>
        {%- endif -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <div class="editorial-blog-{{ section.id }}__pagination">
          {{ paginate | default_pagination }}
        </div>
      {%- endif -%}
    {% endpaginate %}

  </div>
</section>

{% style %}
  .editorial-blog-{{ section.id }} {
    width: 100vw;
    max-width: 100vw;
    margin-left: -50vw;
    margin-right: -50vw;
    left: 50%;
    right: 50%;
    position: relative;
    background-color: var(--blog-bg);
    padding: 80px 0;
    font-family: var(--blog-body-font), -apple-system, sans-serif;
    color: var(--blog-text);
    overflow: hidden;
  }

  .editorial-blog-{{ section.id }}__container {
    width: 100%;
    max-width: var(--page-width, 1300px);
    margin: 0 auto;
    padding: 0 var(--page-margin, 20px);
    box-sizing: border-box;
  }

  .editorial-blog-{{ section.id }}__header {
    text-align: center;
    margin-bottom: 60px;
  }

  .editorial-blog-{{ section.id }}__heading {
    font-family: var(--blog-heading-font), serif;
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    margin: 0;
    color: var(--blog-text);
  }

  .editorial-blog-{{ section.id }}__grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: stretch;
    gap: 40px 0;
  }

  .editorial-blog-{{ section.id }}__post-card {
    flex: 0 0 calc(33.333% - 20px);
    border: 2px solid var(--blog-border);
    background-color: var(--blog-bg);
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .editorial-blog-{{ section.id }}__post-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 30px rgba(43, 30, 22, 0.1);
  }

  .editorial-blog-{{ section.id }}__image-wrapper {
    display: block;
    width: 100%;
    position: relative;
    overflow: hidden;
    border-bottom: 2px solid var(--blog-border);
    aspect-ratio: 16 / 9;
  }

  .editorial-blog-{{ section.id }}__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .editorial-blog-{{ section.id }}__post-card:hover .editorial-blog-{{ section.id }}__image {
    transform: scale(1.05);
  }

  .editorial-blog-{{ section.id }}__placeholder {
    background-color: #f0f0f0;
    fill: #a0a0a0;
    width: 100%;
    height: 100%;
  }

  .editorial-blog-{{ section.id }}__content {
    padding: 24px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .editorial-blog-{{ section.id }}__title {
    font-family: var(--blog-heading-font), serif;
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0 0 10px 0;
    line-height: 1.3;
  }

  .editorial-blog-{{ section.id }}__title a {
    text-decoration: none;
    color: var(--blog-text);
    transition: color 0.3s ease;
  }

  .editorial-blog-{{ section.id }}__title a:hover {
    color: var(--blog-accent);
  }

  .editorial-blog-{{ section.id }}__date {
    font-size: calc(var(--font-body-size) * 0.85);
    color: var(--blog-accent);
    margin: 0 0 15px 0;
    font-family: var(--blog-body-font), sans-serif;
    opacity: 0.8;
  }

  .editorial-blog-{{ section.id }}__divider {
    border: none;
    border-top: 2px solid var(--blog-border);
    margin: 0 0 15px 0;
    width: 100%;
    opacity: 0.2;
  }

  .editorial-blog-{{ section.id }}__excerpt {
    font-size: var(--font-body-size);
    line-height: 1.6;
    margin: 0 0 24px 0;
    flex-grow: 1;
  }

  .editorial-blog-{{ section.id }}__read-more {
    display: inline-block;
    padding: 10px 24px;
    border: 2px solid var(--blog-text);
    text-decoration: none;
    color: var(--blog-text);
    font-family: var(--blog-body-font), sans-serif;
    font-weight: 600;
    font-size: calc(var(--font-body-size) * 0.9);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    text-align: center;
    align-self: flex-start;
    transition: all 0.3s ease;
  }

  .editorial-blog-{{ section.id }}__read-more:hover {
    background-color: var(--blog-text);
    color: var(--blog-bg);
  }

  .editorial-blog-{{ section.id }}__pagination {
    margin-top: 60px;
    display: flex;
    justify-content: center;
  }

  .editorial-blog-{{ section.id }}__pagination a,
  .editorial-blog-{{ section.id }}__pagination span {
    display: inline-block;
    padding: 8px 16px;
    margin: 0 4px;
    border: 1px solid var(--blog-border);
    color: var(--blog-text);
    text-decoration: none;
    font-weight: 600;
    transition: all 0.3s ease;
  }

  .editorial-blog-{{ section.id }}__pagination .current {
    background-color: var(--blog-text);
    color: var(--blog-bg);
  }

  .editorial-blog-{{ section.id }}__empty {
    text-align: center;
    width: 100%;
    padding: 40px;
    font-size: 1.2rem;
  }

  @media (max-width: 990px) {
    .editorial-blog-{{ section.id }}__post-card {
      flex: 0 0 calc(50% - 15px);
    }
    .editorial-blog-{{ section.id }}__grid {
      gap: 30px 0;
    }
  }

  @media (max-width: 750px) {
    .editorial-blog-{{ section.id }} {
      padding: 60px 0;
    }
    .editorial-blog-{{ section.id }}__post-card {
      flex: 0 0 100%;
    }
    .editorial-blog-{{ section.id }}__header {
      margin-bottom: 40px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Blog Template",
  "tag": "section",
  "class": "section-blog-template",
  "settings": [
    {
      "type": "header",
      "content": "Default Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FAF6F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2B1E16"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color (Hover)",
      "default": "#9C4A1A"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#2B1E16"
    },
    {
      "type": "header",
      "content": "Custom Design (Override)"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_design",
      "label": "Enable Custom Design",
      "info": "When enabled, these override the default colors and typography.",
      "default": false
    },
    {
      "type": "color",
      "id": "custom_bg_color",
      "label": "Custom Background",
      "default": "#FFFFFF",
      "visible_if": "{{ section.settings.enable_custom_design }}"
    },
    {
      "type": "color",
      "id": "custom_text_color",
      "label": "Custom Text Color",
      "default": "#111111",
      "visible_if": "{{ section.settings.enable_custom_design }}"
    },
    {
      "type": "color",
      "id": "custom_accent_color",
      "label": "Custom Accent Color",
      "default": "#000000",
      "visible_if": "{{ section.settings.enable_custom_design }}"
    },
    {
      "type": "color",
      "id": "custom_border_color",
      "label": "Custom Border Color",
      "default": "#E0E0E0",
      "visible_if": "{{ section.settings.enable_custom_design }}"
    },
    {
      "type": "font_picker",
      "id": "custom_heading_font",
      "label": "Custom Heading Font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_design }}"
    },
    {
      "type": "font_picker",
      "id": "custom_body_font",
      "label": "Custom Body Font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_design }}"
    }
  ]
}
{% endschema %}