{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'password.heading' | t
  endif

  assign message = section.settings.message
  if message == blank
    assign message = shop.password_message
  endif
  if message == blank
    assign message = 'password.message' | t
  endif

  assign divider_text = section.settings.divider_text
  if divider_text == blank
    assign divider_text = 'password.divider' | t
  endif

  assign footer_text = section.settings.footer_text
  if footer_text == blank
    assign footer_text = 'password.footer' | t
  endif

  assign signup_heading = section.settings.signup_heading
  if signup_heading == blank
    assign signup_heading = 'password.signup.heading' | t
  endif
-%}

<div
  class="password-page"
  style="
    --pw-bg: {{ section.settings.background }};
    --pw-accent: {{ section.settings.accent }};
    --pw-accent-text: {{ section.settings.accent_text }};
    --pw-text: {{ section.settings.text }};
  "
>
  {%- if section.settings.background_image != blank -%}
    {%- capture bg_position -%}object-position: {{ section.settings.background_image.presentation.focal_point }}{%- endcapture -%}
    <div class="password-page__bg" style="--pw-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};">
      {{
        section.settings.background_image
        | image_url: width: 2400
        | image_tag:
          widths: '750, 1100, 1500, 1800, 2400',
          sizes: '100vw',
          loading: 'eager',
          alt: '',
          style: bg_position
      }}
    </div>
  {%- endif -%}

  {%- if section.settings.show_decorations -%}
    <div class="password-page__decor" aria-hidden="true">
      <svg class="password-page__wave password-page__wave--top" viewBox="0 0 320 280" fill="none" focusable="false">
        <path d="M0 0h320c-18 46-64 62-112 76-52 15-84 44-104 92C84 216 46 252 0 280Z" fill="currentColor"/>
        <path d="M0 236c40-14 66-48 86-96 22-52 62-84 124-100 46-12 84-26 104-56" stroke="currentColor" stroke-opacity=".35" stroke-width="2"/>
      </svg>
      <svg class="password-page__wave password-page__wave--bottom" viewBox="0 0 320 280" fill="none" focusable="false">
        <path d="M0 0h320c-18 46-64 62-112 76-52 15-84 44-104 92C84 216 46 252 0 280Z" fill="currentColor"/>
        <path d="M0 236c40-14 66-48 86-96 22-52 62-84 124-100 46-12 84-26 104-56" stroke="currentColor" stroke-opacity=".35" stroke-width="2"/>
      </svg>
      <svg class="password-page__branch" viewBox="0 0 140 190" fill="currentColor" focusable="false">
        <path d="M130 4C96 30 70 72 56 120c-8 26-12 46-14 66" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
        <path d="M108 26c-4-18 6-30 22-30-2 16-10 26-22 30Z"/>
        <path d="M100 38c-18-4-26-18-20-32 14 6 22 18 20 32Z"/>
        <path d="M86 60c2-18 16-26 30-22-6 14-16 22-30 22Z"/>
        <path d="M80 70c-18 0-28-12-26-28 14 4 24 14 26 28Z"/>
        <path d="M66 96c4-18 18-24 32-18-8 12-18 18-32 18Z"/>
        <path d="M62 106c-18-2-26-16-22-30 14 6 22 16 22 30Z"/>
        <path d="M54 134c6-16 20-20 32-12-8 10-20 14-32 12Z"/>
        <path d="M50 142c-16-4-22-18-16-30 12 6 18 16 16 30Z"/>
      </svg>
      <svg class="password-page__sparkle password-page__sparkle--1" viewBox="0 0 20 20" focusable="false"><path d="M10 0Q11 9 20 10 11 11 10 20 9 11 0 10 9 9 10 0Z" fill="currentColor"/></svg>
      <svg class="password-page__sparkle password-page__sparkle--2" viewBox="0 0 20 20" focusable="false"><path d="M10 0Q11 9 20 10 11 11 10 20 9 11 0 10 9 9 10 0Z" fill="currentColor"/></svg>
      <svg class="password-page__sparkle password-page__sparkle--3" viewBox="0 0 20 20" focusable="false"><path d="M10 0Q11 9 20 10 11 11 10 20 9 11 0 10 9 9 10 0Z" fill="currentColor"/></svg>
    </div>
  {%- endif -%}

  <main class="password-page__inner" id="MainContent">
    {%- if section.settings.show_logo -%}
      <div class="password-page__brand">
        {%- if settings.logo_default != blank -%}
          {{ settings.logo_default | image_url: width: 400 | image_tag: class: 'password-page__logo', alt: shop.name, sizes: '160px', loading: 'eager', widths: '160, 240, 320, 400' }}
        {%- else -%}
          <span class="password-page__shop">{{ shop.name | escape }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}

    <svg class="password-page__art" viewBox="0 0 170 160" fill="none" aria-hidden="true" focusable="false">
      <path d="M20 112C4 92 42 58 96 40c42-14 70-10 66 6" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
      <path d="M58 54V44a24 24 0 0 1 48 0v10" stroke="currentColor" stroke-width="6" stroke-linecap="round"/>
      <path d="M40 54h84l7 82a10 10 0 0 1-10 11H43a10 10 0 0 1-10-11Z" fill="currentColor"/>
      <path d="M70 96v-9a12 12 0 0 1 24 0v9" stroke="var(--pw-bg)" stroke-width="5" stroke-linecap="round"/>
      <rect x="63" y="94" width="38" height="30" rx="6" fill="var(--pw-bg)"/>
      <circle cx="82" cy="106" r="4" fill="currentColor"/>
      <rect x="80.25" y="107" width="3.5" height="9" rx="1.75" fill="currentColor"/>
      <path d="M128 112c8 4 20 2 30-6" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
      <path d="M150 18Q151 26 159 27 151 28 150 36 149 28 141 27 149 26 150 18Z" fill="currentColor"/>
      <path d="M22 40Q23 46 29 47 23 48 22 54 21 48 15 47 21 46 22 40Z" fill="currentColor"/>
    </svg>

    <h1 class="password-page__heading">{{ heading | escape }}</h1>
    <div class="password-page__message rte">{{ message }}</div>

    <p class="password-page__divider"><span>{{ divider_text | escape }}</span></p>

    {%- form 'storefront_password', class: 'password-page__form' -%}
      {%- if form.errors -%}
        <div class="password-page__alert" role="alert" id="PasswordError-{{ section.id }}">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      <label class="visually-hidden" for="Password-{{ section.id }}">{{ 'password.password' | t }}</label>
      <div class="password-page__field">
        <svg class="password-page__field-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
          <rect x="4" y="9" width="12" height="9" rx="2" stroke="currentColor" stroke-width="1.6"/>
          <path d="M7 9V6.5a3 3 0 0 1 6 0V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
        <input
          type="password"
          name="password"
          id="Password-{{ section.id }}"
          autocomplete="current-password"
          placeholder="{{ 'password.placeholder' | t }}"
          required
          {% if form.errors %}
            aria-invalid="true"
            aria-describedby="PasswordError-{{ section.id }}"
          {% endif %}
        >
        <button
          type="button"
          class="password-page__toggle"
          aria-controls="Password-{{ section.id }}"
          aria-pressed="false"
          aria-label="{{ 'password.show' | t }}"
          data-password-toggle
          data-label-show="{{ 'password.show' | t }}"
          data-label-hide="{{ 'password.hide' | t }}"
        >
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
            <path d="M1.5 10S4.5 4 10 4s8.5 6 8.5 6-3 6-8.5 6-8.5-6-8.5-6Z" stroke="currentColor" stroke-width="1.6"/>
            <circle cx="10" cy="10" r="2.6" stroke="currentColor" stroke-width="1.6"/>
            <path class="password-page__toggle-slash" d="M3 17 17 3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          </svg>
        </button>
      </div>

      <button type="submit" class="password-page__submit">
        <span>{{ 'password.enter' | t }}</span>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
          <circle cx="12" cy="12" r="10.5" stroke="currentColor" stroke-width="1.5"/>
          <path d="M8 12h8m-3-3.5L16.5 12 13 15.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    {%- endform -%}

    {%- if section.settings.show_signup -%}
      {%- form 'customer', class: 'password-page__signup', id: 'PasswordSignup' -%}
        <input type="hidden" name="contact[tags]" value="prospect,password page">
        <p class="password-page__signup-title">{{ signup_heading | escape }}</p>

        {%- if form.posted_successfully? -%}
          <p class="password-page__notice" role="status" tabindex="-1">{{ 'password.signup.success' | t }}</p>
        {%- else -%}
          {%- if form.errors -%}
            <div class="password-page__alert" role="alert" id="SignupError-{{ section.id }}">
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}
          <div class="password-page__signup-row">
            <label class="visually-hidden" for="SignupEmail-{{ section.id }}">{{ 'password.signup.label' | t }}</label>
            <input
              type="email"
              name="contact[email]"
              id="SignupEmail-{{ section.id }}"
              value="{{ form.email }}"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              spellcheck="false"
              placeholder="{{ 'password.signup.label' | t }}"
              required
              {% if form.errors %}
                aria-invalid="true"
                aria-describedby="SignupError-{{ section.id }}"
              {% endif %}
            >
            <button type="submit">{{ 'password.signup.submit' | t }}</button>
          </div>
        {%- endif -%}
      {%- endform -%}
    {%- endif -%}

    <div class="password-page__footer">
      <p class="password-page__heart" aria-hidden="true">
        <svg viewBox="0 0 24 24" focusable="false"><path d="M12 21s-7.5-4.6-9.6-9.4C.9 8 3.1 4 6.9 4c2.1 0 3.6 1.2 5.1 3 1.5-1.8 3-3 5.1-3 3.8 0 6 4 4.5 7.6C19.5 16.4 12 21 12 21Z" fill="currentColor"/></svg>
      </p>
      <p class="password-page__footer-text">{{ footer_text | escape }}</p>
      <p class="password-page__admin">{{ 'password.admin_html' | t }}</p>
      <p class="password-page__powered">{{ powered_by_link }}</p>
    </div>
  </main>
</div>

{% stylesheet %}
  .password-page {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 100vh;
    min-height: 100svh;
    padding: 4rem 1rem;
    overflow: hidden;
    background: var(--pw-bg);
    color: var(--pw-text);
    font-family: var(--font-body-family);
    text-align: center;
  }

  .password-page__bg {
    position: absolute;
    inset: 0;
  }

  .password-page__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .password-page__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--pw-bg);
    opacity: var(--pw-overlay);
  }

  .password-page__decor {
    position: absolute;
    inset: 0;
    color: var(--pw-accent);
    pointer-events: none;
  }

  .password-page__wave {
    position: absolute;
    width: clamp(9rem, 26vw, 20rem);
    height: auto;
  }

  .password-page__wave--top {
    top: 0;
    left: 0;
  }

  .password-page__wave--bottom {
    right: 0;
    bottom: 0;
    transform: rotate(180deg);
  }

  .password-page__branch {
    position: absolute;
    top: 0;
    right: clamp(0.5rem, 4vw, 3rem);
    width: clamp(4.5rem, 10vw, 8.5rem);
    height: auto;
  }

  .password-page__sparkle {
    position: absolute;
    width: 1rem;
    height: 1rem;
    opacity: 0.8;
  }

  .password-page__sparkle--1 { top: 22%; left: 12%; }
  .password-page__sparkle--2 { top: 36%; right: 14%; width: 0.75rem; height: 0.75rem; }
  .password-page__sparkle--3 { bottom: 18%; left: 20%; width: 0.625rem; height: 0.625rem; }

  .password-page__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 34rem;
  }

  .password-page__brand {
    margin-bottom: 1.5rem;
  }

  .password-page__logo {
    display: block;
    width: auto;
    max-width: 10rem;
    height: auto;
    max-height: 4rem;
  }

  .password-page__shop {
    font-family: var(--font-heading-family);
    font-size: 1.25rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .password-page__art {
    width: clamp(7rem, 22vw, 9.5rem);
    height: auto;
    margin-bottom: 1.25rem;
    color: var(--pw-accent);
  }

  .password-page__heading {
    margin: 0 0 1rem;
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    font-size: clamp(2rem, 5.5vw, 3.25rem);
    line-height: 1.1;
    color: var(--pw-text);
  }

  .password-page__message {
    margin: 0;
    font-size: 1.0625rem;
    opacity: 0.85;
  }

  .password-page__message p {
    margin: 0;
  }

  .password-page__divider,
  .password-page__heart {
    display: flex;
    align-items: center;
    gap: 1rem;
    width: 100%;
    max-width: 22rem;
    margin: 1.75rem 0;
    color: var(--pw-accent);
  }

  .password-page__divider::before,
  .password-page__divider::after,
  .password-page__heart::before,
  .password-page__heart::after {
    content: '';
    flex: 1;
    height: 1px;
    background: currentColor;
    opacity: 0.45;
  }

  .password-page__divider span {
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .password-page__form {
    display: grid;
    gap: 1rem;
    width: 100%;
  }

  .password-page__field {
    position: relative;
    display: flex;
    align-items: center;
  }

  .password-page__field-icon {
    position: absolute;
    left: 1.25rem;
    width: 1.25rem;
    height: 1.25rem;
    color: var(--pw-accent);
    pointer-events: none;
  }

  .password-page__field input,
  .password-page__signup-row input {
    width: 100%;
    min-height: 3.5rem;
    padding: 0 3.5rem;
    border: 1.5px solid var(--pw-accent);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.6);
    color: var(--pw-text);
    font: inherit;
    font-size: 1rem;
  }

  .password-page__field input:focus-visible,
  .password-page__signup-row input:focus-visible {
    outline: 2px solid var(--pw-accent);
    outline-offset: 3px;
  }

  .password-page__toggle {
    position: absolute;
    right: 0.75rem;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--pw-accent);
    cursor: pointer;
  }

  .password-page__toggle svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .password-page__toggle[aria-pressed='true'] .password-page__toggle-slash {
    display: none;
  }

  .password-page__submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    min-height: 3.5rem;
    padding: 0 2rem;
    border: 0;
    border-radius: 999px;
    background: var(--pw-accent);
    color: var(--pw-accent-text);
    font: inherit;
    font-size: 1.0625rem;
    font-weight: 600;
    cursor: pointer;
    transition: filter 0.2s ease;
  }

  .password-page__submit:hover {
    filter: brightness(1.1);
  }

  .password-page__submit:focus-visible,
  .password-page__toggle:focus-visible,
  .password-page__signup-row button:focus-visible {
    outline: 2px solid var(--pw-text);
    outline-offset: 3px;
  }

  .password-page__submit svg {
    width: 1.5rem;
    height: 1.5rem;
  }

  .password-page__alert,
  .password-page__notice {
    margin: 0;
    padding: 0.75rem 1rem;
    border-radius: 0.75rem;
    font-size: 0.9375rem;
    text-align: left;
  }

  .password-page__alert {
    border: 1px solid #b3261e;
    background: rgba(179, 38, 30, 0.06);
    color: #8c1d18;
  }

  .password-page__alert ul {
    margin: 0;
    padding-left: 1.125rem;
  }

  .password-page__notice {
    border: 1px solid var(--pw-accent);
    text-align: center;
  }

  .password-page__signup {
    display: grid;
    gap: 0.75rem;
    width: 100%;
    margin-top: 2rem;
  }

  .password-page__signup-title {
    margin: 0;
    font-size: 0.9375rem;
  }

  .password-page__signup-row {
    position: relative;
    display: flex;
  }

  .password-page__signup-row input {
    min-height: 3rem;
    padding: 0 8rem 0 1.25rem;
    font-size: 0.9375rem;
  }

  .password-page__signup-row button {
    position: absolute;
    top: 0.3125rem;
    right: 0.3125rem;
    bottom: 0.3125rem;
    padding: 0 1.25rem;
    border: 0;
    border-radius: 999px;
    background: var(--pw-accent);
    color: var(--pw-accent-text);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
  }

  .password-page__footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  .password-page__heart {
    margin-bottom: 0.5rem;
  }

  .password-page__heart svg {
    width: 1.125rem;
    height: 1.125rem;
  }

  .password-page__footer-text {
    margin: 0 0 1.5rem;
    color: var(--pw-accent);
    font-size: 0.875rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .password-page__admin,
  .password-page__powered {
    margin: 0;
    font-size: 0.8125rem;
    opacity: 0.75;
  }

  .password-page__admin a,
  .password-page__powered a {
    color: inherit;
  }

  @media screen and (max-width: 749px) {
    .password-page {
      padding: 6rem 1.25rem 7rem;
    }

    .password-page__sparkle--1,
    .password-page__sparkle--2 {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .password-page__submit {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  document.querySelectorAll('[data-password-toggle]').forEach((button) => {
    const input = document.getElementById(button.getAttribute('aria-controls'));
    if (!input) return;
    button.addEventListener('click', () => {
      const show = input.type === 'password';
      input.type = show ? 'text' : 'password';
      button.setAttribute('aria-pressed', String(show));
      button.setAttribute('aria-label', show ? button.dataset.labelHide : button.dataset.labelShow);
    });
  });
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.password.name",
  "class": "password-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_logo",
      "label": "t:sections.password.settings.show_logo.label",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.password.settings.heading.label",
      "info": "t:sections.password.settings.heading.info"
    },
    {
      "type": "richtext",
      "id": "message",
      "label": "t:sections.password.settings.message.label",
      "info": "t:sections.password.settings.message.info"
    },
    {
      "type": "text",
      "id": "divider_text",
      "label": "t:sections.password.settings.divider_text.label"
    },
    {
      "type": "text",
      "id": "footer_text",
      "label": "t:sections.password.settings.footer_text.label"
    },
    {
      "type": "header",
      "content": "t:sections.password.settings.signup_header.content"
    },
    {
      "type": "checkbox",
      "id": "show_signup",
      "label": "t:sections.password.settings.show_signup.label",
      "default": true
    },
    {
      "type": "text",
      "id": "signup_heading",
      "label": "t:sections.password.settings.signup_heading.label",
      "visible_if": "{{ section.settings.show_signup }}"
    },
    {
      "type": "header",
      "content": "t:sections.password.settings.style_header.content"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:sections.password.settings.background_image.label"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:sections.password.settings.overlay_opacity.label",
      "info": "t:sections.password.settings.overlay_opacity.info",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 70,
      "visible_if": "{{ section.settings.background_image != blank }}"
    },
    {
      "type": "checkbox",
      "id": "show_decorations",
      "label": "t:sections.password.settings.show_decorations.label",
      "default": true
    },
    {
      "type": "color",
      "id": "background",
      "label": "t:sections.password.settings.background.label",
      "default": "#FBF3EA"
    },
    {
      "type": "color",
      "id": "text",
      "label": "t:sections.password.settings.text.label",
      "default": "#4A2412"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "t:sections.password.settings.accent.label",
      "default": "#9C4A1A"
    },
    {
      "type": "color",
      "id": "accent_text",
      "label": "t:sections.password.settings.accent_text.label",
      "default": "#FFFFFF"
    }
  ]
}
{% endschema %}
