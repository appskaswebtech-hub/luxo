{%- liquid
  assign collection = collections[section.settings.collection]
  assign products_per_row = section.settings.products_per_row
  assign layout_type = section.settings.layout_type
  assign container_width = section.settings.container_width
  assign image_ratio = section.settings.image_ratio
  assign image_fit = section.settings.image_fit
  
  assign use_custom = section.settings.enable_custom_design
  
  if use_custom
    assign bg_color = section.settings.custom_bg_color
    assign text_color = section.settings.custom_text_color
    assign accent_color = section.settings.custom_accent_color
    
    assign heading_font = section.settings.custom_heading_font
    assign heading_size = section.settings.custom_heading_size
    assign title_color = section.settings.custom_title_color
    assign title_size = section.settings.custom_title_size
    
    assign body_font = section.settings.custom_body_font
    assign body_size = section.settings.custom_body_size
    assign price_size = section.settings.custom_price_size
  else
    assign bg_color = section.settings.default_bg_color
    assign text_color = section.settings.default_text_color
    assign accent_color = section.settings.default_accent_color
    
    assign heading_font = 'var(--font-heading-family)'
    assign heading_size = 'var(--font-heading-size)'
    assign title_color = text_color
    assign title_size = 'calc(var(--font-heading-size) * 0.6)'
    
    assign body_font = 'var(--font-body-family)'
    assign body_size = 'var(--font-body-size)'
    assign price_size = 'calc(var(--font-body-size) * 1.25)'
  endif

  capture placeholder_class
    echo 'featured-collection-' | append: section.id | append: '__product-image featured-collection-' | append: section.id | append: '__placeholder'
  endcapture

  capture form_class
    echo 'featured-collection-' | append: section.id | append: '__product-form'
  endcapture
-%}

<section 
  class="featured-collection-{{ section.id }}" 
  id="FeaturedCollection-{{ section.id }}"
  style="
    background-color: {{ bg_color }};
    --fc-accent-color: {{ accent_color }};
    --fc-text-color: {{ text_color }};
    --fc-bg-color: {{ bg_color }};
    --fc-heading-font: {{ heading_font }};
    --fc-heading-size: {{ heading_size }};
    --fc-title-size: {{ title_size }};
    --fc-title-color: {{ title_color }};
    --fc-body-font: {{ body_font }};
    --fc-body-size: {{ body_size }};
    --fc-price-size: {{ price_size }};
  "
>
  <div class="featured-collection-{{ section.id }}__container {% if container_width == 'full' %}featured-collection-{{ section.id }}__container--full{% else %}featured-collection-{{ section.id }}__container--page{% endif %}" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
    
    <div class="featured-collection-{{ section.id }}__header">
      <div class="featured-collection-{{ section.id }}__header-text">
        {%- if section.settings.heading != blank -%}
          <h2 class="featured-collection-{{ section.id }}__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="featured-collection-{{ section.id }}__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
      
      {%- if section.settings.show_view_all and collection != blank -%}
        <a href="{{ collection.url }}" class="featured-collection-{{ section.id }}__view-all">
          {{ section.settings.view_all_text | default: 'View All' }}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      {%- endif -%}
    </div>

    {%- if collection != blank and collection.products.size > 0 -%}
      <div class="featured-collection-{{ section.id }}__wrapper {% if layout_type == 'slider' %}featured-collection-{{ section.id }}__is-slider{% endif %}" data-layout="{{ layout_type }}">
        <div class="featured-collection-{{ section.id }}__track {% if layout_type == 'slider' %}featured-collection-{{ section.id }}__slider-track{% else %}featured-collection-{{ section.id }}__grid featured-collection-{{ section.id }}__columns-{{ products_per_row }}{% endif %}" id="FeaturedTrack-{{ section.id }}">
          
          {%- for product in collection.products limit: section.settings.products_limit -%}
            <div class="featured-collection-{{ section.id }}__product-wrapper">
              <div class="featured-collection-{{ section.id }}__product-card">
                 
                <div class="featured-collection-{{ section.id }}__product-top">
                  {%- if section.settings.show_vendor -%}
                    <span class="featured-collection-{{ section.id }}__product-badge">
                      {%- liquid
                        assign badge_text = product.vendor
                        if badge_text == blank
                          assign badge_text = product.type
                        endif
                        if badge_text == blank and product.tags.size > 0
                          assign badge_text = product.tags.first
                        endif
                        if badge_text == blank
                          assign badge_text = 'Product'
                        endif
                      -%}
                      {%- if product.available == false -%}
                        Sold Out
                      {%- else -%}
                        {{ badge_text | escape }}
                      {%- endif -%}
                    </span>
                  {%- endif -%}
                  
                  <span class="featured-collection-{{ section.id }}__product-sku">
                    {%- if product.selected_or_first_available_variant.sku != blank -%}
                      Style No. {{ product.selected_or_first_available_variant.sku }}
                    {%- else -%}
                      {{ product.type | default: 'Collection' | escape }}
                    {%- endif -%}
                  </span>
                </div>

                <a href="{{ product.url }}" class="featured-collection-{{ section.id }}__image-wrapper featured-collection-{{ section.id }}__ratio-{{ image_ratio }}">
                  {%- if product.featured_image != blank -%}
                    <img 
                      src="{{ product.featured_image | image_url: width: 800 }}" 
                      alt="{{ product.featured_image.alt | escape }}" 
                      class="featured-collection-{{ section.id }}__product-image featured-collection-{{ section.id }}__fit-{{ image_fit }}"
                      loading="lazy"
                      width="800"
                      height="800"
                    >
                    {%- if section.settings.card_hover_image and product.images[1] != blank -%}
                      <img 
                        src="{{ product.images[1] | image_url: width: 800 }}" 
                        alt="{{ product.images[1].alt | escape }}" 
                        class="featured-collection-{{ section.id }}__product-image-hover featured-collection-{{ section.id }}__fit-{{ image_fit }}"
                        loading="lazy"
                        width="800"
                        height="800"
                      >
                    {%- endif -%}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: placeholder_class }}
                  {%- endif -%}
                  
                  <span class="featured-collection-{{ section.id }}__corner featured-collection-{{ section.id }}__corner--tl"></span>
                  <span class="featured-collection-{{ section.id }}__corner featured-collection-{{ section.id }}__corner--tr"></span>
                  <span class="featured-collection-{{ section.id }}__corner featured-collection-{{ section.id }}__corner--bl"></span>
                  <span class="featured-collection-{{ section.id }}__corner featured-collection-{{ section.id }}__corner--br"></span>
                </a>

                <div class="featured-collection-{{ section.id }}__product-body">
                  <h3 class="featured-collection-{{ section.id }}__product-title">
                    <a href="{{ product.url }}">{{ product.title }}<span>.</span></a>
                  </h3>
                  
                  <p class="featured-collection-{{ section.id }}__product-desc">
                    {%- if product.description != blank -%}
                      {{ product.description | strip_html | truncate: 90 }}
                    {%- else -%}
                      Premium quality product crafted with excellence and style.
                    {%- endif -%}
                  </p>
                </div>

                <div class="featured-collection-{{ section.id }}__product-bottom">
                  <span class="featured-collection-{{ section.id }}__product-price">{{ product.price | money }}</span>
                  
                  {%- form 'product', product, class: form_class -%}
                    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                    <button type="submit" name="add" class="featured-collection-{{ section.id }}__add-btn" {% if product.available == false %}disabled{% endif %}>
                      <span>{% if product.available %}Add to Cart{% else %}Sold Out{% endif %}</span>
                      <svg width="13" height="5" viewBox="0 0 13 5" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M9.45052 4.21172C9.63052 3.82772 9.80452 3.49172 9.97252 3.20372C10.1525 2.91572 10.3265 2.67572 10.4945 2.48372H0.000515878V1.72772H10.4945C10.3265 1.52372 10.1525 1.27772 9.97252 0.989718C9.80452 0.701718 9.63052 0.371718 9.45052 -0.000281632H10.0805C10.8365 0.875719 11.6285 1.52372 12.4565 1.94372V2.26772C11.6285 2.67572 10.8365 3.32372 10.0805 4.21172H9.45052Z" fill="currentColor"></path>
                      </svg>
                    </button>
                  {%- endform -%}
                </div>

              </div>
            </div>
          {%- endfor -%}
          
        </div>
        
        {%- if layout_type == 'slider' -%}
          <button class="featured-collection-{{ section.id }}__slider-prev" aria-label="Previous" data-slider-prev="{{ section.id }}">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          <button class="featured-collection-{{ section.id }}__slider-next" aria-label="Next" data-slider-next="{{ section.id }}">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        {%- endif -%}
      </div>
      
    {%- else -%}
      <p class="featured-collection-{{ section.id }}__empty-text">Please select a collection or add products to display here.</p>
    {%- endif -%}

  </div>
</section>

{% style %}
  .featured-collection-{{ section.id }} {
    width: 100vw;
    max-width: 100vw;
    margin-left: -50vw;
    margin-right: -50vw;
    left: 50%;
    right: 50%;
    position: relative;
    box-sizing: border-box;
    overflow: hidden;
    font-family: var(--fc-body-font), -apple-system, BlinkMacSystemFont, sans-serif;
  }

  .featured-collection-{{ section.id }}__container {
    width: 100%;
    margin: 0 auto;
    box-sizing: border-box;
  }

  .featured-collection-{{ section.id }}__container--full {
    max-width: 100%;
    padding-left: 2%;
    padding-right: 2%;
  }

  .featured-collection-{{ section.id }}__container--page {
    max-width: var(--page-width, 1400px);
    padding-left: var(--page-margin, 20px);
    padding-right: var(--page-margin, 20px);
  }

  .featured-collection-{{ section.id }}__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 3rem;
    gap: 20px;
    flex-wrap: wrap;
  }

  .featured-collection-{{ section.id }}__header-text {
    max-width: 700px;
  }

  .featured-collection-{{ section.id }}__heading {
    font-family: var(--fc-heading-font), sans-serif;
    font-size: var(--fc-heading-size);
    font-weight: 900;
    color: var(--fc-text-color);
    margin: 0 0 10px 0;
    text-transform: uppercase;
    line-height: 1.1;
    letter-spacing: -1px;
  }

  .featured-collection-{{ section.id }}__subheading {
    font-size: var(--fc-body-size);
    color: var(--fc-text-color);
    opacity: 0.7;
    margin: 0;
    line-height: 1.5;
  }

  .featured-collection-{{ section.id }}__view-all {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    background-color: transparent;
    color: var(--fc-text-color);
    border: 1px solid var(--fc-text-color);
    text-decoration: none;
    font-weight: 700;
    font-size: calc(var(--fc-body-size) * 0.85);
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: all 0.3s ease;
    white-space: nowrap;
  }

  .featured-collection-{{ section.id }}__view-all:hover {
    background-color: var(--fc-accent-color);
    border-color: var(--fc-accent-color);
    color: #fff;
  }

  .featured-collection-{{ section.id }}__wrapper {
    position: relative;
    width: 100%;
  }

  .featured-collection-{{ section.id }}__grid {
    display: grid;
    gap: 2rem;
  }

  .featured-collection-{{ section.id }}__columns-3 {
    grid-template-columns: repeat(3, 1fr);
  }

  .featured-collection-{{ section.id }}__columns-4 {
    grid-template-columns: repeat(4, 1fr);
  }

  .featured-collection-{{ section.id }}__is-slider .featured-collection-{{ section.id }}__slider-track {
    display: flex;
    gap: 2rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-bottom: 10px;
  }
  
  .featured-collection-{{ section.id }}__is-slider .featured-collection-{{ section.id }}__slider-track::-webkit-scrollbar {
    display: none;
  }

  .featured-collection-{{ section.id }}__is-slider .featured-collection-{{ section.id }}__product-wrapper {
    flex: 0 0 calc(33.333% - 1.33rem);
    scroll-snap-align: start;
  }

  .featured-collection-{{ section.id }}__product-card {
    max-width: 100%;
    background-color: color-mix(in srgb, var(--fc-bg-color) 90%, black 10%);
    border: 1px solid hsl(0, 0%, 4%);
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .featured-collection-{{ section.id }}__product-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 30px rgba(0,0,0,0.1);
  }

  .featured-collection-{{ section.id }}__product-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    padding: 0.675rem 1.25rem;
    border-bottom: 1px solid hsl(0, 0%, 4%);
  }

  .featured-collection-{{ section.id }}__product-top span {
    font-weight: 400;
    font-size: 0.675rem;
    line-height: 1.3;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    color: hsl(49, 5%, 40%);
  }

  .featured-collection-{{ section.id }}__product-badge {
    font-weight: 500;
    letter-spacing: 2.16px;
    color: var(--fc-accent-color);
    padding-left: 0.875rem;
    position: relative;
  }

  .featured-collection-{{ section.id }}__product-badge::before {
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    content: "";
    width: 0.375rem;
    height: 0.375rem;
    background-color: var(--fc-accent-color);
  }

  .featured-collection-{{ section.id }}__image-wrapper {
    display: block;
    width: 100%;
    position: relative;
    overflow: hidden;
    background-color: #f7f7f7;
  }

  .featured-collection-{{ section.id }}__ratio-square { aspect-ratio: 1 / 1; }
  .featured-collection-{{ section.id }}__ratio-portrait { aspect-ratio: 4 / 5; }
  .featured-collection-{{ section.id }}__ratio-landscape { aspect-ratio: 16 / 9; }

  .featured-collection-{{ section.id }}__product-image,
  .featured-collection-{{ section.id }}__product-image-hover {
    width: 100%;
    height: 100%;
    transition: transform 0.5s ease, opacity 0.5s ease;
  }

  .featured-collection-{{ section.id }}__product-image-hover {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
  }

  .featured-collection-{{ section.id }}__product-card:hover .featured-collection-{{ section.id }}__product-image:not(:only-child) {
    opacity: 0;
  }

  .featured-collection-{{ section.id }}__product-card:hover .featured-collection-{{ section.id }}__product-image-hover {
    opacity: 1;
  }

  .featured-collection-{{ section.id }}__product-card:hover .featured-collection-{{ section.id }}__product-image:only-child {
    transform: scale(1.05);
  }

  .featured-collection-{{ section.id }}__fit-cover { object-fit: cover; }
  .featured-collection-{{ section.id }}__fit-contain { object-fit: contain; }

  .featured-collection-{{ section.id }}__placeholder {
    background-color: #f0f0f0;
    fill: #a0a0a0;
  }

  .featured-collection-{{ section.id }}__corner {
    position: absolute;
    width: 0.75rem;
    height: 0.75rem;
    border-style: solid;
    border-color: #0A0A0A;
    z-index: 2;
  }

  .featured-collection-{{ section.id }}__corner--tl { left: 0.5rem; top: 0.5rem; border-width: 1px 0px 0px 1px; }
  .featured-collection-{{ section.id }}__corner--tr { right: 0.5rem; top: 0.5rem; border-width: 1px 1px 0px 0px; }
  .featured-collection-{{ section.id }}__corner--bl { left: 0.5rem; bottom: 0.5rem; border-width: 0px 0px 1px 1px; }
  .featured-collection-{{ section.id }}__corner--br { right: 0.5rem; bottom: 0.5rem; border-width: 0px 1px 1px 0px; }

  .featured-collection-{{ section.id }}__product-body {
    padding: 1.25rem;
    border-block: 1px solid hsl(0, 0%, 4%);
    flex-grow: 1;
  }

  .featured-collection-{{ section.id }}__product-title {
    font-family: var(--fc-heading-font), sans-serif;
    font-weight: 900;
    font-size: var(--fc-title-size);
    color: var(--fc-title-color);
    line-height: 1.1;
    letter-spacing: -0.8px;
    text-transform: uppercase;
    position: relative;
    padding-bottom: 0.5rem;
    margin-bottom: 0.5rem;
    margin-top: 0;
  }

  .featured-collection-{{ section.id }}__product-title a {
    text-decoration: none;
    color: inherit;
  }

  .featured-collection-{{ section.id }}__product-title span {
    color: var(--fc-accent-color);
  }

  .featured-collection-{{ section.id }}__product-title::after {
    position: absolute;
    bottom: 0;
    left: 0;
    content: "";
    width: 34px;
    height: 3px;
    background: var(--fc-accent-color);
  }

  .featured-collection-{{ section.id }}__product-desc {
    font-size: var(--fc-body-size);
    line-height: 1.5;
    color: hsl(49, 5%, 40%);
    margin: 0;
  }

  .featured-collection-{{ section.id }}__product-bottom {
    display: flex;
    justify-content: space-between;
    align-items: stretch;
    gap: 0.5rem;
  }

  .featured-collection-{{ section.id }}__product-price {
    font-weight: 900;
    font-size: var(--fc-price-size);
    color: var(--fc-title-color);
    line-height: 1;
    letter-spacing: -0.64px;
    padding: 1.25rem;
    display: inline-block;
    white-space: nowrap;
  }

  .featured-collection-{{ section.id }}__product-form {
    display: flex;
    flex: 1;
  }

  .featured-collection-{{ section.id }}__add-btn {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    padding: 1.25rem 1rem;
    width: 100%;
    font-family: inherit;
    font-weight: 500;
    font-size: calc(var(--fc-body-size) * 0.8);
    line-height: 1;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    color: #ffffff;
    background-color: hsl(0, 0%, 4%);
    border: none;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .featured-collection-{{ section.id }}__add-btn:hover {
    background-color: var(--fc-accent-color);
  }

  .featured-collection-{{ section.id }}__add-btn:disabled {
    background-color: #666;
    cursor: not-allowed;
  }

  .featured-collection-{{ section.id }}__slider-prev,
  .featured-collection-{{ section.id }}__slider-next {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    background: #fff;
    border: 1px solid #ddd;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    transition: all 0.3s ease;
  }

  .featured-collection-{{ section.id }}__slider-prev:hover,
  .featured-collection-{{ section.id }}__slider-next:hover {
    background: var(--fc-accent-color);
    color: #fff;
    border-color: var(--fc-accent-color);
  }

  .featured-collection-{{ section.id }}__slider-prev { left: -20px; }
  .featured-collection-{{ section.id }}__slider-next { right: -20px; }

  .featured-collection-{{ section.id }}__empty-text {
    text-align: center;
    padding: 40px;
    font-size: var(--fc-body-size);
    color: var(--fc-text-color);
  }

  @media (max-width: 1100px) {
    .featured-collection-{{ section.id }}__is-slider .featured-collection-{{ section.id }}__product-wrapper {
      flex: 0 0 calc(50% - 1rem);
    }
  }

  @media (max-width: 991px) {
    .featured-collection-{{ section.id }}__columns-4,
    .featured-collection-{{ section.id }}__columns-3 {
      grid-template-columns: repeat(2, 1fr);
    }
    .featured-collection-{{ section.id }}__slider-prev { left: 0; }
    .featured-collection-{{ section.id }}__slider-next { right: 0; }
  }

  @media (max-width: 768px) {
    .featured-collection-{{ section.id }}__header {
      flex-direction: column;
      align-items: flex-start;
    }
    .featured-collection-{{ section.id }}__columns-4,
    .featured-collection-{{ section.id }}__columns-3 {
      grid-template-columns: 1fr;
    }
    .featured-collection-{{ section.id }}__is-slider .featured-collection-{{ section.id }}__product-wrapper {
      flex: 0 0 85%;
    }
  }
{% endstyle %}

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const sectionId = "{{ section.id }}";
    const track = document.getElementById('FeaturedTrack-' + sectionId);
    const prevBtn = document.querySelector('[data-slider-prev="' + sectionId + '"]');
    const nextBtn = document.querySelector('[data-slider-next="' + sectionId + '"]');

    if (track && prevBtn && nextBtn) {
      const scrollAmount = track.clientWidth * 0.8;
      
      prevBtn.addEventListener('click', () => {
        track.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
      });
      
      nextBtn.addEventListener('click', () => {
        track.scrollBy({ left: scrollAmount, behavior: 'smooth' });
      });
    }
  });
</script>

{% schema %}
{
  "name": "Featured Collection",
  "tag": "section",
  "class": "section-featured-collection-cards",
  "settings": [
    {
      "type": "header",
      "content": "Section Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Products"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover our latest premium collection crafted for you."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },
    {
      "type": "range",
      "id": "products_limit",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Maximum products to show",
      "default": 8
    },
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container Width",
      "options": [
