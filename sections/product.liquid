<script>
  document.addEventListener('DOMContentLoaded', function () {
    const mainImage = document.getElementById('MainImage-{{ section.id }}');
    const thumbnails = document.querySelectorAll('.main-product-{{ section.id }}__thumbnail');
    const currentIndexSpan = document.getElementById('CurrentImageIndex-{{ section.id }}');
    
    if (mainImage && thumbnails.length > 0) {
      thumbnails.forEach((thumb, index) => {
        thumb.addEventListener('click', function () {
          const targetSrc = this.getAttribute('data-target');
          if (targetSrc) {
            mainImage.src = targetSrc;
            thumbnails.forEach(t => t.classList.remove('is-active'));
            this.classList.add('is-active');
            if(currentIndexSpan) currentIndexSpan.textContent = index + 1;
          }
        });
      });
    }

    const form = document.getElementById('ProductForm-{{ section.id }}');
    const variantRadios = document.querySelectorAll('.main-product-{{ section.id }}__variant-radio');
    const mainVariantInput = form.querySelector('input[name="id"]');

    if (variantRadios.length > 0 && mainVariantInput) {
      variantRadios.forEach(radio => {
        radio.addEventListener('change', function() {
          if(this.checked) {
            mainVariantInput.value = this.value;
          }
        });
      });
    }

    const qtyBtns = document.querySelectorAll('.main-product-{{ section.id }}__qty-btn');
    const qtyInput = document.querySelector('.main-product-{{ section.id }}__qty-input');

    if (qtyBtns.length > 0 && qtyInput) {
      qtyBtns.forEach(btn => {
        btn.addEventListener('click', function () {
          let currentQty = parseInt(qtyInput.value) || 1;
          if (this.getAttribute('data-qty') === 'minus' && currentQty > 1) {
            currentQty--;
          } else if (this.getAttribute('data-qty') === 'plus') {
            currentQty++;
          }
          qtyInput.value = currentQty;
        });
      });
    }

    const stickyBar = document.getElementById('StickyATC-{{ section.id }}');
    const mainBuyBtn = document.querySelector('.main-product-{{ section.id }}__add-to-cart-btn');

    if (stickyBar && mainBuyBtn) {
      window.addEventListener('scroll', function() {
        const btnRect = mainBuyBtn.getBoundingClientRect();
        if (btnRect.bottom < 0) {
          stickyBar.classList.add('is-active');
        } else {
          stickyBar.classList.remove('is-active');
        }
      });
    }

    const sizeChartBtns = document.querySelectorAll('[data-open-sizechart]');
    const closeModalBtns = document.querySelectorAll('[data-close-modal]');

    sizeChartBtns.forEach(btn => {
      btn.addEventListener('click', function() {
        const modalId = this.getAttribute('data-open-sizechart');
        const modal = document.getElementById(modalId);
        if (modal) modal.classList.add('is-active');
      });
    });

    closeModalBtns.forEach(btn => {
      btn.addEventListener('click', function() {
        const modalId = this.getAttribute('data-close-modal');
        const modal = document.getElementById(modalId);
        if (modal) modal.classList.remove('is-active');
      });
    });

    window.addEventListener('click', function(e) {
      if (e.target.classList.contains('main-product-{{ section.id }}__modal-overlay')) {
        e.target.classList.remove('is-active');
      }
    });
  });
</script>

