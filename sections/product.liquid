{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign form_id = 'ProductForm-' | append: section.id

  capture main_img_class
    echo 'main-product-' | append: section.id | append: '__main-image'
  endcapture
-%}

<section 
  class="main-product-{{ section.id }}" 
  id="MainProduct-{{ section.id }}"
  style="
    --mp-bg: {{ section.settings.background_color }};
    --mp-text: {{ section.settings.text_color }};
    --mp-accent: {{ section.settings.accent_color }};
    --mp-btn-bg: {{ section.settings.button_bg_color }};
    --mp-btn-text: {{ section.settings.button_text_color }};
    --mp-border: {{ section.settings.border_color }};
    --mp-soft-bg: {{ section.settings.soft_background }};
    --mp-card-border-width: {{ section.settings.card_border_width }}px;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="main-product-{{ section.id }}__container">
    <div class="main-product-{{ section.id }}__layout">
      
      <div class="main-product-{{ section.id }}__left-column">
        <div class="main-product-{{ section.id }}__card-frame main-product-{{ section.id }}__gallery-card">
          <div class="main-product-{{ section.id }}__gallery-wrapper main-product-{{ section.id }}__thumbs-{{ section.settings.thumbnail_position | default: 'right' }}">
            
            <div class="main-product-{{ section.id }}__main-image-wrapper">
              {%- if product.tags.size > 0 -%}
                <span class="main-product-{{ section.id }}__main-badge">{{ product.tags.first | upcase }}</span>
              {%- endif -%}
              
              {%- if product.images.size > 1 -%}
                <div class="main-product-{{ section.id }}__image-counter">
                  <span id="CurrentImageIndex-{{ section.id }}">1</span> / {{ product.images.size }}
                </div>
              {%- endif -%}

              {%- if product.images.size > 0 -%}
                <img 
                  src="{{ product.images.first | image_url: width: 1000 }}" 
                  alt="{{ product.title | escape }}" 
                  class="{{ main_img_class }}" 
                  id="MainImage-{{ section.id }}"
                  loading="eager"
                >
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: main_img_class }}
              {%- endif -%}
            </div>

            {%- if product.images.size > 1 -%}
              <div class="main-product-{{ section.id }}__thumbnails-container">
                {%- for image in product.images limit: 5 -%}
                  <button 
                    class="main-product-{{ section.id }}__thumbnail{% if forloop.first %} is-active{% endif %}" 
                    data-target="{{ image | image_url: width: 1000 }}"
                    type="button"
                    aria-label="{{ 'products.view_image' | t: index: forloop.index }}"
                  >
                    <img src="{{ image | image_url: width: 200 }}" alt="" loading="lazy">
                  </button>
                {%- endfor -%}
              </div>
            {%- endif -%}

          </div>
        </div>

        {%- for block in section.blocks -%}
          {%- if block.type == 'customer_review' -%}
            <div class="main-product-{{ section.id }}__card-frame main-product-{{ section.id }}__review-card" {{ block.shopify_attributes }}>
              <div class="main-product-{{ section.id }}__review-header">
                {%- if block.settings.customer_image != blank -%}
                  <img src="{{ block.settings.customer_image | image_url: width: 100 }}" class="main-product-{{ section.id }}__reviewer-img" alt="{{ block.settings.customer_name | escape }}" loading="lazy">
                {%- else -%}
                  <div class="main-product-{{ section.id }}__reviewer-placeholder"></div>
                {%- endif -%}
                <div class="main-product-{{ section.id }}__reviewer-info">
                  <div class="main-product-{{ section.id }}__reviewer-name">
                    {{ block.settings.customer_name }}
                    <span class="main-product-{{ section.id }}__verified-badge">✓ {{ 'products.verified' | t }}</span>
                  </div>
                  <div class="main-product-{{ section.id }}__review-stars">★★★★★</div>
                </div>
              </div>
              <h4 class="main-product-{{ section.id }}__review-title">{{ block.settings.review_title }}</h4>
              <p class="main-product-{{ section.id }}__review-text">{{ block.settings.review_text }}</p>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="main-product-{{ section.id }}__right-column main-product-{{ section.id }}__card-frame">
        <form action="{{ routes.cart_add_url }}" method="post" id="ProductForm-{{ section.id }}" class="main-product-{{ section.id }}__form">
          <input type="hidden" name="id" value="{{ current_variant.id }}">
          
          <div class="main-product-{{ section.id }}__details-blocks-wrapper">
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                
                {%- when 'title' -%}
                  <div class="main-product-{{ section.id }}__title-block" {{ block.shopify_attributes }}>
                    <h1 class="main-product-{{ section.id }}__product-title">{{ product.title | escape }}</h1>
                    {%- if block.settings.subtitle != blank -%}
                      <p class="main-product-{{ section.id }}__product-subtitle">{{ block.settings.subtitle }}</p>
                    {%- endif -%}
                  </div>

                {%- when 'rating' -%}
                  <div class="main-product-{{ section.id }}__rating-block" {{ block.shopify_attributes }}>
                    <div class="main-product-{{ section.id }}__stars" aria-hidden="true">★★★★★</div>
                    <a href="#reviews" class="main-product-{{ section.id }}__review-link">{%- assign review_total = block.settings.review_count | plus: 0 -%}{{ 'products.reviews_count' | t: count: review_total }}</a>
                  </div>

                {%- when 'description' -%}
                  <div class="main-product-{{ section.id }}__description-block" {{ block.shopify_attributes }}>
                    <h3 class="main-product-{{ section.id }}__block-heading">{{ 'products.description' | t }}</h3>
                    {{ product.description }}
                  </div>

                {%- when 'key_benefits' -%}
                  <div class="main-product-{{ section.id }}__benefits-block" {{ block.shopify_attributes }}>
                    <h3 class="main-product-{{ section.id }}__block-heading">{{ 'products.benefits' | t }}</h3>
                    <ul class="main-product-{{ section.id }}__benefits-list">
                      {%- assign benefits = block.settings.benefits_list | split: ',' -%}
                      {%- for benefit in benefits -%}
                        <li>{{ benefit | strip }}</li>
                      {%- endfor -%}
                    </ul>
                  </div>

                {%- when 'variant_picker' -%}
                  {%- if product.has_only_default_variant -%}
                    {%- continue -%}
                  {%- endif -%}
                  <div class="main-product-{{ section.id }}__variant-block" style="margin: var(--variant-block-margin);" {{ block.shopify_attributes }}>
                    {% render 'variant-picker', product: product, form_id: form_id, section_id: section.id %}
                  </div>

                {%- when 'quantity_selector' -%}
                  <div class="main-product-{{ section.id }}__quantity-block" {{ block.shopify_attributes }}>
                    <label for="Quantity-{{ section.id }}" class="main-product-{{ section.id }}__qty-label">{{ 'products.quantity' | t }}</label>
                    <div class="main-product-{{ section.id }}__qty-wrapper">
                      <button type="button" class="main-product-{{ section.id }}__qty-btn" data-qty="minus" aria-label="{{ 'products.quantity_decrease' | t }}">-</button>
                      <input type="number" id="Quantity-{{ section.id }}" name="quantity" value="1" min="1" class="main-product-{{ section.id }}__qty-input">
                      <button type="button" class="main-product-{{ section.id }}__qty-btn" data-qty="plus" aria-label="{{ 'products.quantity_increase' | t }}">+</button>
                    </div>
                  </div>

                {%- when 'stock_alert' -%}
                  <div class="main-product-{{ section.id }}__stock-block" {{ block.shopify_attributes }}>
                    <span class="main-product-{{ section.id }}__stock-dot" aria-hidden="true"></span> {{ block.settings.stock_text }}
                  </div>

                {%- when 'selling_plan' -%}
                  <div class="main-product-{{ section.id }}__selling-plan-block" {{ block.shopify_attributes }}>
                    <div class="main-product-{{ section.id }}__subscribe-header">
                      <span class="main-product-{{ section.id }}__subscribe-title">{{ block.settings.subscribe_title }}</span>
                    </div>
                    <label class="main-product-{{ section.id }}__purchase-option">
                      <input type="radio" name="purchase_type" value="subscribe" checked>
                      <div class="main-product-{{ section.id }}__option-content">
                        <span class="main-product-{{ section.id }}__option-title">{{ 'products.subscribe_save' | t }}</span>
                        <span class="main-product-{{ section.id }}__option-price">{% render 'price', amount: product.price %}</span>
                      </div>
                    </label>
                    <div class="main-product-{{ section.id }}__subscribe-benefits">
                      <span>✓ {{ 'products.perk_shipping' | t }}</span>
                      <span>✓ {{ 'products.perk_discount' | t }}</span>
                      <span>✓ {{ 'products.perk_contract' | t }}</span>
                    </div>
                    <label class="main-product-{{ section.id }}__purchase-option main-product-{{ section.id }}__one-time-option">
                      <input type="radio" name="purchase_type" value="one-time">
                      <div class="main-product-{{ section.id }}__option-content">
                        <span class="main-product-{{ section.id }}__option-title">{{ 'products.one_time' | t }}</span>
                        <span class="main-product-{{ section.id }}__option-price">{% render 'price', amount: product.price %}</span>
                      </div>
                    </label>
                  </div>

                {%- when 'buy_button' -%}
                  <div class="main-product-{{ section.id }}__buy-button-block" {{ block.shopify_attributes }}>
                    <button 
                      type="submit" 
                      name="add" 
                      class="main-product-{{ section.id }}__add-to-cart-btn" 
                      {% if product.available == false %}disabled{% endif %}
                      aria-label="{{ 'products.buy.add_to_cart' | t }}"
                    >
                      {% if product.available %}
                        {% if block.settings.show_price %}
                          <span class="main-product-{{ section.id }}__btn-price-section" data-variant-price="{{ form_id }}">{% render 'price', amount: current_variant.price %}</span>
                        {% endif %}
                        <span class="main-product-{{ section.id }}__btn-text-section">
                          {{ block.settings.button_text }}
                          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                        </span>
                      {% else %}
                        {{ 'products.buy.sold_out' | t }}
                      {% endif %}
                    </button>
                  </div>

                {%- when 'guarantee_text' -%}
                  <div class="main-product-{{ section.id }}__guarantee-block" {{ block.shopify_attributes }}>
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                    <p>{{ block.settings.guarantee_text }}</p>
                  </div>

                {%- when 'size_chart' -%}
                  <div class="main-product-{{ section.id }}__sizechart-block" {{ block.shopify_attributes }}>
                    <button type="button" class="main-product-{{ section.id }}__sizechart-btn" data-open-sizechart="SizechartModal-{{ section.id }}">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
                      {%- assign size_chart_fallback = 'products.size_chart' | t -%}{{ block.settings.title | default: size_chart_fallback }}
                    </button>

                    <div class="main-product-{{ section.id }}__modal-overlay" id="SizechartModal-{{ section.id }}">
                      <div class="main-product-{{ section.id }}__modal-content">
                        <div class="main-product-{{ section.id }}__modal-header">
                          <h3>{{ block.settings.title | default: size_chart_fallback }}</h3>
                          <button type="button" class="main-product-{{ section.id }}__modal-close" data-close-modal="SizechartModal-{{ section.id }}" aria-label="{{ 'general.accessibility.close' | t }}">✕</button>
                        </div>
                        <div class="main-product-{{ section.id }}__modal-body">
                          {%- if block.settings.size_chart_image != blank -%}
                            <img src="{{ block.settings.size_chart_image | image_url: width: 800 }}" alt="{{ 'products.size_chart' | t }}" class="main-product-{{ section.id }}__sizechart-img" loading="lazy">
                          {%- elsif product.metafields.custom.size_chart.value != blank -%}
                            <div class="main-product-{{ section.id }}__metafield-content">{{ product.metafields.custom.size_chart.value }}</div>
                          {%- else -%}
                            <table class="main-product-{{ section.id }}__size-table">
                              <thead>
                                <tr>
                                  <th>{{ 'products.size' | t }}</th>
                                  <th>{{ 'products.chest' | t }}</th>
                                  <th>{{ 'products.waist' | t }}</th>
                                  <th>{{ 'products.hip' | t }}</th>
                                </tr>
                              </thead>
                              <tbody>
                                <tr><td>S</td><td>34-36"</td><td>28-30"</td><td>35-37"</td></tr>
                                <tr><td>M</td><td>38-40"</td><td>32-34"</td><td>39-41"</td></tr>
                                <tr><td>L</td><td>42-44"</td><td>36-38"</td><td>43-45"</td></tr>
                                <tr><td>XL</td><td>46-48"</td><td>40-42"</td><td>47-49"</td></tr>
                              </tbody>
                            </table>
                          {%- endif -%}
                        </div>
                      </div>
                    </div>
                  </div>

                {%- when 'faq_accordion' -%}
                  <div class="main-product-{{ section.id }}__accordion-block" {{ block.shopify_attributes }}>
                    <details class="main-product-{{ section.id }}__accordion">
                      <summary class="main-product-{{ section.id }}__accordion-summary">{{ block.settings.title }}</summary>
                      <div class="main-product-{{ section.id }}__accordion-content">
                        {{ block.settings.content }}
                      </div>
                    </details>
                  </div>

                {%- when 'shipping_info' -%}
                  <div class="main-product-{{ section.id }}__shipping-block" {{ block.shopify_attributes }}>
                    <h3 class="main-product-{{ section.id }}__block-heading">{{ 'products.shipping' | t }}</h3>
                    <p>{{ block.settings.shipping_text }}</p>
                  </div>

                {%- when 'payment_icons' -%}
                  <div class="main-product-{{ section.id }}__payment-block" {{ block.shopify_attributes }}>
                    {%- for type in shop.enabled_payment_types -%}
                      {{ type | payment_type_svg_tag: class: 'main-product-' | append: section.id | append: '__payment-icon' }}
                    {%- endfor -%}
                  </div>

                {%- when 'social_share' -%}
                  <div class="main-product-{{ section.id }}__social-block" {{ block.shopify_attributes }}>
                    <span class="main-product-{{ section.id }}__social-label">Share:</span>
                    <a href="https://www.facebook.com/sharer/sharer.php?u={{ shop.url }}{{ product.url }}" target="_blank" rel="noopener" class="main-product-{{ section.id }}__social-link" aria-label="{{ 'general.social.share_facebook' | t }}">FB</a>
                    <a href="https://twitter.com/intent/tweet?url={{ shop.url }}{{ product.url }}" target="_blank" rel="noopener" class="main-product-{{ section.id }}__social-link" aria-label="{{ 'general.social.share_x' | t }}">X</a>
                    <a href="https://pinterest.com/pin/create/button/?url={{ shop.url }}{{ product.url }}" target="_blank" rel="noopener" class="main-product-{{ section.id }}__social-link" aria-label="{{ 'general.social.share_pinterest' | t }}">PIN</a>
                  </div>

              {%- endcase -%}
            {%- endfor -%}
          </div>
        </form>
      </div>

    </div>
  </div>

  {%- liquid
    assign sticky_image = current_variant.featured_image | default: product.featured_image
    assign sticky_compare = false
    if current_variant.compare_at_price > current_variant.price
      assign sticky_compare = true
    endif
  -%}
  <div class="main-product-{{ section.id }}__sticky-atc" id="StickyATC-{{ section.id }}">
    <div class="main-product-{{ section.id }}__sticky-inner">
      <div class="main-product-{{ section.id }}__sticky-product">
        {%- if sticky_image -%}
          <img
            class="main-product-{{ section.id }}__sticky-image"
            src="{{ sticky_image | image_url: width: 112, height: 112, crop: 'center' }}"
            alt=""
            width="56"
            height="56"
            loading="lazy"
            data-variant-image="{{ form_id }}"
          >
        {%- endif -%}
        <div class="main-product-{{ section.id }}__sticky-info">
          <span class="main-product-{{ section.id }}__sticky-title">{{ product.title | escape }}</span>
          {%- unless product.has_only_default_variant -%}
            <span class="main-product-{{ section.id }}__sticky-variant" data-variant-title="{{ form_id }}">{{ current_variant.title | escape }}</span>
          {%- endunless -%}
        </div>
      </div>

      <div class="main-product-{{ section.id }}__sticky-actions">
        <div class="main-product-{{ section.id }}__sticky-prices">
          <span class="main-product-{{ section.id }}__sticky-price" data-variant-price="{{ form_id }}">{% render 'price', amount: current_variant.price %}</span>
          <s class="main-product-{{ section.id }}__sticky-compare" data-variant-compare="{{ form_id }}"{% unless sticky_compare %} hidden{% endunless %}>
            {%- if sticky_compare -%}{% render 'price', amount: current_variant.compare_at_price %}{%- endif -%}
          </s>
        </div>
        <button
          type="submit"
          form="{{ form_id }}"
          name="add"
          class="main-product-{{ section.id }}__sticky-btn"
          {% unless current_variant.available %}
            disabled
          {% endunless %}
        >
          <span
            data-variant-button-label
            data-label-add="{{ 'products.buy.add_to_cart' | t }}"
            data-label-sold-out="{{ 'products.buy.sold_out' | t }}"
          >
            {%- if current_variant.available -%}
              {{ 'products.buy.add_to_cart' | t }}
            {%- else -%}
              {{ 'products.buy.sold_out' | t }}
            {%- endif -%}
          </span>
        </button>
      </div>
    </div>
  </div>

</section>

{% style %}
  .main-product-{{ section.id }} {
    width: 100vw;
    max-width: 100vw;
    margin-left: -50vw;
    margin-right: -50vw;
    left: 50%;
    right: 50%;
    position: relative;
    background-color: var(--mp-bg);
    color: var(--mp-text);
    font-family: var(--font-body-family), -apple-system, sans-serif;
    padding-top: 40px;
    padding-bottom: 100px;
    font-size: 13px;
    overflow-x: hidden;
  }

  .main-product-{{ section.id }} * { box-sizing: border-box; }

  .main-product-{{ section.id }} img { 
    max-width: 100%; 
    height: auto; 
    display: block;
  }

  .main-product-{{ section.id }}__container {
    max-width: var(--page-width, 1300px);
    margin: 0 auto;
    padding: 0 var(--page-margin, 20px);
  }

  .main-product-{{ section.id }}__layout {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 30px;
    align-items: start;
  }

  .main-product-{{ section.id }}__card-frame {
    background: var(--mp-bg);
    border: var(--mp-card-border-width) solid var(--mp-border);
    box-shadow: 0 4px 15px rgba(43, 30, 22, 0.05);
    padding: 25px;
    border-radius: 0;
  }

  .main-product-{{ section.id }}__left-column {
    display: flex;
    flex-direction: column;
    gap: 30px;
    position: sticky;
    top: 40px;
  }

  .main-product-{{ section.id }}__gallery-wrapper {
    display: flex;
    gap: 15px;
    width: 100%;
  }

  .main-product-{{ section.id }}__gallery-wrapper.main-product-{{ section.id }}__thumbs-right {
    flex-direction: row;
  }

  .main-product-{{ section.id }}__gallery-wrapper.main-product-{{ section.id }}__thumbs-left {
    flex-direction: row-reverse;
  }

  .main-product-{{ section.id }}__gallery-wrapper.main-product-{{ section.id }}__thumbs-below {
    flex-direction: column;
  }

  .main-product-{{ section.id }}__thumbs-below .main-product-{{ section.id }}__thumbnails-container {
    flex-direction: row;
    width: 100%;
    overflow-x: auto;
    scrollbar-width: thin;
  }

  .main-product-{{ section.id }}__thumbs-below .main-product-{{ section.id }}__thumbnail {
    width: 80px;
  }

  .main-product-{{ section.id }}__main-image-wrapper {
    position: relative;
    flex-grow: 1;
    width: 100%;
    aspect-ratio: 4/5;
    background-color: var(--mp-soft-bg);
    overflow: hidden;
  }

  .main-product-{{ section.id }}__main-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .main-product-{{ section.id }}__thumbnails-container {
    display: flex;
    gap: 10px;
    flex-shrink: 0;
    flex-direction: column;
    width: 80px;
  }

  .main-product-{{ section.id }}__thumbnail {
    width: 100%;
    aspect-ratio: 1/1;
    border: 1px solid transparent;
    overflow: hidden;
    cursor: pointer;
    padding: 0;
    background: transparent;
    opacity: 0.6;
    transition: all 0.3s ease;
    flex-shrink: 0;
  }

  .main-product-{{ section.id }}__thumbnail.is-active {
    border-color: var(--mp-text);
    opacity: 1;
  }

  .main-product-{{ section.id }}__thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .main-product-{{ section.id }}__main-badge {
    position: absolute;
    top: 15px;
    left: 15px;
    background: var(--mp-btn-bg);
    color: var(--mp-btn-text);
    padding: 5px 10px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    z-index: 2;
  }

  .main-product-{{ section.id }}__image-counter {
    position: absolute;
    top: 15px;
    right: 15px;
    background: rgba(255, 255, 255, 0.8);
    color: var(--mp-text);
    padding: 4px 10px;
    font-size: 12px;
    font-weight: 600;
    z-index: 2;
  }

  .main-product-{{ section.id }}__review-card {
    display: flex;
    flex-direction: column;
  }

  .main-product-{{ section.id }}__review-header {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 15px;
  }

  .main-product-{{ section.id }}__reviewer-img {
    width: 45px;
    height: 45px;
    border-radius: 50%;
    object-fit: cover;
  }

  .main-product-{{ section.id }}__reviewer-placeholder {
    width: 45px;
    height: 45px;
    border-radius: 50%;
    background: var(--mp-soft-bg);
  }

  .main-product-{{ section.id }}__reviewer-name {
    font-weight: 700;
    font-size: 14px;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .main-product-{{ section.id }}__verified-badge {
    font-size: 10px;
    color: var(--mp-accent);
    font-weight: 600;
  }

  .main-product-{{ section.id }}__review-stars {
    color: #D4A373;
    font-size: 12px;
  }

  .main-product-{{ section.id }}__review-title {
    font-size: 15px;
    font-weight: 700;
    margin: 0 0 5px;
  }

  .main-product-{{ section.id }}__review-text {
    font-size: 13px;
    line-height: 1.5;
