{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign form_id = 'ProductForm-' | append: section.id

  capture main_img_class
    echo 'main-product-' | append: section.id | append: '__main-image'
  endcapture
-%}

<section 
  class="main-product-{{ section.id }}" 
  id="MainProduct-{{ section.id }}"
  style="
    --mp-bg: {{ section.settings.color_scheme.settings.background }};
    --mp-text: {{ section.settings.color_scheme.settings.text }};
    --mp-accent: {{ section.settings.color_scheme.settings.accent }};
    --mp-btn-bg: {{ section.settings.button_bg_color }};
    --mp-btn-text: {{ section.settings.button_text_color }};
    --mp-border: {{ section.settings.color_scheme.settings.border }};
    --mp-soft-bg: {{ section.settings.soft_background }};
    --mp-soft-text: {{ section.settings.soft_text }};
    --mp-card-border-width: {{ section.settings.card_border_width }}px;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="main-product-{{ section.id }}__container">
    <div class="main-product-{{ section.id }}__layout">
      
      <div class="main-product-{{ section.id }}__left-column">
        <div class="main-product-{{ section.id }}__card-frame main-product-{{ section.id }}__gallery-card">
          {%- liquid
            assign media_count = product.media.size
            assign active_media = product.featured_media
            if section.settings.variant_media_switch and current_variant.featured_media
              assign active_media = current_variant.featured_media
            endif
            assign active_index = 1
            for media in product.media
              if media.id == active_media.id
                assign active_index = forloop.index
              endif
            endfor
          -%}
          <media-gallery
            class="main-product-{{ section.id }}__gallery-wrapper main-product-{{ section.id }}__thumbs-{{ section.settings.thumbnail_position | default: 'right' }}"
            data-section="{{ section.id }}"
            data-variant-switch="{{ section.settings.variant_media_switch }}"
            data-close-label="{{ 'general.accessibility.close' | t }}"
            data-prev-label="{{ 'products.zoom_previous' | t }}"
            data-next-label="{{ 'products.zoom_next' | t }}"
          >
            <div class="main-product-{{ section.id }}__main-image-wrapper main-product-{{ section.id }}__main-image-wrapper--{{ section.settings.media_fit | default: 'contain' }}">
              {%- if product.tags.size > 0 -%}
                <span class="main-product-{{ section.id }}__main-badge">{{ product.tags.first | upcase }}</span>
              {%- endif -%}

              {%- if section.settings.enable_zoom and product.media.size > 0 -%}
                <button type="button" class="main-product-{{ section.id }}__zoom" data-media-zoom aria-label="{{ 'products.zoom' | t }}">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M20 20l-4.8-4.8M10.5 7.5v6M7.5 10.5h6"/></svg>
                </button>
              {%- endif -%}

              {%- if media_count > 1 -%}
                <div class="main-product-{{ section.id }}__image-counter">
                  <span data-media-index>{{ active_index }}</span> / {{ media_count }}
                </div>
              {%- endif -%}

              {%- for media in product.media -%}
                {%- liquid
                  assign is_active = false
                  if media.id == active_media.id
                    assign is_active = true
                  endif
                  assign media_alt = media.alt | default: product.title | escape
                  assign media_loading = 'lazy'
                  if is_active
                    assign media_loading = 'eager'
                  endif
                -%}
                <div
                  class="main-product-{{ section.id }}__media-item main-product-{{ section.id }}__media-item--{{ media.media_type }}"
                  data-media-id="{{ media.id }}"
                  {% if media.media_type == 'image' %}
                    data-zoom-src="{{ media | image_url: width: 2400 }}"
                    data-zoom-alt="{{ media_alt }}"
                  {% endif %}
                  {% unless is_active %}
                    hidden
                  {% endunless %}
                >
                  {%- case media.media_type -%}
                    {%- when 'image' -%}
                      {%- if is_active -%}
                        {{
                          media
                          | image_url: width: 1500
                          | image_tag:
                            widths: '400, 600, 800, 1000, 1200, 1500',
                            sizes: '(min-width: 990px) 45vw, 100vw',
                            loading: media_loading,
                            fetchpriority: 'high',
                            alt: media_alt,
                            class: main_img_class
                        }}
                      {%- else -%}
                        {{
                          media
                          | image_url: width: 1500
                          | image_tag:
                            widths: '400, 600, 800, 1000, 1200, 1500',
                            sizes: '(min-width: 990px) 45vw, 100vw',
                            loading: media_loading,
                            alt: media_alt,
                            class: main_img_class
                        }}
                      {%- endif -%}
                    {%- when 'external_video' -%}
                      {{ media | external_video_url: enablejsapi: true, rel: 0 | external_video_tag: loading: 'lazy', class: 'main-product-media__frame' }}
                    {%- when 'video' -%}
                      {{ media | video_tag: controls: true, preload: 'none', playsinline: true, image_size: '1500x', class: 'main-product-media__frame' }}
                    {%- when 'model' -%}
                      {{ media | model_viewer_tag: image_size: '1500x', reveal: 'interaction', toggleable: true, class: 'main-product-media__frame' }}
                  {%- endcase -%}
                </div>
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: main_img_class }}
              {%- endfor -%}
            </div>

            {%- if media_count > 1 -%}
              <div class="main-product-{{ section.id }}__thumbnails-container">
                {%- for media in product.media -%}
                  <button
                    class="main-product-{{ section.id }}__thumbnail{% if media.id == active_media.id %} is-active{% endif %}"
                    data-media-target="{{ media.id }}"
                    type="button"
                    aria-label="{{ 'products.view_image' | t: index: forloop.index }}"
                    {% if media.id == active_media.id %}
                      aria-current="true"
                    {% endif %}
                  >
                    {{
                      media.preview_image
                      | image_url: width: 200
                      | image_tag: widths: '100, 160, 200', sizes: '80px', loading: 'lazy', alt: ''
                    }}
                    {%- unless media.media_type == 'image' -%}
                      <span class="main-product-media__thumb-icon" aria-hidden="true">
                        {%- if media.media_type == 'model' -%}3D{%- else -%}▶{%- endif -%}
                      </span>
                    {%- endunless -%}
                  </button>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </media-gallery>
          <script src="{{ 'media-gallery.js' | asset_url }}" defer></script>

          {%- assign model_media = product.media | where: 'media_type', 'model' -%}
          {%- if model_media.size > 0 -%}
            {%- comment -%} Opens the 3D model in the customer's space on supported phones {%- endcomment -%}
            <button
              type="button"
              class="main-product-{{ section.id }}__xr-button"
              data-shopify-xr
              data-shopify-model3d-id="{{ model_media.first.id }}"
              data-shopify-title="{{ product.title | escape }}"
              data-shopify-xr-hidden
            >
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false"><path d="M12 2l9 5v10l-9 5-9-5V7l9-5z"/><path d="M12 22V12M21 7l-9 5-9-5"/></svg>
              {{ 'products.view_in_space' | t }}
            </button>
            <script type="application/json" data-product-models>
              {{ model_media | json }}
            </script>
          {%- endif -%}
        </div>

        {%- for block in section.blocks -%}
          {%- if block.type == 'customer_review' -%}
            <div class="main-product-{{ section.id }}__card-frame main-product-{{ section.id }}__review-card" {{ block.shopify_attributes }}>
              <div class="main-product-{{ section.id }}__review-header">
                {%- if block.settings.customer_image != blank -%}
                  {%- capture img_alt -%}{{ block.settings.customer_name }}{%- endcapture -%}{%- capture img_class -%}main-product-{{ section.id }}__reviewer-img{%- endcapture -%}{{ block.settings.customer_image | image_url: width: 100 | image_tag: widths: '100', sizes: '50px', loading: 'lazy', alt: img_alt, class: img_class }}
                {%- else -%}
                  <div class="main-product-{{ section.id }}__reviewer-placeholder"></div>
                {%- endif -%}
                <div class="main-product-{{ section.id }}__reviewer-info">
                  <div class="main-product-{{ section.id }}__reviewer-name">
                    {{ block.settings.customer_name }}
                    {%- if block.settings.show_verified -%}
                      <span class="main-product-{{ section.id }}__verified-badge">✓ {{ 'products.verified' | t }}</span>
                    {%- endif -%}
                  </div>
                  {%- assign review_rating = block.settings.rating | default: 5 -%}
                  <div class="main-product-{{ section.id }}__review-stars" role="img" aria-label="{{ 'products.rating' | t: rating: review_rating, max: 5 }}">
                    {%- for star in (1..5) -%}
                      <span{% if star > review_rating %} class="is-empty"{% endif %} aria-hidden="true">★</span>
                    {%- endfor -%}
                  </div>
                </div>
              </div>
              <h4 class="main-product-{{ section.id }}__review-title">{{ block.settings.review_title }}</h4>
              <p class="main-product-{{ section.id }}__review-text">{{ block.settings.review_text }}</p>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="main-product-{{ section.id }}__right-column main-product-{{ section.id }}__card-frame">
        {%- comment -%}
          The product form lives in the buy button block. Quantity and purchase options in
          other blocks join it through the form attribute, so app blocks with their own forms
          never end up nested inside it.
        {%- endcomment -%}
        <div class="main-product-{{ section.id }}__form">
          
          <div class="main-product-{{ section.id }}__details-blocks-wrapper">
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                
                {%- when 'title' -%}
                  <div class="main-product-{{ section.id }}__title-block" {{ block.shopify_attributes }}>
                    <h1 class="main-product-{{ section.id }}__product-title">{{ product.title | escape }}</h1>
                    {%- if block.settings.subtitle != blank -%}
                      <p class="main-product-{{ section.id }}__product-subtitle">{{ block.settings.subtitle }}</p>
                    {%- endif -%}
                  </div>

                {%- when 'rating' -%}
                  {%- comment -%}
                    Uses Shopify's standard review metafields (reviews.rating, reviews.rating_count),
                    which review apps fill in. Nothing shows until a product has reviews.
                  {%- endcomment -%}
                  {%- if product.metafields.reviews.rating.value != blank -%}
                    {%- liquid
                      assign rating = product.metafields.reviews.rating.value
                      assign rating_value = rating.rating | round: 1
                      assign rating_max = rating.scale_max
                      assign filled_stars = rating.rating | round
                      assign review_total = product.metafields.reviews.rating_count.value | default: 0
                    -%}
                    <div class="main-product-{{ section.id }}__rating-block" {{ block.shopify_attributes }}>
                      <div class="main-product-{{ section.id }}__stars" role="img" aria-label="{{ 'products.rating' | t: rating: rating_value, max: rating_max }}">
                        {%- for star in (1..rating_max) -%}
                          <span{% if star > filled_stars %} class="is-empty"{% endif %}>★</span>
                        {%- endfor -%}
                      </div>
                      <span class="main-product-{{ section.id }}__review-link">{{ 'products.reviews_count' | t: count: review_total }}</span>
                    </div>
                  {%- endif -%}

                {%- when 'sku' -%}
                  <p
                    class="main-product-{{ section.id }}__sku"
                    {% if current_variant.sku == blank %}
                      hidden
                    {% endif %}
                    {{ block.shopify_attributes }}
                  >
                    {{ 'products.sku' | t }}:
                    <span data-variant-sku="{{ form_id }}">{{ current_variant.sku | escape }}</span>
                  </p>

                {%- when 'price' -%}
                  <div class="main-product-{{ section.id }}__price-block" {{ block.shopify_attributes }}>
                    {% render 'price-tag', product: product, variant: current_variant, form_id: form_id, savings: block.settings.show_savings, tax_note: true %}
                  </div>

                {%- when 'description' -%}
                  <div class="main-product-{{ section.id }}__description-block" {{ block.shopify_attributes }}>
                    <h3 class="main-product-{{ section.id }}__block-heading">{{ 'products.description' | t }}</h3>
                    <div class="rte">{{ product.description }}</div>
                  </div>

                {%- when 'key_benefits' -%}
                  <div class="main-product-{{ section.id }}__benefits-block" {{ block.shopify_attributes }}>
                    <h3 class="main-product-{{ section.id }}__block-heading">{{ 'products.benefits' | t }}</h3>
                    <ul class="main-product-{{ section.id }}__benefits-list">
                      {%- assign benefits = block.settings.benefits_list | split: ',' -%}
                      {%- for benefit in benefits -%}
                        <li>{{ benefit | strip }}</li>
                      {%- endfor -%}
                    </ul>
                  </div>

                {%- when 'variant_picker' -%}
                  {%- if product.has_only_default_variant -%}
                    {%- continue -%}
                  {%- endif -%}
                  <div class="main-product-{{ section.id }}__variant-block" style="margin: var(--variant-block-margin);" {{ block.shopify_attributes }}>
                    {% render 'variant-picker', product: product, form_id: form_id, section_id: section.id %}
                  </div>

                {%- when 'quantity_selector' -%}
                  <div class="main-product-{{ section.id }}__quantity-block" {{ block.shopify_attributes }}>
                    <label for="Quantity-{{ section.id }}" class="main-product-{{ section.id }}__qty-label">{{ 'products.quantity' | t }}</label>
                    <div class="main-product-{{ section.id }}__qty-wrapper">
                      <button type="button" class="main-product-{{ section.id }}__qty-btn" data-qty="minus" aria-label="{{ 'products.quantity_decrease' | t }}">-</button>
                      <input type="number" id="Quantity-{{ section.id }}" name="quantity" value="1" min="1" form="{{ form_id }}" class="main-product-{{ section.id }}__qty-input">
                      <button type="button" class="main-product-{{ section.id }}__qty-btn" data-qty="plus" aria-label="{{ 'products.quantity_increase' | t }}">+</button>
                    </div>
                  </div>

                {%- when 'stock_alert' -%}
                  {%- comment -%}
                    Shows the real stock count when a tracked variant is running low.
                    Variant counts are passed to the page so the message follows the selected variant.
                  {%- endcomment -%}
                  {%- liquid
                    assign threshold = block.settings.threshold
                    assign show_stock = false
                    if current_variant.inventory_management == 'shopify' and current_variant.inventory_quantity > 0
                      if current_variant.inventory_quantity <= threshold
                        assign show_stock = true
                      endif
                    endif
                  -%}
                  <div
                    class="main-product-{{ section.id }}__stock-block"
                    data-stock-alert
                    data-threshold="{{ threshold }}"
                    data-message="{{ 'products.low_stock_template.other' | t: count: '[count]' }}"
                    data-message-one="{{ 'products.low_stock_template.one' | t: count: '[count]' }}"
                    {% unless show_stock %}
                      hidden
                    {% endunless %}
                    {{ block.shopify_attributes }}
                  >
                    <span class="main-product-{{ section.id }}__stock-dot" aria-hidden="true"></span>
                    <span data-stock-text>{{ 'products.low_stock' | t: count: current_variant.inventory_quantity }}</span>
                    <script type="application/json" data-stock-levels>
                      {
                        {%- for variant in product.variants -%}
                          {%- assign level = 0 -%}
                          {%- if variant.inventory_management == 'shopify' -%}
                            {%- assign level = variant.inventory_quantity -%}
                          {%- endif -%}
                          "{{ variant.id }}": {{ level | at_least: 0 }}{% unless forloop.last %},{% endunless %}
                        {%- endfor -%}
                      }
                    </script>
                  </div>

                {%- when 'selling_plan' -%}
                  {%- comment -%}
                    Purchase options from the product's selling plans (subscription apps).
                    Hidden for products without selling plans.
                  {%- endcomment -%}
                  {%- if product.selling_plan_groups.size > 0 -%}
                    {%- assign selected_plan = product.selected_selling_plan -%}
                    {%- if product.requires_selling_plan and selected_plan == blank -%}
                      {%- assign selected_plan = product.selling_plan_groups.first.selling_plans.first -%}
                    {%- endif -%}
                    <fieldset class="main-product-{{ section.id }}__selling-plan-block" {{ block.shopify_attributes }}>
                      <legend class="main-product-{{ section.id }}__subscribe-header">
                        <span class="main-product-{{ section.id }}__subscribe-title">
                          {{- block.settings.subscribe_title | default: product.selling_plan_groups.first.name -}}
                        </span>
                      </legend>

                      {%- unless product.requires_selling_plan -%}
                        <label class="main-product-{{ section.id }}__purchase-option main-product-{{ section.id }}__one-time-option" for="SellingPlan-{{ section.id }}-none">
                          <input type="radio" id="SellingPlan-{{ section.id }}-none" name="selling_plan" value="" form="{{ form_id }}"{% if selected_plan == blank %} checked{% endif %}>
                          <span class="main-product-{{ section.id }}__option-content">
                            <span class="main-product-{{ section.id }}__option-title">{{ 'products.one_time' | t }}</span>
                            <span class="main-product-{{ section.id }}__option-price">{% render 'price', amount: current_variant.price %}</span>
                          </span>
                        </label>
                      {%- endunless -%}

                      {%- for group in product.selling_plan_groups -%}
                        {%- for plan in group.selling_plans -%}
                          {%- assign allocation = current_variant.selling_plan_allocations | where: 'selling_plan_id', plan.id | first -%}
                          <label class="main-product-{{ section.id }}__purchase-option" for="SellingPlan-{{ section.id }}-{{ plan.id }}">
                            <input type="radio" id="SellingPlan-{{ section.id }}-{{ plan.id }}" name="selling_plan" value="{{ plan.id }}" form="{{ form_id }}"{% if selected_plan.id == plan.id %} checked{% endif %}>
                            <span class="main-product-{{ section.id }}__option-content">
                              <span class="main-product-{{ section.id }}__option-title">{{ plan.name | escape }}</span>
                              {%- if allocation -%}
                                <span class="main-product-{{ section.id }}__option-price">{% render 'price', amount: allocation.price %}</span>
                              {%- endif -%}
                            </span>
                          </label>
                          {%- if plan.description != blank -%}
                            <p class="main-product-{{ section.id }}__subscribe-benefits">{{ plan.description | escape }}</p>
                          {%- endif -%}
                        {%- endfor -%}
                      {%- endfor -%}
                    </fieldset>
                  {%- endif -%}

                {%- when 'buy_button' -%}
                  {%- liquid
                    assign add_label = block.settings.button_text
                    if add_label == blank
                      assign add_label = 'products.buy.add_to_cart' | t
                    endif
                  -%}
                  <div class="main-product-{{ section.id }}__buy-button-block" {{ block.shopify_attributes }}>
                    {%- form 'product', product, id: form_id, class: 'main-product-form', novalidate: 'novalidate' -%}
                      <input type="hidden" name="id" value="{{ current_variant.id }}">

                      {%- unless product.has_only_default_variant -%}
                        <noscript>
                          <label for="NoJsVariant-{{ section.id }}" class="main-product-{{ section.id }}__qty-label">{{ 'products.variant_label' | t }}</label>
                          <select name="id" id="NoJsVariant-{{ section.id }}" class="main-product-form__nojs-select">
                            {%- for variant in product.variants -%}
                              <option value="{{ variant.id }}"{% if variant == current_variant %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>
                                {{ variant.title | escape }} – {% render 'price', amount: variant.price %}
                                {%- unless variant.available %} – {{ 'products.buy.sold_out' | t }}{% endunless %}
                              </option>
                            {%- endfor -%}
                          </select>
                        </noscript>
                      {%- endunless -%}

                      {%- if product.gift_card? and block.settings.show_gift_card_recipient -%}
                        {% render 'gift-card-recipient-form', form: form, section_id: section.id %}
                      {%- endif -%}

                      <button
                        type="submit"
                        name="add"
                        class="main-product-{{ section.id }}__add-to-cart-btn"
                        {% unless current_variant.available %}
                          disabled
                        {% endunless %}
                      >
                        {%- if block.settings.show_price -%}
                          <span class="main-product-{{ section.id }}__btn-price-section">
                            {% render 'price-tag', product: product, variant: current_variant, form_id: form_id, compare: false %}
                          </span>
                        {%- endif -%}
                        <span class="main-product-{{ section.id }}__btn-text-section">
                          <span
                            data-variant-button-label
                            data-label-add="{{ add_label | escape }}"
                            data-label-sold-out="{{ 'products.buy.sold_out' | t }}"
                          >
                            {%- if current_variant.available -%}
                              {{ add_label | escape }}
                            {%- else -%}
                              {{ 'products.buy.sold_out' | t }}
                            {%- endif -%}
                          </span>
                          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                        </span>
                      </button>

                      {%- if block.settings.show_dynamic_checkout -%}
                        <div class="main-product-form__dynamic-checkout">{{ form | payment_button }}</div>
                      {%- endif -%}

                      <p class="main-product-form__error" role="alert" data-form-error hidden></p>

                      {%- comment -%} Shop Pay Installments banner; Shopify shows it when installments are on {%- endcomment -%}
                      <div class="main-product-form__installments">{{ form | payment_terms }}</div>
                    {%- endform -%}
                  </div>

                {%- when 'pickup_availability' -%}
                  <div class="main-product-{{ section.id }}__pickup-block" {{ block.shopify_attributes }}>
                    <pickup-availability
                      class="pickup-availability"
                      data-root-url="{{ routes.root_url }}"
                      data-product-url="{{ product.url }}"
                      data-variant-id="{{ current_variant.id }}"
                    >
                      {% render 'pickup-availability', variant: current_variant %}
                    </pickup-availability>
                    <script src="{{ 'pickup-availability.js' | asset_url }}" defer></script>
                  </div>

                {%- when 'custom_liquid' -%}
                  <div class="main-product-{{ section.id }}__custom-liquid" {{ block.shopify_attributes }}>
                    {{ block.settings.custom_liquid }}
                  </div>

                {%- when 'guarantee_text' -%}
                  <div class="main-product-{{ section.id }}__guarantee-block" {{ block.shopify_attributes }}>
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                    <p>{{ block.settings.guarantee_text }}</p>
                  </div>

                {%- when 'size_chart' -%}
                  {%- comment -%} Shown only when there is a real size chart, never invented measurements {%- endcomment -%}
                  {%- liquid
                    assign has_size_chart = false
                    if block.settings.size_chart_image != blank
                      assign has_size_chart = true
                    elsif product.metafields.custom.size_chart.value != blank
                      assign has_size_chart = true
                    endif
                  -%}
                  {%- unless has_size_chart -%}
                    {%- continue -%}
                  {%- endunless -%}
                  <div class="main-product-{{ section.id }}__sizechart-block" {{ block.shopify_attributes }}>
                    <button type="button" class="main-product-{{ section.id }}__sizechart-btn" data-open-sizechart="SizechartModal-{{ section.id }}">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
                      {%- assign size_chart_fallback = 'products.size_chart' | t -%}{{ block.settings.title | default: size_chart_fallback }}
                    </button>

                    <div class="main-product-{{ section.id }}__modal-overlay" id="SizechartModal-{{ section.id }}">
                      <div class="main-product-{{ section.id }}__modal-content">
                        <div class="main-product-{{ section.id }}__modal-header">
                          <h3>{{ block.settings.title | default: size_chart_fallback }}</h3>
                          <button type="button" class="main-product-{{ section.id }}__modal-close" data-close-modal="SizechartModal-{{ section.id }}" aria-label="{{ 'general.accessibility.close' | t }}">✕</button>
                        </div>
                        <div class="main-product-{{ section.id }}__modal-body">
                          {%- if block.settings.size_chart_image != blank -%}
                            {%- capture img_alt -%}{{ 'products.size_chart' | t }}{%- endcapture -%}{%- capture img_class -%}main-product-{{ section.id }}__sizechart-img{%- endcapture -%}{{ block.settings.size_chart_image | image_url: width: 800 | image_tag: widths: '100, 165, 220, 300, 400, 600, 800', sizes: '(min-width: 990px) 800px, 100vw', loading: 'lazy', alt: img_alt, class: img_class }}
                          {%- elsif product.metafields.custom.size_chart.value != blank -%}
                            <div class="main-product-{{ section.id }}__metafield-content">{{ product.metafields.custom.size_chart.value }}</div>
                          {%- endif -%}
                        </div>
                      </div>
                    </div>
                  </div>

                {%- when 'faq_accordion' -%}
                  <div class="main-product-{{ section.id }}__accordion-block" {{ block.shopify_attributes }}>
                    <details class="main-product-{{ section.id }}__accordion">
                      <summary class="main-product-{{ section.id }}__accordion-summary">{{ block.settings.title }}</summary>
                      <div class="main-product-{{ section.id }}__accordion-content rte">
                        {{ block.settings.content }}
                      </div>
                    </details>
                  </div>

                {%- when 'shipping_info' -%}
                  <div class="main-product-{{ section.id }}__shipping-block" {{ block.shopify_attributes }}>
                    <h3 class="main-product-{{ section.id }}__block-heading">{{ 'products.shipping' | t }}</h3>
                    <p>{{ block.settings.shipping_text }}</p>
                  </div>

                {%- when 'payment_icons' -%}
                  <div class="main-product-{{ section.id }}__payment-block" {{ block.shopify_attributes }}>
                    {%- for type in shop.enabled_payment_types -%}
                      {{ type | payment_type_svg_tag: class: 'main-product-' | append: section.id | append: '__payment-icon' }}
                    {%- endfor -%}
                  </div>

                {%- when 'social_share' -%}
                  <div class="main-product-{{ section.id }}__social-block" {{ block.shopify_attributes }}>
                    <span class="main-product-{{ section.id }}__social-label">{{ 'general.social.share' | t }}</span>
                    <a href="https://www.facebook.com/sharer/sharer.php?u={{ shop.url | append: product.url | url_param_escape }}" target="_blank" rel="noopener" class="main-product-{{ section.id }}__social-link" aria-label="{{ 'general.social.share_facebook' | t }}">FB</a>
                    <a href="https://twitter.com/intent/tweet?url={{ shop.url | append: product.url | url_param_escape }}" target="_blank" rel="noopener" class="main-product-{{ section.id }}__social-link" aria-label="{{ 'general.social.share_x' | t }}">X</a>
                    <a href="https://pinterest.com/pin/create/button/?url={{ shop.url | append: product.url | url_param_escape }}" target="_blank" rel="noopener" class="main-product-{{ section.id }}__social-link" aria-label="{{ 'general.social.share_pinterest' | t }}">PIN</a>
                  </div>

                {%- when '@app' -%}
                  <div class="main-product-{{ section.id }}__app-block">
                    {% render block %}
                  </div>

              {%- endcase -%}
            {%- endfor -%}
          </div>
        </div>
      </div>

    </div>
  </div>

  {%- liquid
    assign sticky_image = current_variant.featured_image | default: product.featured_image
  -%}
  <div class="main-product-{{ section.id }}__sticky-atc" id="StickyATC-{{ section.id }}">
    <div class="main-product-{{ section.id }}__sticky-inner">
      <div class="main-product-{{ section.id }}__sticky-product">
        {%- if sticky_image -%}
          <img
            class="main-product-{{ section.id }}__sticky-image"
            src="{{ sticky_image | image_url: width: 112, height: 112, crop: 'center' }}"
            alt=""
            width="56"
            height="56"
            loading="lazy"
            data-variant-image="{{ form_id }}"
          >
        {%- endif -%}
        <div class="main-product-{{ section.id }}__sticky-info">
          <span class="main-product-{{ section.id }}__sticky-title">{{ product.title | escape }}</span>
          {%- unless product.has_only_default_variant -%}
            <span class="main-product-{{ section.id }}__sticky-variant" data-variant-title="{{ form_id }}">{{ current_variant.title | escape }}</span>
          {%- endunless -%}
        </div>
      </div>

      <div class="main-product-{{ section.id }}__sticky-actions">
        <div class="main-product-{{ section.id }}__sticky-prices">
          {% render 'price-tag', product: product, variant: current_variant, form_id: form_id %}
        </div>
        <button
          type="submit"
          form="{{ form_id }}"
          name="add"
          class="main-product-{{ section.id }}__sticky-btn"
          {% unless current_variant.available %}
            disabled
          {% endunless %}
        >
          <span
            data-variant-button-label
            data-label-add="{{ 'products.buy.add_to_cart' | t }}"
            data-label-sold-out="{{ 'products.buy.sold_out' | t }}"
          >
            {%- if current_variant.available -%}
              {{ 'products.buy.add_to_cart' | t }}
            {%- else -%}
              {{ 'products.buy.sold_out' | t }}
            {%- endif -%}
          </span>
        </button>
      </div>
    </div>
  </div>

</section>

{% style %}
  .main-product-{{ section.id }} {
    width: 100vw;
    max-width: 100vw;
    margin-left: -50vw;
    margin-right: -50vw;
    left: 50%;
    right: 50%;
    position: relative;
    background-color: var(--mp-bg);
    color: var(--mp-text);
    font-family: var(--font-body-family), -apple-system, sans-serif;
    padding-top: 40px;
    padding-bottom: 100px;
    font-size: 13px;
    overflow-x: hidden;
  }

  .main-product-{{ section.id }} * { box-sizing: border-box; }

  .main-product-{{ section.id }} img { 
    max-width: 100%; 
    height: auto; 
    display: block;
  }

  .main-product-{{ section.id }}__container {
    max-width: var(--page-width, 1300px);
    margin: 0 auto;
    padding: 0 var(--page-margin, 20px);
  }

  .main-product-{{ section.id }}__layout {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 30px;
    align-items: start;
  }

  .main-product-{{ section.id }}__card-frame {
    background: var(--mp-bg);
    border: var(--mp-card-border-width) solid var(--mp-border);
    box-shadow: 0 4px 15px rgba(43, 30, 22, 0.05);
    padding: 25px;
    border-radius: 0;
  }

  .main-product-{{ section.id }}__left-column {
    display: flex;
    flex-direction: column;
    gap: 30px;
    position: sticky;
    top: 40px;
  }

  .main-product-{{ section.id }}__gallery-wrapper {
    display: flex;
    gap: 15px;
    width: 100%;
  }

  .main-product-{{ section.id }}__gallery-wrapper.main-product-{{ section.id }}__thumbs-right {
    flex-direction: row;
  }

  .main-product-{{ section.id }}__gallery-wrapper.main-product-{{ section.id }}__thumbs-left {
    flex-direction: row-reverse;
  }

  .main-product-{{ section.id }}__gallery-wrapper.main-product-{{ section.id }}__thumbs-below {
    flex-direction: column;
  }

  .main-product-{{ section.id }}__thumbs-below .main-product-{{ section.id }}__thumbnails-container {
    flex-direction: row;
    width: 100%;
    overflow-x: auto;
    scrollbar-width: thin;
  }

  .main-product-{{ section.id }}__thumbs-below .main-product-{{ section.id }}__thumbnail {
    width: 80px;
  }

  .main-product-{{ section.id }}__main-image-wrapper {
    position: relative;
    flex-grow: 1;
    width: 100%;
    aspect-ratio: 4/5;
    background-color: var(--mp-soft-bg);
    color: var(--mp-soft-text);
    overflow: hidden;
  }

  .main-product-{{ section.id }}__main-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Show whole image: every photo stays fully visible whatever its ratio */
  .main-product-{{ section.id }}__main-image-wrapper--contain .main-product-{{ section.id }}__main-image {
    object-fit: contain;
  }

  .main-product-{{ section.id }}__media-item {
    width: 100%;
    height: 100%;
  }

  .main-product-{{ section.id }}__media-item[hidden] {
    display: none;
  }

  .main-product-{{ section.id }}__media-item iframe,
  .main-product-{{ section.id }}__media-item video,
  .main-product-{{ section.id }}__media-item model-viewer {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: contain;
    background: #000;
  }

  .main-product-{{ section.id }}__media-item--model model-viewer {
    background: var(--mp-soft-bg);
    color: var(--mp-soft-text);
  }

  .main-product-{{ section.id }}__thumbnail {
    position: relative;
  }

  .main-product-{{ section.id }}__zoom {
    position: absolute;
    right: 15px;
    bottom: 15px;
    z-index: 3;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid var(--mp-border);
    border-radius: 50%;
    background: var(--mp-bg);
    color: var(--mp-text);
    cursor: zoom-in;
  }

  .main-product-{{ section.id }}__zoom[hidden] {
    display: none;
  }

  .media-loupe {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 4;
    width: 190px;
    height: 190px;
    border: 3px solid var(--mp-bg, #fff);
    border-radius: 50%;
    background-color: var(--mp-soft-bg, #f5efe7);
    color: var(--mp-soft-text);
    background-repeat: no-repeat;
    box-shadow: 0 0 0 1px var(--mp-accent, #9c4a1a), 0 18px 40px rgb(0 0 0 / 0.22);
    opacity: 0;
    pointer-events: none;
    scale: 0.6;
    transition: opacity 0.18s ease, scale 0.22s cubic-bezier(0.2, 0.8, 0.2, 1);
    will-change: transform;
  }

  .media-loupe.is-visible {
    opacity: 1;
    scale: 1;
  }

  .has-loupe {
    cursor: none;
  }

  .media-zoom {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    overflow: hidden;
    background: var(--mp-bg, #faf6f0);
    color: var(--mp-text, #2b1e16);
  }

  .media-zoom::backdrop {
    background: rgb(0 0 0 / 0.5);
  }

  .media-zoom__stage {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .media-zoom__image {
    display: block;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    cursor: zoom-in;
    -webkit-user-select: none;
    user-select: none;
  }

  .media-zoom__stage.is-zoomed {
    display: block;
    overflow: auto;
    overscroll-behavior: contain;
  }

  .media-zoom__stage.is-zoomed .media-zoom__image {
    width: 250%;
    max-width: none;
    max-height: none;
    cursor: zoom-out;
  }

  .media-zoom__close {
    position: absolute;
    top: 16px;
    right: 16px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--mp-border, rgb(0 0 0 / 0.12));
    border-radius: 50%;
    background: var(--mp-bg, #fff);
    color: inherit;
    cursor: pointer;
  }

  .media-zoom__close svg,
  .media-zoom__nav svg {
    width: 20px;
    height: 20px;
  }

  .media-zoom__nav {
    position: absolute;
    bottom: 20px;
    left: 50%;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px;
    border: 1px solid var(--mp-border, rgb(0 0 0 / 0.12));
    border-radius: 999px;
    background: var(--mp-bg, #fff);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
    transform: translateX(-50%);
  }

  .media-zoom__nav button {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  .media-zoom--single .media-zoom__nav {
    display: none;
  }

  .media-zoom button:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .media-loupe {
      transition: none;
    }
  }

  .main-product-{{ section.id }}__xr-button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    min-height: 44px;
    margin-top: 12px;
    border: 1px solid var(--mp-border);
    background: var(--mp-soft-bg);
    color: var(--mp-text);
    font: inherit;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
  }

  /* Shopify hides the button on devices without AR support */
  .main-product-{{ section.id }}__xr-button[data-shopify-xr-hidden] {
    display: none;
  }

  .main-product-media__thumb-icon {
    position: absolute;
    right: 4px;
    bottom: 4px;
    display: grid;
    place-items: center;
    min-width: 22px;
    height: 22px;
    padding: 0 4px;
    border-radius: 11px;
    background: rgb(0 0 0 / 0.65);
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    line-height: 1;
  }

  .main-product-{{ section.id }}__thumbnails-container {
    display: flex;
    gap: 10px;
    flex-shrink: 0;
    flex-direction: column;
    width: 80px;
  }

  .main-product-{{ section.id }}__thumbnail {
    width: 100%;
    aspect-ratio: 1/1;
    border: 1px solid transparent;
    overflow: hidden;
    cursor: pointer;
    padding: 0;
    background: transparent;
    opacity: 0.6;
    transition: all 0.3s ease;
    flex-shrink: 0;
  }

  .main-product-{{ section.id }}__thumbnail.is-active {
    border-color: var(--mp-text);
    opacity: 1;
  }

  .main-product-{{ section.id }}__thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .main-product-{{ section.id }}__main-badge {
    position: absolute;
    top: 15px;
    left: 15px;
    background: var(--mp-btn-bg);
    color: var(--mp-btn-text);
    padding: 5px 10px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    z-index: 2;
  }

  .main-product-{{ section.id }}__image-counter {
    position: absolute;
    top: 15px;
    right: 15px;
    background: rgba(255, 255, 255, 0.8);
    color: var(--mp-text);
    padding: 4px 10px;
    font-size: 12px;
    font-weight: 600;
    z-index: 2;
  }

  .main-product-{{ section.id }}__review-card {
    display: flex;
    flex-direction: column;
  }

  .main-product-{{ section.id }}__review-header {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 15px;
  }

  .main-product-{{ section.id }}__reviewer-img {
    width: 45px;
    height: 45px;
    border-radius: 50%;
    object-fit: cover;
  }

  .main-product-{{ section.id }}__reviewer-placeholder {
    width: 45px;
    height: 45px;
    border-radius: 50%;
    background: var(--mp-soft-bg);
    color: var(--mp-soft-text);
  }

  .main-product-{{ section.id }}__reviewer-name {
    font-weight: 700;
    font-size: 14px;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .main-product-{{ section.id }}__verified-badge {
    font-size: 10px;
    color: var(--mp-accent);
    font-weight: 600;
  }

  .main-product-{{ section.id }}__review-stars {
    color: #D4A373;
    font-size: 12px;
  }

  .main-product-{{ section.id }}__review-title {
    font-size: 15px;
    font-weight: 700;
    margin: 0 0 5px;
  }

  .main-product-{{ section.id }}__review-text {
    font-size: 13px;
    line-height: 1.5;
    opacity: 0.8;
    margin: 0;
  }

  .main-product-{{ section.id }}__right-column {
    display: flex;
    flex-direction: column;
  }

  .main-product-{{ section.id }}__form {
    display: flex;
    flex-direction: column;
  }

  .main-product-{{ section.id }}__details-blocks-wrapper {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .main-product-{{ section.id }}__product-title {
    font-family: var(--font-heading-family), serif;
    font-size: clamp(24px, 3vw, 32px);
    text-transform: uppercase;
    margin: 0 0 5px;
    line-height: 1.1;
    color: var(--mp-text);
  }

  .main-product-{{ section.id }}__product-subtitle {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--mp-text);
    opacity: 0.8;
    margin: 0;
  }

  .main-product-{{ section.id }}__block-heading {
    font-size: 14px;
    font-weight: 700;
    margin: 0 0 8px;
    text-transform: capitalize;
    color: var(--mp-text);
  }

  .main-product-{{ section.id }}__rating-block {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .main-product-{{ section.id }}__stars {
    color: #D4A373;
    font-size: 14px;
    letter-spacing: 2px;
  }

  .main-product-{{ section.id }}__review-link {
    color: var(--mp-text);
    font-size: 13px;
    text-decoration: underline;
    opacity: 0.7;
  }

  .main-product-{{ section.id }}__description-block, 
  .main-product-{{ section.id }}__shipping-block {
    font-size: 14px;
    line-height: 1.6;
    color: var(--mp-text);
    opacity: 0.9;
  }

  .main-product-{{ section.id }}__description-block p, 
  .main-product-{{ section.id }}__shipping-block p {
    margin: 0;
  }

  .main-product-{{ section.id }}__benefits-block {
    padding-top: 10px;
  }

  .main-product-{{ section.id }}__benefits-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .main-product-{{ section.id }}__benefits-list li {
    font-size: 13px;
    font-weight: 500;
    padding-left: 15px;
    position: relative;
  }

  .main-product-{{ section.id }}__benefits-list li::before {
    content: '•';
    position: absolute;
    left: 0;
    color: var(--mp-accent);
    font-size: 16px;
  }

  .main-product-{{ section.id }}__quantity-block {
    display: flex;
    align-items: center;
    gap: 15px;
  }

  .main-product-{{ section.id }}__qty-label {
    font-weight: 700;
    text-transform: uppercase;
    font-size: 13px;
  }

  .main-product-{{ section.id }}__qty-wrapper {
    display: flex;
    border: 1px solid var(--mp-border);
    overflow: hidden;
    background: transparent;
  }

  .main-product-{{ section.id }}__qty-btn {
    width: 35px;
    height: 35px;
    background: transparent;
    border: none;
    cursor: pointer;
    font-size: 16px;
  }

  .main-product-{{ section.id }}__qty-input {
    width: 40px;
    text-align: center;
    border: none;
    border-left: 1px solid var(--mp-border);
    border-right: 1px solid var(--mp-border);
    font-family: inherit;
    font-weight: 600;
    background: transparent;
  }

  .main-product-{{ section.id }}__stock-block {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 700;
    color: #D84343;
    text-transform: uppercase;
  }

  .main-product-{{ section.id }}__stock-block[hidden] {
    display: none;
  }

  .main-product-{{ section.id }}__stock-dot {
    width: 8px;
    height: 8px;
    background: #D84343;
    border-radius: 50%;
    animation: pulse 1.5s infinite;
  }

  @keyframes pulse {
    0% { opacity: 1; }
    50% { opacity: 0.5; }
    100% { opacity: 1; }
  }

  .main-product-{{ section.id }}__selling-plan-block {
    border: 1px solid var(--mp-border);
    overflow: hidden;
  }

  .main-product-{{ section.id }}__subscribe-header {
    background: var(--mp-soft-bg);
    color: var(--mp-text);
    text-align: center;
    padding: 10px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    border-bottom: 1px solid var(--mp-border);
  }

  .main-product-{{ section.id }}__purchase-option {
    display: block;
    padding: 12px 15px;
    cursor: pointer;
    border-bottom: 1px solid var(--mp-border);
  }

  .main-product-{{ section.id }}__purchase-option input { display: none; }

  .main-product-{{ section.id }}__option-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .main-product-{{ section.id }}__option-title { font-weight: 700; font-size: 13px; }
  .main-product-{{ section.id }}__option-price { font-weight: 700; font-size: 14px; }

  .main-product-{{ section.id }}__subscribe-benefits {
    padding: 10px 15px;
    display: flex;
    flex-direction: column;
    gap: 5px;
    font-size: 11px;
    opacity: 0.8;
    background: rgba(0,0,0,0.02);
  }

  .main-product-{{ section.id }}__one-time-option { border-bottom: none; }

  .main-product-{{ section.id }}__sku {
    margin: 0;
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .main-product-{{ section.id }}__sku[hidden] {
    display: none;
  }

  .main-product-form__error {
    margin: 0;
    padding: 10px 12px;
