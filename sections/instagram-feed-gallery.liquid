{%- liquid
  assign use_custom = section.settings.enable_custom_design

  if use_custom
    assign insta_bg = section.settings.custom_bg_color
    assign insta_text = section.settings.custom_text_color
    assign insta_accent = section.settings.custom_accent_color
    assign heading_font = section.settings.custom_heading_font
    assign body_font = section.settings.custom_body_font
  else
    assign insta_bg = section.settings.background_color
    assign insta_text = section.settings.text_color
    assign insta_accent = section.settings.accent_color
    assign heading_font = 'var(--font-heading-family)'
    assign body_font = 'var(--font-body-family)'
  endif

  capture main_img_class
    echo 'instagram-feed-gallery-' | append: section.id | append: '__image'
  endcapture

  capture main_placeholder_class
    echo 'instagram-feed-gallery-' | append: section.id | append: '__image instagram-feed-gallery-' | append: section.id | append: '__placeholder'
  endcapture
-%}

<section
  class="instagram-feed-gallery-{{ section.id }}"
  id="InstagramGallery-{{ section.id }}"
  style="
    --insta-bg: {{ insta_bg }};
    --insta-text: {{ insta_text }};
    --insta-accent: {{ insta_accent }};
    --insta-heading-font: {{ heading_font }};
    --insta-body-font: {{ body_font }};
    --insta-border-width: {{ section.settings.border_width }}px;
    --insta-radius: {{ section.settings.border_radius }}px;
    --insta-pad-top: {{ section.settings.padding_top }}px;
    --insta-pad-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="instagram-feed-gallery-{{ section.id }}__container">
    
    <header class="instagram-feed-gallery-{{ section.id }}__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="instagram-feed-gallery-{{ section.id }}__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.instagram_url != blank -%}
        <a href="{{ section.settings.instagram_url }}" class="instagram-feed-gallery-{{ section.id }}__button" target="_blank" rel="noopener noreferrer">
          {{ section.settings.button_label | escape }}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M17 7H7M17 7v10"/></svg>
        </a>
      {%- endif -%}
    </header>

    <div class="instagram-feed-gallery-{{ section.id }}__grid">
      
      <div class="instagram-feed-gallery-{{ section.id }}__item instagram-feed-gallery-{{ section.id }}__item--top-left">
        {%- assign block = section.blocks[0] -%}
        {%- if block != blank -%}
          <a href="{{ block.settings.link | default: '#' }}" class="instagram-feed-gallery-{{ section.id }}__link" target="_blank" rel="noopener noreferrer" aria-label="View on Instagram">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 600 | image_tag: class: main_img_class, loading: 'lazy', alt: block.settings.image.alt }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: main_placeholder_class }}
            {%- endif -%}
            <span class="instagram-feed-gallery-{{ section.id }}__hover-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
            </span>
          </a>
        {%- endif -%}
      </div>

      <div class="instagram-feed-gallery-{{ section.id }}__item instagram-feed-gallery-{{ section.id }}__item--center">
        {%- assign block = section.blocks[1] -%}
        {%- if block != blank -%}
          <a href="{{ block.settings.link | default: '#' }}" class="instagram-feed-gallery-{{ section.id }}__link" target="_blank" rel="noopener noreferrer" aria-label="View on Instagram">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1200 | image_tag: class: main_img_class, loading: 'lazy', alt: block.settings.image.alt }}
            {%- else -%}
              {{ 'lifestyle-2' | placeholder_svg_tag: main_placeholder_class }}
            {%- endif -%}
            <span class="instagram-feed-gallery-{{ section.id }}__hover-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
            </span>
          </a>
        {%- endif -%}
      </div>

      <div class="instagram-feed-gallery-{{ section.id }}__item instagram-feed-gallery-{{ section.id }}__item--top-right">
        {%- assign block = section.blocks[2] -%}
        {%- if block != blank -%}
          <a href="{{ block.settings.link | default: '#' }}" class="instagram-feed-gallery-{{ section.id }}__link" target="_blank" rel="noopener noreferrer" aria-label="View on Instagram">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 600 | image_tag: class: main_img_class, loading: 'lazy', alt: block.settings.image.alt }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: main_placeholder_class }}
            {%- endif -%}
            <span class="instagram-feed-gallery-{{ section.id }}__hover-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
            </span>
          </a>
        {%- endif -%}
      </div>

      <div class="instagram-feed-gallery-{{ section.id }}__item instagram-feed-gallery-{{ section.id }}__item--bottom-left">
        {%- assign block = section.blocks[3] -%}
        {%- if block != blank -%}
          <a href="{{ block.settings.link | default: '#' }}" class="instagram-feed-gallery-{{ section.id }}__link" target="_blank" rel="noopener noreferrer" aria-label="View on Instagram">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 600 | image_tag: class: main_img_class, loading: 'lazy', alt: block.settings.image.alt }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: main_placeholder_class }}
            {%- endif -%}
            <span class="instagram-feed-gallery-{{ section.id }}__hover-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
            </span>
          </a>
        {%- endif -%}
      </div>

      <div class="instagram-feed-gallery-{{ section.id }}__item instagram-feed-gallery-{{ section.id }}__item--bottom-right">
        {%- assign block = section.blocks[4] -%}
        {%- if block != blank -%}
          <a href="{{ block.settings.link | default: '#' }}" class="instagram-feed-gallery-{{ section.id }}__link" target="_blank" rel="noopener noreferrer" aria-label="View on Instagram">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 600 | image_tag: class: main_img_class, loading: 'lazy', alt: block.settings.image.alt }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: main_placeholder_class }}
            {%- endif -%}
            <span class="instagram-feed-gallery-{{ section.id }}__hover-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
            </span>
          </a>
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

{% style %}
  .instagram-feed-gallery-{{ section.id }} {
    width: 100vw;
    max-width: 100vw;
    margin-left: -50vw;
    margin-right: -50vw;
    left: 50%;
    right: 50%;
    position: relative;
    background-color: var(--insta-bg);
    padding: var(--insta-pad-top) 0 var(--insta-pad-bottom);
    box-sizing: border-box;
    overflow: hidden;
    font-family: var(--insta-body-font), -apple-system, sans-serif;
  }

  .instagram-feed-gallery-{{ section.id }} * {
    box-sizing: border-box;
  }

  .instagram-feed-gallery-{{ section.id }}__container {
    width: 100%;
    max-width: var(--page-width, 1200px);
    margin: 0 auto;
    padding: 0 var(--page-margin, 20px);
  }

  .instagram-feed-gallery-{{ section.id }}__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 20px;
    margin-bottom: 60px;
  }

  .instagram-feed-gallery-{{ section.id }}__heading {
    font-family: var(--insta-heading-font), serif;
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 400;
    line-height: 1.1;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--insta-text);
    margin: 0;
  }

  .instagram-feed-gallery-{{ section.id }}__button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 28px;
    background-color: var(--insta-accent);
    color: #ffffff;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    border-radius: 50px;
    transition: all 0.3s ease;
  }

  .instagram-feed-gallery-{{ section.id }}__button:hover {
    background-color: var(--insta-text);
  }

  .instagram-feed-gallery-{{ section.id }}__grid {
    display: grid;
    grid-template-columns: 1fr 1.5fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 20px;
    height: 600px;
    position: relative;
  }

  .instagram-feed-gallery-{{ section.id }}__item {
    position: relative;
    border-radius: var(--insta-radius);
    border: var(--insta-border-width) solid var(--insta-accent);
    overflow: hidden;
    transition: transform 0.5s cubic-bezier(0.25, 1, 0.5, 1);
    cursor: pointer;
  }

  .instagram-feed-gallery-{{ section.id }}__item:hover {
    transform: scale(1.02) translateY(-3px);
    z-index: 10;
  }

  .instagram-feed-gallery-{{ section.id }}__item--top-left {
    grid-column: 1;
    grid-row: 1;
    margin-top: 30px;
    margin-right: 20px;
  }

  .instagram-feed-gallery-{{ section.id }}__item--center {
    grid-column: 2;
    grid-row: 1 / 3;
    z-index: 2;
  }

  .instagram-feed-gallery-{{ section.id }}__item--top-right {
    grid-column: 3;
    grid-row: 1;
    margin-top: 30px;
    margin-left: 20px;
  }

  .instagram-feed-gallery-{{ section.id }}__item--bottom-left {
    grid-column: 1;
    grid-row: 2;
    margin-bottom: 30px;
    margin-right: 20px;
  }

  .instagram-feed-gallery-{{ section.id }}__item--bottom-right {
    grid-column: 3;
    grid-row: 2;
    margin-bottom: 30px;
    margin-left: 20px;
  }

  .instagram-feed-gallery-{{ section.id }}__link {
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
  }

  .instagram-feed-gallery-{{ section.id }}__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .instagram-feed-gallery-{{ section.id }}__item:hover .instagram-feed-gallery-{{ section.id }}__image {
    transform: scale(1.08);
  }

  .instagram-feed-gallery-{{ section.id }}__placeholder {
    background-color: rgba(43, 30, 22, 0.1);
  }

  .instagram-feed-gallery-{{ section.id }}__hover-icon {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(43, 30, 22, 0.4);
    color: #ffffff;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
    z-index: 3;
  }

  .instagram-feed-gallery-{{ section.id }}__item:hover .instagram-feed-gallery-{{ section.id }}__hover-icon {
    opacity: 1;
  }

  @media (max-width: 991px) {
    .instagram-feed-gallery-{{ section.id }}__grid {
      height: 500px;
      gap: 15px;
    }

    .instagram-feed-gallery-{{ section.id }}__item--top-left,
    .instagram-feed-gallery-{{ section.id }}__item--top-right {
      margin-top: 15px;
    }

    .instagram-feed-gallery-{{ section.id }}__item--bottom-left,
    .instagram-feed-gallery-{{ section.id }}__item--bottom-right {
      margin-bottom: 15px;
    }
  }

  @media (max-width: 749px) {
    .instagram-feed-gallery-{{ section.id }} {
      padding-top: calc(var(--insta-pad-top) * 0.6);
      padding-bottom: calc(var(--insta-pad-bottom) * 0.6);
    }

    .instagram-feed-gallery-{{ section.id }}__header {
      margin-bottom: 30px;
    }

    .instagram-feed-gallery-{{ section.id }}__grid {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto auto auto;
      height: auto;
      gap: 10px;
    }

    .instagram-feed-gallery-{{ section.id }}__item--center {
      grid-column: 1 / 3;
      grid-row: 1;
      aspect-ratio: 16 / 10;
      margin-bottom: 10px;
    }

    .instagram-feed-gallery-{{ section.id }}__item--top-left {
      grid-column: 1;
      grid-row: 2;
      margin: 0;
      aspect-ratio: 1 / 1;
    }

    .instagram-feed-gallery-{{ section.id }}__item--top-right {
      grid-column: 2;
      grid-row: 2;
      margin: 0;
      aspect-ratio: 1 / 1;
    }

    .instagram-feed-gallery-{{ section.id }}__item--bottom-left {
      grid-column: 1;
      grid-row: 3;
      margin: 0;
      aspect-ratio: 1 / 1;
    }

    .instagram-feed-gallery-{{ section.id }}__item--bottom-right {
      grid-column: 2;
      grid-row: 3;
      margin: 0;
      aspect-ratio: 1 / 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .instagram-feed-gallery-{{ section.id }}__item,
    .instagram-feed-gallery-{{ section.id }}__image,
    .instagram-feed-gallery-{{ section.id }}__hover-icon {
      transition: none;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Instagram Feed Gallery",
  "tag": "section",
  "class": "section-instagram-feed-gallery",
  "max_blocks": 5,
  "settings": [
    {
      "type": "header",
      "content": "Content Settings"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by our community"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Instagram Button Text",
      "default": "Visit Instagram"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram Page URL"
    },
    {
      "type": "header",
      "content": "Image Styling"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Image Border Radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Image Border Width",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 2
    },
    {
      "type": "header",
      "content": "Default Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section Background",
      "default": "#FAF6F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading Text Color",
      "default": "#2B1E16"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Button & Border Color",
      "default": "#9C4A1A"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "header",
      "content": "Custom Design (Override)"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_design",
      "label": "Enable Custom Design",
      "info": "When enabled, these override the default colors and typography.",
      "default": false
    },
    {
      "type": "color",
      "id": "custom_bg_color",
      "label": "Custom Background",
      "default": "#FFFFFF",
      "visible_if": "{{ section.settings.enable_custom_design }}"
    },
    {
      "type": "color",
      "id": "custom_text_color",
      "label": "Custom Text Color",
      "default": "#111111",
      "visible_if": "{{ section.settings.enable_custom_design }}"
    },
    {
      "type": "color",
      "id": "custom_accent_color",
      "label": "Custom Accent Color",
      "default": "#000000",
      "visible_if": "{{ section.settings.enable_custom_design }}"
    },
    {
      "type": "font_picker",
      "id": "custom_heading_font",
      "label": "Custom Heading Font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_design }}"
    },
    {
      "type": "font_picker",
      "id": "custom_body_font",
      "label": "Custom Body Font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_design }}"
    }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Community Photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Instagram Post URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Instagram Feed Gallery",
      "blocks": [
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" }
      ]
    }
  ]
}
{% endschema %}