  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.headings"
      },
      {
        "type": "font_picker",
        "id": "type_header_font",
        "label": "t:labels.font",
        "default": "assistant_n4"
      },
      {
        "type": "range",
        "id": "heading_font_size",
        "min": 12,
        "max": 72,
        "step": 1,
        "unit": "px",
        "label": "t:labels.font_size",
        "default": 32
      },
      {
        "type": "range",
        "id": "heading_line_height",
        "min": 1,
        "max": 2,
        "step": 0.1,
        "label": "t:labels.line_height",
        "default": 1.2
      },
      {
        "type": "range",
        "id": "heading_letter_spacing",
        "min": -2,
        "max": 5,
        "step": 0.1,
        "unit": "px",
        "label": "t:labels.letter_spacing",
        "default": 0
      },
      {
        "type": "select",
        "id": "heading_text_transform",
        "label": "t:labels.case",
        "options": [
          {
            "value": "none",
            "label": "t:options.text_transform.none"
          },
          {
            "value": "uppercase",
            "label": "t:options.text_transform.uppercase"
          },
          {
            "value": "lowercase",
            "label": "t:options.text_transform.lowercase"
          },
          {
            "value": "capitalize",
            "label": "t:options.text_transform.capitalize"
          }
        ],
        "default": "none"
      },
      {
        "type": "header",
        "content": "t:general.body"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "t:labels.font",
        "default": "assistant_n4"
      },
      {
        "type": "range",
        "id": "body_font_size",
        "min": 12,
        "max": 24,
        "step": 1,
        "unit": "px",
        "label": "t:labels.font_size",
        "default": 16
      },
      {
        "type": "range",
        "id": "body_line_height",
        "min": 1,
        "max": 2,
        "step": 0.1,
        "label": "t:labels.line_height",
        "default": 1.5
      },
      {
        "type": "range",
        "id": "body_letter_spacing",
        "min": -1,
        "max": 3,
        "step": 0.1,
        "unit": "px",
        "label": "t:labels.letter_spacing",
        "default": 0
